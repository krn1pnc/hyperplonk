#include "kernel_operator.h"
#include "adv_api/matmul_intf.h"
#define HP_FIELD_DEVICE __aicore__
#include "field.h"
#include "math_kernels.h"

using namespace AscendC;
using namespace hyperplonk::ascend910b3;

namespace {
constexpr auto cube_config=GetMDLConfig(false,false,0,false,false,false,true);
// Fixed tile buffers (32 KiB total), validated against platform UB by tiling.
class Staging {
public:
    __aicore__ inline Staging() {
        pipe.InitBuffer(input, 1, 16384);
        pipe.InitBuffer(output, 1, 16384);
    }
    __aicore__ inline LocalTensor<uint8_t> read(GM_ADDR a, uint32_t bytes,
                                               GM_ADDR b = nullptr, uint32_t bbytes = 0) {
        auto local = input.AllocTensor<uint8_t>();
        if (bytes) copy_in(local, a, bytes);
        if (bbytes) copy_in(local[8192], b, bbytes);
        input.EnQue(local);
        local = input.DeQue<uint8_t>();
        TEventID event = pipe.FetchEventID(HardEvent::MTE2_S);
        SetFlag<HardEvent::MTE2_S>(event);
        WaitFlag<HardEvent::MTE2_S>(event);
        return local;
    }
    __aicore__ inline LocalTensor<uint8_t> alloc() { return output.AllocTensor<uint8_t>(); }
    __aicore__ inline void write(LocalTensor<uint8_t> local, GM_ADDR addr, uint32_t bytes) {
        output.EnQue(local);
        local = output.DeQue<uint8_t>();
        TEventID event = pipe.FetchEventID(HardEvent::S_MTE3);
        SetFlag<HardEvent::S_MTE3>(event);
        WaitFlag<HardEvent::S_MTE3>(event);
        GlobalTensor<uint8_t> gm;
        gm.SetGlobalBuffer(addr);
        DataCopyPad(gm, local, DataCopyExtParams{1,bytes,0,0,0});
        event = pipe.FetchEventID(HardEvent::MTE3_S);
        SetFlag<HardEvent::MTE3_S>(event);
        WaitFlag<HardEvent::MTE3_S>(event);
        output.FreeTensor(local);
    }
    __aicore__ inline void release(LocalTensor<uint8_t> local) { input.FreeTensor(local); }
private:
    __aicore__ inline void copy_in(LocalTensor<uint8_t> local, GM_ADDR addr, uint32_t bytes) {
        GlobalTensor<uint8_t> gm;
        gm.SetGlobalBuffer(addr);
        DataCopyPad(local, gm, DataCopyExtParams{1,bytes,0,0,0}, DataCopyPadExtParams<uint8_t>{false,0,0,0});
    }
    TPipe pipe;
    TQue<QuePosition::VECIN,1> input;
    TQue<QuePosition::VECOUT,1> output;
};
__aicore__ inline Fr load_fr(LocalTensor<uint8_t> local, uint32_t index) {
    const auto words = local.ReinterpretCast<uint32_t>();
    Fr result{};
    for (uint32_t w=0; w<8; ++w) result.words[w]=words.GetValue(index*8+w);
    return result;
}
__aicore__ inline void store_fr(LocalTensor<uint8_t> local, uint32_t index, const Fr& value) {
    auto words=local.ReinterpretCast<uint32_t>();
    for (uint32_t w=0; w<8; ++w) words.SetValue(index*8+w,value.words[w]);
}
} // namespace

// Vector-only kernels: GM is transferred in tiles; scalar fixed-width arithmetic
// reads UB, never GlobalTensor::GetValue/SetValue.
__global__ __aicore__ void field_elementwise(GM_ADDR lhs, GM_ADDR rhs, GM_ADDR out,
                                            GM_ADDR mask, uint64_t count, uint32_t op) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging io;
    for (uint64_t offset=uint64_t(GetBlockIdx())*256; offset<count; offset+=uint64_t(GetBlockNum())*256) {
        const uint32_t n=uint32_t(count-offset<256?count-offset:256);
        auto in=io.read(lhs+offset*32,n*32,rhs?rhs+offset*32:nullptr,rhs?n*32:0);
        auto result=io.alloc();
        uint8_t nonzero[256];
        for (uint32_t i=0;i<n;++i) {
            const Fr a=load_fr(in,i);
            Fr value{};
            if (op==3) nonzero[i]=a.inverse(value)?1:0;
            else {
                const Fr b=load_fr(in,256+i);
                value=op==0?a+b:(op==1?a-b:a*b);
            }
            store_fr(result,i,value);
        }
        io.release(in);
        io.write(result,out+offset*32,n*32);
        if (op==3) {
            auto flags=io.alloc();
            for(uint32_t i=0;i<n;++i) flags.SetValue(i,nonzero[i]);
            io.write(flags,mask+offset,n);
        }
    }
}

// mode0: dot A+B; mode1: shared scalar Toeplitz B; mode2: scale A.
__global__ __aicore__ void field_pack(GM_ADDR lhs, GM_ADDR rhs, GM_ADDR workspace,
                                     uint32_t valid, uint32_t mode) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging io;
    if (mode==1) {
        auto scalar=io.read(lhs,32);
        const auto s=load_fr(scalar,0).to_limbs();
        io.release(scalar);
        auto b=io.alloc();
        for(uint32_t i=0;i<32;++i) for(uint32_t j=0;j<64;++j) {
            const int value=(j>=i && j-i<32)?s.bytes[j-i]:0;
            b.SetValue(i*64+j,uint8_t(int8_t(value-128)));
        }
        io.write(b,workspace+8192,2048);
        auto sums=io.alloc().ReinterpretCast<int32_t>();
        for(uint32_t j=0;j<64;++j) {
            int32_t sum=0;
            for(uint32_t i=0;i<32;++i) sum+=((j>=i && j-i<32)?int32_t(s.bytes[j-i]):0)-128;
            sums.SetValue(j,sum);
        }
        io.write(sums.ReinterpretCast<uint8_t>(),workspace+25088,256);
        return;
    }
    auto in=io.read(lhs,valid*32,rhs,mode==0?valid*32:0);
    auto a=io.alloc();
    const uint32_t k=mode==0?256:32;
    for(uint32_t i=0;i<32;++i) for(uint32_t t=0;t<k;++t) {
        const uint32_t index=mode==0?t:i;
        const uint32_t limb=mode==0?i:t;
        const int value=index<valid?in.GetValue(index*32+limb):0;
        a.SetValue(i*k+t,uint8_t(int8_t(value-128)));
    }
    io.write(a,workspace,32*k);
    auto rows=io.alloc().ReinterpretCast<int32_t>();
    for(uint32_t i=0;i<32;++i) {
        int32_t sum=0;
        for(uint32_t t=0;t<k;++t) {
            const uint32_t index=mode==0?t:i;
            const uint32_t limb=mode==0?i:t;
            sum+=(index<valid?int32_t(in.GetValue(index*32+limb)):0)-128;
        }
        rows.SetValue(i,sum);
    }
    io.write(rows.ReinterpretCast<uint8_t>(),workspace+24576,128);
    if(mode==0) {
        auto b=io.alloc();
        for(uint32_t t=0;t<256;++t) for(uint32_t j=0;j<32;++j) {
            const int value=t<valid?in.GetValue(8192+t*32+j):0;
            b.SetValue(t*32+j,uint8_t(int8_t(value-128)));
        }
        io.write(b,workspace+8192,8192);
        auto cols=io.alloc().ReinterpretCast<int32_t>();
        for(uint32_t j=0;j<32;++j) {
            int32_t sum=0;
            for(uint32_t t=0;t<256;++t) sum+=(t<valid?int32_t(in.GetValue(8192+t*32+j)):0)-128;
            cols.SetValue(j,sum);
        }
        io.write(cols.ReinterpretCast<uint8_t>(),workspace+25088,128);
    }
    io.release(in);
}

__global__ __aicore__ void field_cube(GM_ADDR workspace, GM_ADDR tiling_addr, uint32_t n, uint32_t k) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    if ASCEND_IS_AIV { return; }
    AscendC::tiling::TCubeTiling tiling;
    auto src=reinterpret_cast<__gm__ uint32_t*>(tiling_addr);
    auto dst=reinterpret_cast<uint32_t*>(&tiling);
    for(uint32_t i=0;i<sizeof(tiling)/4;++i) dst[i]=src[i];
    TPipe pipe;
    using AB=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int8_t,false>;
    using C=matmul::MatmulType<TPosition::GM,CubeFormat::ND,int32_t>;
    matmul::MatmulImpl<AB,AB,C,C,cube_config> mm;
    GlobalTensor<int8_t> a,b;
    GlobalTensor<int32_t> c;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(workspace));
    b.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(workspace+8192));
    c.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(workspace+16384));
    mm.SetSubBlockIdx(0);
    mm.Init(&tiling,&pipe);
    mm.SetOrgShape(32,n,k);
    mm.SetSingleShape(32,n,k);
    mm.SetTensorA(a,false);
    mm.SetTensorB(b,false);
    mm.IterateAll(c,0);
    mm.End();
}

__global__ __aicore__ void field_zero(GM_ADDR out) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging io;
    auto zero=io.alloc();
    store_fr(zero,0,Fr{});
    io.write(zero,out,32);
}

__global__ __aicore__ void field_reduce(GM_ADDR workspace, GM_ADDR out, uint32_t valid, uint32_t mode) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging io;
    const uint32_t cols=mode==0?32:64;
    const uint32_t k=mode==0?256:32;
    auto in=io.read(workspace+16384,32*cols*4,workspace+24576,1024+32);
    auto matrix=in.ReinterpretCast<int32_t>();
    auto rows=in[8192].ReinterpretCast<int32_t>();
    auto sums=in[8704].ReinterpretCast<int32_t>();
    if(mode==0) {
        FrWide wide{};
        uint64_t carry=0;
        for(uint32_t d=0;d<68;++d) {
            uint64_t total=carry;
            for(uint32_t i=0;i<32;++i) if(d>=i && d-i<32) {
                const uint32_t j=d-i;
                total+=uint64_t(int64_t(matrix.GetValue(i*32+j))+128LL*rows.GetValue(i)+128LL*sums.GetValue(j)+16384LL*k);
            }
            wide.bytes[d]=uint8_t(total);
            carry=total>>8;
        }
        const Fr block=Fr::reduce_wide(wide);
        const Fr previous=load_fr(in[9216],0);
        auto result=io.alloc();
        store_fr(result,0,previous+block);
        io.write(result,workspace+25600,32);
        io.release(in);
    } else {
        auto result=io.alloc();
        for(uint32_t i=0;i<valid;++i) {
            FrWide wide{};
            uint64_t carry=0;
            for(uint32_t d=0;d<68;++d) {
                uint64_t total=carry;
                if(d<64) total+=uint64_t(int64_t(matrix.GetValue(i*64+d))+128LL*rows.GetValue(i)+128LL*sums.GetValue(d)+16384LL*k);
                wide.bytes[d]=uint8_t(total);
                carry=total>>8;
            }
            store_fr(result,i,Fr::reduce_wide(wide));
        }
        io.release(in);
        io.write(result,out,valid*32);
    }
}
__global__ __aicore__ void field_copy_result(GM_ADDR workspace, GM_ADDR out) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging io;
    auto in=io.read(workspace+25600,32);
    auto result=io.alloc();
    store_fr(result,0,load_fr(in,0));
    io.release(in);
    io.write(result,out,32);
}

namespace hyperplonk::ascend910b3::detail {
namespace {
inline uint8_t* address(const void* p) { return reinterpret_cast<uint8_t*>(const_cast<void*>(p)); }
inline uint32_t blocks(size_t count,uint32_t requested) {
    const size_t work=count/256+(count%256!=0);
    return uint32_t(work<requested?work:requested);
}
}
void launch_add(aclrtStream s,const Fr* a,const Fr* b,Fr* c,size_t n,uint32_t v) {
    if(n) field_elementwise<<<blocks(n,v),nullptr,s>>>(address(a),address(b),address(c),nullptr,n,0);
}
void launch_sub(aclrtStream s,const Fr* a,const Fr* b,Fr* c,size_t n,uint32_t v) {
    if(n) field_elementwise<<<blocks(n,v),nullptr,s>>>(address(a),address(b),address(c),nullptr,n,1);
}
void launch_mul(aclrtStream s,const Fr* a,const Fr* b,Fr* c,size_t n,uint32_t v) {
    if(n) field_elementwise<<<blocks(n,v),nullptr,s>>>(address(a),address(b),address(c),nullptr,n,2);
}
void launch_inverse(aclrtStream s,const Fr* a,Fr* c,uint8_t* mask,size_t n,uint32_t v) {
    if(n) field_elementwise<<<blocks(n,v),nullptr,s>>>(address(a),nullptr,address(c),address(mask),n,3);
}
void launch_dot_matrix(aclrtStream s,const Fr* a,const Fr* b,void* w,const AscendC::tiling::TCubeTiling* t,uint32_t n) {
    field_pack<<<1,nullptr,s>>>(address(a),address(b),address(w),n,0);
    field_cube<<<1,nullptr,s>>>(address(w),address(t),32,256);
}
void launch_inner_product(aclrtStream s,const Fr* a,const Fr* b,Fr* c,size_t n,void* w,const AscendC::tiling::TCubeTiling* t,uint32_t) {
    if(!n) { field_zero<<<1,nullptr,s>>>(address(c)); return; }
    field_zero<<<1,nullptr,s>>>(address(w)+25600);
    for(size_t offset=0;offset<n;offset+=256) {
        const uint32_t take=uint32_t(n-offset<256?n-offset:256);
        launch_dot_matrix(s,a+offset,b+offset,w,t,take);
        field_reduce<<<1,nullptr,s>>>(address(w),nullptr,take,0);
    }
    field_copy_result<<<1,nullptr,s>>>(address(w),address(c));
}
void launch_scalar_vector_mul(aclrtStream s,const Fr* scalar,const Fr* a,Fr* c,size_t n,void* w,const AscendC::tiling::TCubeTiling* t,uint32_t) {
    if(!n) return;
    field_pack<<<1,nullptr,s>>>(address(scalar),nullptr,address(w),1,1);
    for(size_t offset=0;offset<n;offset+=32) {
        const uint32_t take=uint32_t(n-offset<32?n-offset:32);
        field_pack<<<1,nullptr,s>>>(address(a+offset),nullptr,address(w),take,2);
        field_cube<<<1,nullptr,s>>>(address(w),address(t),64,32);
        field_reduce<<<1,nullptr,s>>>(address(w),address(c+offset),take,1);
    }
}
} // namespace hyperplonk::ascend910b3::detail
