#include "msm_device.h"
#include "msm_internal.h"

namespace hyperplonk::ascend910b3::detail {
using msm_device::Staging;

__global__ __aicore__ void hp_msm_row_init(GM_ADDR starts, uint64_t count,
                                         uint32_t entries) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<32, 16384> io;
    const uint32_t tiles = (entries + 255) / 256;
    for (uint32_t t = AscendC::GetBlockIdx(); t < tiles; t += AscendC::GetBlockNum()) {
        const uint32_t first = t * 256;
        const uint32_t n = msm_device::min32(entries - first, 256);
        auto out = io.alloc_output();
        msm_device::zero(out, n * 64);
        auto words = out.ReinterpretCast<uint64_t>();
        for (uint32_t i = 0; i < n; ++i) words.SetValue(i * 8, count);
        io.write(out, starts + uint64_t(first) * 64, n * 64);
    }
}

__global__ __aicore__ void hp_msm_row_boundaries(GM_ADDR records_a, GM_ADDR records_b,
                                               GM_ADDR control, GM_ADDR starts,
                                               uint64_t count, uint32_t chunks) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<16416, 64> io;
    // The sorted record base follows the device routing decision.
    auto routing = io.read(control, 8);
    const uint32_t parity = routing.ReinterpretCast<uint32_t>().GetValue(0);
    io.release(routing);
    GM_ADDR records = parity ? records_b : records_a;
    for (uint32_t t = AscendC::GetBlockIdx(); t < chunks; t += AscendC::GetBlockNum()) {
        const uint64_t first = uint64_t(t) * 2048;
        const uint32_t n = msm_device::min32(count - first, 2048);
        auto in = io.alloc_input();
        io.copy_in(in, records + first * 8, n * 8);
        if (first) io.copy_in(in[16384], records + (first - 1) * 8, 8);
        in = io.ready_input(in);
        auto words = in.ReinterpretCast<uint32_t>();
        uint32_t previous = first ? words.GetValue(4096) : 0;
        for (uint32_t i = 0; i < n; ++i) {
            const uint32_t bucket = words.GetValue(i * 2);
            if ((!first && !i) || bucket != previous) {
                auto out = io.alloc_output();
                msm_device::zero(out, 64);
                out.ReinterpretCast<uint64_t>().SetValue(0, first + i);
                // Sorted transitions give exactly one writer to each bucket slot.
                io.write(out, starts + uint64_t(bucket) * 64, 64);
            }
            previous = bucket;
        }
        io.release(in);
    }
}

__global__ __aicore__ void hp_msm_row_local(GM_ADDR starts, GM_ADDR local,
                                          GM_ADDR minima, uint64_t count,
                                          uint32_t entries, uint32_t tiles) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<16384, 2112> io;
    for (uint32_t t = AscendC::GetBlockIdx(); t < tiles; t += AscendC::GetBlockNum()) {
        const uint32_t first = t * 256;
        const uint32_t n = msm_device::min32(entries - first, 256);
        auto in = io.read(starts + uint64_t(first) * 64, n * 64);
        auto values = in.ReinterpretCast<uint64_t>();
        auto out = io.alloc_output();
        auto words = out.ReinterpretCast<uint64_t>();
        uint64_t running = count;
        const uint32_t padded = (n + 7) / 8 * 8;
        for (uint32_t i = n; i < padded; ++i) words.SetValue(i, count);
        for (uint32_t i = n; i > 0; --i) {
            const uint64_t value = values.GetValue((i - 1) * 8);
            if (value < running) running = value;
            words.SetValue(i - 1, running);
        }
        io.release(in);
        io.write(out, local + uint64_t(first) * 8, padded * 8);
        out = io.alloc_output();
        msm_device::zero(out, 64);
        out.ReinterpretCast<uint64_t>().SetValue(0, running);
        io.write(out, minima + uint64_t(t) * 64, 64);
    }
}

__global__ __aicore__ void hp_msm_row_carry(GM_ADDR minima, GM_ADDR carries,
                                          uint64_t count, uint32_t tiles) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<16384, 16384> io;
    uint64_t running = count;
    // Reverse tiled scan keeps UB bounded even at the maximum bucket count.
    uint32_t end = tiles;
    while (end) {
        const uint32_t n = end < 256 ? end : 256;
        const uint32_t first = end - n;
        auto in = io.read(minima + uint64_t(first) * 64, n * 64);
        auto values = in.ReinterpretCast<uint64_t>();
        auto out = io.alloc_output();
        msm_device::zero(out, n * 64);
        auto words = out.ReinterpretCast<uint64_t>();
        for (uint32_t i = n; i > 0; --i) {
            words.SetValue((i - 1) * 8, running);
            const uint64_t value = values.GetValue((i - 1) * 8);
            if (value < running) running = value;
        }
        io.release(in);
        io.write(out, carries + uint64_t(first) * 64, n * 64);
        end = first;
    }
}

__global__ __aicore__ void hp_msm_row_fixup(GM_ADDR local, GM_ADDR carries,
                                          GM_ADDR rows, uint64_t count,
                                          uint32_t entries, uint32_t tiles) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<2112, 2048> io;
    for (uint32_t t = AscendC::GetBlockIdx(); t < tiles; t += AscendC::GetBlockNum()) {
        const uint32_t first = t * 256;
        const uint32_t n = msm_device::min32(entries - first, 256);
        const uint32_t padded = (n + 7) / 8 * 8;
        auto in = io.alloc_input();
        io.copy_in(in, local + uint64_t(first) * 8, n * 8);
        io.copy_in(in[2048], carries + uint64_t(t) * 64, 64);
        in = io.ready_input(in);
        auto values = in.ReinterpretCast<uint64_t>();
        const uint64_t carry = values.GetValue(256);
        auto out = io.alloc_output();
        auto words = out.ReinterpretCast<uint64_t>();
        for (uint32_t i = 0; i < n; ++i) {
            const uint64_t value = values.GetValue(i);
            words.SetValue(i, value < carry ? value : carry);
        }
        for (uint32_t i = n; i < padded; ++i) words.SetValue(i, count);
        io.release(in);
        io.write(out, rows + uint64_t(first) * 8, padded * 8);
    }
}

__global__ __aicore__ void hp_msm_tasks(GM_ADDR prefix, GM_ADDR source_rows, GM_ADDR tasks,
                                      GM_ADDR meta, uint32_t level, uint32_t buckets) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    // Two 257-entry prefix tiles; the second starts at a 32-byte UB boundary.
    Staging<4160, 16384> io;
    auto count_read = io.read(meta + uint64_t(level) * 8, 8);
    const uint64_t task_count = count_read.ReinterpretCast<uint64_t>().GetValue(0);
    io.release(count_read);
    if (!task_count) return;
    const uint32_t tiles = (buckets + 255) / 256;
    for (uint32_t t = AscendC::GetBlockIdx(); t < tiles; t += AscendC::GetBlockNum()) {
        const uint32_t first = t * 256;
        const uint32_t n = msm_device::min32(buckets - first, 256);
        auto in = io.alloc_input();
        io.copy_in(in, prefix + uint64_t(first) * 8, (n + 1) * 8);
        io.copy_in(in[2080], source_rows + uint64_t(first) * 8, (n + 1) * 8);
        in = io.ready_input(in);
        auto values = in.ReinterpretCast<uint64_t>();
        for (uint32_t i = 0; i < n; ++i) {
            const uint32_t bucket = first + i;
            if (!bucket) continue;
            const uint64_t qbegin = values.GetValue(i);
            const uint64_t qend = values.GetValue(i + 1);
            const uint64_t rowbegin = values.GetValue(260 + i);
            const uint64_t rowend = values.GetValue(261 + i);
            for (uint64_t base = qbegin; base < qend; base += 256) {
                const uint32_t batch = msm_device::min32(qend - base, 256);
                auto out = io.alloc_output();
                msm_device::zero(out, batch * 64);
                auto u64 = out.ReinterpretCast<uint64_t>();
                auto u32 = out.ReinterpretCast<uint32_t>();
                for (uint32_t j = 0; j < batch; ++j) {
                    const uint64_t begin = rowbegin + (base + j - qbegin) * 64;
                    u64.SetValue(j * 8, begin);
                    u32.SetValue(j * 16 + 2, msm_device::min32(rowend - begin, 64));
                    u32.SetValue(j * 16 + 3, bucket);
                }
                io.write(out, tasks + base * 64, batch * 64);
            }
        }
        io.release(in);
    }
}

void launch_msm_rows(aclrtStream stream, void* workspace, const MsmPlan& p) {
    if (!p.count) return;
    using msm_device::region;
    const uint32_t entries = p.buckets + 1;
    const uint32_t blocks = msm_device::blocks(p, p.row_blocks);
    // CSR keeps 2048-record tiles, derived from the count, never from p.chunks.
    const uint64_t csr_chunks = (p.count + 2047) / 2048;
    auto starts = region(workspace, p, MsmRegion::RowStarts);
    auto local = region(workspace, p, MsmRegion::RowLocal);
    auto rows = region(workspace, p, MsmRegion::RowPtr);
    auto minima = region(workspace, p, MsmRegion::RowBlockMin);
    auto carries = region(workspace, p, MsmRegion::RowBlockCarry);
    hp_msm_row_init<<<blocks, nullptr, stream>>>(starts, p.count, entries);
    hp_msm_row_boundaries<<<msm_device::blocks(p, csr_chunks), nullptr, stream>>>(
        region(workspace, p, MsmRegion::RecordsA), region(workspace, p, MsmRegion::RecordsB),
        region(workspace, p, MsmRegion::RadixControl), starts, p.count,
        static_cast<uint32_t>(csr_chunks));
    hp_msm_row_local<<<blocks, nullptr, stream>>>(starts, local, minima, p.count, entries, p.row_blocks);
    hp_msm_row_carry<<<1, nullptr, stream>>>(minima, carries, p.count, p.row_blocks);
    hp_msm_row_fixup<<<blocks, nullptr, stream>>>(local, carries, rows, p.count, entries, p.row_blocks);
}

void launch_msm_tasks(aclrtStream stream, void* workspace, const MsmPlan& p, uint32_t level) {
    if (!p.count) return;
    using msm_device::region;
    const uint64_t stride = p.host_prefix_offset;
    auto prefix = region(workspace, p, MsmRegion::TaskPrefix) + uint64_t(level) * stride;
    auto source = level ? prefix - stride : region(workspace, p, MsmRegion::RowPtr);
    // Fixed grid over the plan-static bucket tiles; the count is read on device.
    hp_msm_tasks<<<msm_device::blocks(p, (uint64_t(p.buckets) + 255) / 256), nullptr, stream>>>(
        prefix, source, region(workspace, p, MsmRegion::Tasks),
        region(workspace, p, MsmRegion::ScheduleMeta), level, p.buckets);
}
} // namespace hyperplonk::ascend910b3::detail
