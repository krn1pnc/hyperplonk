#include "msm_device.h"
#include "msm_internal.h"

using namespace hyperplonk::ascend910b3::detail;
using namespace hyperplonk::ascend910b3::detail::msm_device;

// Metadata records are two exact u32 words, never floating-point sort keys.
__global__ __aicore__ void hp_msm_extract(
    GM_ADDR scalars, GM_ADDR records, uint64_t count, uint32_t bit, uint32_t bits)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<8192,2048> io;
    const uint32_t word=bit/32, shift=bit%32;
    const uint32_t mask=(1u<<bits)-1;
    const uint64_t tiles=(count+255)/256;
    for(uint64_t t=AscendC::GetBlockIdx();t<tiles;t+=AscendC::GetBlockNum()) {
        const uint64_t begin=t*256;
        const uint32_t n=min32(count-begin,256), padded=(n+7)/8*8;
        auto input=io.read(scalars+begin*32,n*32);
        const auto words=input.ReinterpretCast<uint32_t>();
        auto output=io.alloc_output(); auto out=output.ReinterpretCast<uint32_t>();
        for(uint32_t i=0;i<n;++i) {
            uint32_t digit=words.GetValue(i*8+word)>>shift;
            if(shift!=0 && shift+bits>32 && word+1<8)
                digit|=words.GetValue(i*8+word+1)<<(32-shift);
            out.SetValue(2*i,digit&mask);
            out.SetValue(2*i+1,static_cast<uint32_t>(begin+i));
        }
        for(uint32_t i=n;i<padded;++i) { out.SetValue(2*i,0); out.SetValue(2*i+1,0xffffffffu); }
        io.release(input);
        io.write(output,records+begin*8,padded*8);
    }
}

__global__ __aicore__ void hp_msm_radix_hist(
    GM_ADDR records, GM_ADDR histogram, uint64_t count, uint32_t chunks, uint32_t shift)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<16384,64> io;
    for(uint64_t chunk=AscendC::GetBlockIdx();chunk<chunks;chunk+=AscendC::GetBlockNum()) {
        const uint64_t begin=chunk*2048;
        const uint32_t n=min32(count-begin,2048);
        auto input=io.read(records+begin*8,n*8);
        const auto words=input.ReinterpretCast<uint32_t>();
        uint32_t counts[16]{};
        for(uint32_t i=0;i<n;++i) ++counts[(words.GetValue(2*i)>>shift)&15];
        io.release(input);
        auto output=io.alloc_output(); auto out=output.ReinterpretCast<uint32_t>();
        for(uint32_t d=0;d<16;++d) out.SetValue(d,counts[d]);
        io.write(output,histogram+chunk*64,64);
    }
}

__global__ __aicore__ void hp_msm_radix_prefix(
    GM_ADDR histogram, GM_ADDR descriptors, GM_ADDR totals, uint32_t chunks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<16384,16384> io;
    for(uint32_t digit=AscendC::GetBlockIdx();digit<16;digit+=AscendC::GetBlockNum()) {
        uint64_t logical=0, physical=0;
        // Read contiguous histogram tiles, not sixteen individual GM words per chunk.
        for(uint64_t begin=0;begin<chunks;begin+=256) {
            const uint32_t n=min32(uint64_t(chunks)-begin,256);
            auto input=io.read(histogram+begin*64,n*64);
            const auto hist=input.ReinterpretCast<uint32_t>();
            auto output=io.alloc_output(); zero(output,n*64);
            auto out64=output.ReinterpretCast<uint64_t>();
            auto out32=output.ReinterpretCast<uint32_t>();
            for(uint32_t i=0;i<n;++i) {
                const uint32_t valid=hist.GetValue(i*16+digit);
                out64.SetValue(i*8,logical); out64.SetValue(i*8+1,physical);
                out32.SetValue(i*16+4,valid);
                logical+=valid; physical+=uint64_t((valid+7)/8)*8;
            }
            io.release(input);
            io.write(output,descriptors+(uint64_t(digit)*chunks+begin)*64,n*64);
        }
        auto output=io.alloc_output(); zero(output,64);
        auto out=output.ReinterpretCast<uint64_t>();
        out.SetValue(0,logical); out.SetValue(1,physical);
        io.write(output,totals+uint64_t(digit)*64,64);
    }
}

__global__ __aicore__ void hp_msm_radix_bases(GM_ADDR totals)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<1024,1024> io;
    auto input=io.read(totals,1024); auto in=input.ReinterpretCast<uint64_t>();
    auto output=io.alloc_output(); zero(output,1024);
    auto out=output.ReinterpretCast<uint64_t>();
    uint64_t logical=0,physical=0;
    for(uint32_t d=0;d<16;++d) {
        const uint64_t n=in.GetValue(d*8), padded=in.GetValue(d*8+1);
        out.SetValue(d*8,n); out.SetValue(d*8+1,padded);
        out.SetValue(d*8+2,logical); out.SetValue(d*8+3,physical);
        logical+=n; physical+=padded;
    }
    io.release(input); io.write(output,totals,1024);
}

__global__ __aicore__ void hp_msm_radix_scatter(
    GM_ADDR records, GM_ADDR descriptors, GM_ADDR totals, GM_ADDR fragments,
    uint64_t count, uint32_t chunks, uint32_t shift)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    // First half holds dense input; second half is the stable UB counting-sort result.
    Staging<32768,16384> io;
    uint64_t physical_base[16];
    auto headers=io.read(totals,1024);
    for(uint32_t d=0;d<16;++d) physical_base[d]=headers.ReinterpretCast<uint64_t>().GetValue(d*8+3);
    io.release(headers);
    for(uint64_t chunk=AscendC::GetBlockIdx();chunk<chunks;chunk+=AscendC::GetBlockNum()) {
        uint64_t destinations[16]; uint32_t counts[16], starts[16], ranks[16];
        uint32_t next=0;
        for(uint32_t d=0;d<16;++d) {
            auto descriptor=io.read(descriptors+(uint64_t(d)*chunks+chunk)*64,64);
            destinations[d]=physical_base[d]+descriptor.ReinterpretCast<uint64_t>().GetValue(1);
            counts[d]=descriptor.ReinterpretCast<uint32_t>().GetValue(4);
            starts[d]=next; ranks[d]=next; next+=counts[d];
            io.release(descriptor);
        }
        const uint64_t begin=chunk*2048;
        const uint32_t n=min32(count-begin,2048);
        auto input=io.read(records+begin*8,n*8); auto words=input.ReinterpretCast<uint32_t>();
        for(uint32_t i=0;i<n;++i) {
            const uint32_t bucket=words.GetValue(2*i), index=words.GetValue(2*i+1);
            const uint32_t target=ranks[(bucket>>shift)&15]++;
            words.SetValue(4096+2*target,bucket); words.SetValue(4096+2*target+1,index);
        }
        for(uint32_t d=0;d<16;++d) {
            if(counts[d]==0) continue;
            auto output=io.alloc_output(); auto out=output.ReinterpretCast<uint32_t>();
            for(uint32_t i=0;i<counts[d];++i) {
                out.SetValue(2*i,words.GetValue(4096+2*(starts[d]+i)));
                out.SetValue(2*i+1,words.GetValue(4096+2*(starts[d]+i)+1));
            }
            const uint32_t padded=(counts[d]+7)/8*8;
            for(uint32_t i=counts[d];i<padded;++i) { out.SetValue(2*i,0); out.SetValue(2*i+1,0xffffffffu); }
            // Copy the run to an aligned allocation; starts[d]*8 need not be UB-aligned.
            io.write(output,fragments+destinations[d]*8,padded*8);
        }
        io.release(input);
    }
}

__global__ __aicore__ void hp_msm_radix_compact(
    GM_ADDR fragments, GM_ADDR descriptors, GM_ADDR totals, GM_ADDR records,
    uint64_t count, uint32_t chunks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<16384,16384> io;
    uint64_t logical_base[16], logical_count[16], physical_base[16];
    auto headers=io.read(totals,1024); auto h=headers.ReinterpretCast<uint64_t>();
    for(uint32_t d=0;d<16;++d) {
        logical_count[d]=h.GetValue(d*8); logical_base[d]=h.GetValue(d*8+2);
        physical_base[d]=h.GetValue(d*8+3);
    }
    io.release(headers);
    const uint64_t tiles=(count+2047)/2048;
    for(uint64_t tile=AscendC::GetBlockIdx();tile<tiles;tile+=AscendC::GetBlockNum()) {
        const uint64_t begin=tile*2048;
        const uint32_t n=min32(count-begin,2048);
        auto output=io.alloc_output(); auto out=output.ReinterpretCast<uint32_t>();
        uint32_t written=0, digit=0;
        while(written<n) {
            const uint64_t position=begin+written;
            while(digit<16 && position>=logical_base[digit]+logical_count[digit]) ++digit;
            uint64_t relative=position-logical_base[digit];
            uint64_t low=0, high=chunks;
            // Strict greater-than skips both empty fragments and the previous run's end.
            while(low<high) {
                const uint64_t mid=low+(high-low)/2;
                auto descriptor=io.read(descriptors+(uint64_t(digit)*chunks+mid)*64,64);
                const uint64_t end=descriptor.ReinterpretCast<uint64_t>().GetValue(0)
                    +descriptor.ReinterpretCast<uint32_t>().GetValue(4);
                io.release(descriptor);
                if(end>relative) high=mid; else low=mid+1;
            }
            uint64_t chunk=low;
            // After the initial search, walk descriptors in order, including empty runs.
            while(written<n && relative<logical_count[digit]) {
                auto descriptor=io.read(descriptors+(uint64_t(digit)*chunks+chunk)*64,64);
                const auto d64=descriptor.ReinterpretCast<uint64_t>();
                const uint64_t logical=d64.GetValue(0), physical=d64.GetValue(1);
                const uint32_t valid=descriptor.ReinterpretCast<uint32_t>().GetValue(4);
                io.release(descriptor);
                ++chunk;
                if(valid==0) continue;
                const uint32_t offset=static_cast<uint32_t>(relative-logical);
                const uint32_t take=min32(uint64_t(valid-offset),n-written);
                auto input=io.read(fragments+(physical_base[digit]+physical+offset)*8,take*8);
                auto in=input.ReinterpretCast<uint32_t>();
                for(uint32_t i=0;i<take;++i) {
                    out.SetValue(2*(written+i),in.GetValue(2*i));
                    out.SetValue(2*(written+i)+1,in.GetValue(2*i+1));
                }
                io.release(input); written+=take; relative+=take;
            }
        }
        const uint32_t padded=(n+7)/8*8;
        for(uint32_t i=n;i<padded;++i) { out.SetValue(2*i,0); out.SetValue(2*i+1,0xffffffffu); }
        io.write(output,records+begin*8,padded*8);
    }
}

namespace hyperplonk::ascend910b3::detail {
void launch_msm_extract(aclrtStream stream,const Fr* scalars,void* workspace,
                        const MsmPlan& plan,uint32_t window)
{
    if(plan.count==0) return;
    const uint32_t bit=window*plan.window_bits;
    const uint32_t remaining=255-bit;
    const uint32_t bits=remaining<plan.window_bits ? remaining : plan.window_bits;
    hp_msm_extract<<<blocks(plan,(plan.count+255)/256),nullptr,stream>>>(
        reinterpret_cast<uint8_t*>(const_cast<Fr*>(scalars)),region(workspace,plan,MsmRegion::RecordsA),
        plan.count,bit,bits);
}

void launch_msm_radix_pass(aclrtStream stream,void* workspace,const MsmPlan& plan,uint32_t pass)
{
    if(plan.count==0) return;
    auto input=region(workspace,plan,pass%2==0 ? MsmRegion::RecordsA : MsmRegion::RecordsB);
    auto output=region(workspace,plan,pass%2==0 ? MsmRegion::RecordsB : MsmRegion::RecordsA);
    auto histogram=region(workspace,plan,MsmRegion::RadixHistogram);
    auto descriptors=region(workspace,plan,MsmRegion::RadixDescriptors);
    auto totals=region(workspace,plan,MsmRegion::RadixDigitTotals);
    auto fragments=region(workspace,plan,MsmRegion::RadixFragments);
    const uint32_t chunk_blocks=blocks(plan,plan.chunks);
    hp_msm_radix_hist<<<chunk_blocks,nullptr,stream>>>(input,histogram,plan.count,plan.chunks,pass*4);
    hp_msm_radix_prefix<<<blocks(plan,16),nullptr,stream>>>(histogram,descriptors,totals,plan.chunks);
    hp_msm_radix_bases<<<1,nullptr,stream>>>(totals);
    hp_msm_radix_scatter<<<chunk_blocks,nullptr,stream>>>(
        input,descriptors,totals,fragments,plan.count,plan.chunks,pass*4);
    hp_msm_radix_compact<<<chunk_blocks,nullptr,stream>>>(
        fragments,descriptors,totals,output,plan.count,plan.chunks);
}
} // namespace hyperplonk::ascend910b3::detail
