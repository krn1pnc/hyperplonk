#include "msm_device.h"
#include "msm_internal.h"

using namespace hyperplonk::ascend910b3::detail;
using namespace hyperplonk::ascend910b3::detail::msm_device;

// Metadata records are two exact u32 words, never floating-point sort keys.
__global__ __aicore__ void hp_msm_extract(
    GM_ADDR scalars, GM_ADDR records, uint64_t count, uint32_t bit, uint32_t bits)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<8192,2048> io;
    const uint32_t word=bit/32, shift=bit%32;
    const uint32_t mask=(1u<<bits)-1;
    const uint64_t tiles=(count+255)/256;
    for(uint64_t t=AscendC::GetBlockIdx();t<tiles;t+=AscendC::GetBlockNum()) {
        const uint64_t begin=t*256;
        const uint32_t n=min32(count-begin,256), padded=(n+7)/8*8;
        auto input=io.read(scalars+begin*32,n*32);
        const auto words=input.ReinterpretCast<uint32_t>();
        auto output=io.alloc_output(); auto out=output.ReinterpretCast<uint32_t>();
        for(uint32_t i=0;i<n;++i) {
            uint32_t digit=words.GetValue(i*8+word)>>shift;
            if(shift!=0 && shift+bits>32 && word+1<8)
                digit|=words.GetValue(i*8+word+1)<<(32-shift);
            out.SetValue(2*i,digit&mask);
            out.SetValue(2*i+1,static_cast<uint32_t>(begin+i));
        }
        for(uint32_t i=n;i<padded;++i) { out.SetValue(2*i,0); out.SetValue(2*i+1,0xffffffffu); }
        io.release(input);
        io.write(output,records+begin*8,padded*8);
    }
}

// Radix metadata plan: every kernel here moves two-word records, 32-byte
// descriptors and 64-byte digit totals. No field or point arithmetic, no
// atomics, no host round trip. Chunks are 8192 records; a single DataCopyPad
// never exceeds 32768 bytes, so records move in 4096-record pieces.
namespace {

// Metadata staging without the point-engine 48 KiB budget. The radix kernels
// need up to 133 KiB of UB (whole-partition sort) and never build an engine.
template<uint32_t In, uint32_t Out, uint32_t S1 = 0, uint32_t S2 = 0, uint32_t S3 = 0>
class RadixIO {
public:
    __aicore__ inline RadixIO() {
        if constexpr (In) pipe_.InitBuffer(input_, 1, In);
        if constexpr (Out) pipe_.InitBuffer(output_, 1, Out);
        if constexpr (S1) pipe_.InitBuffer(scratch1_, S1);
        if constexpr (S2) pipe_.InitBuffer(scratch2_, S2);
        if constexpr (S3) pipe_.InitBuffer(scratch3_, S3);
    }
    __aicore__ inline AscendC::LocalTensor<uint8_t> alloc_input() { return input_.AllocTensor<uint8_t>(); }
    __aicore__ inline void copy_in(AscendC::LocalTensor<uint8_t> local, GM_ADDR source, uint32_t bytes) {
        if (!bytes) return;
        AscendC::GlobalTensor<uint8_t> gm; gm.SetGlobalBuffer(source);
        AscendC::DataCopyPad(local, gm, AscendC::DataCopyExtParams{1, bytes, 0, 0, 0},
                             AscendC::DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
    }
    __aicore__ inline AscendC::LocalTensor<uint8_t> ready_input(AscendC::LocalTensor<uint8_t> local) {
        input_.EnQue(local); local = input_.DeQue<uint8_t>();
        const auto e = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(e);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(e);
        return local;
    }
    __aicore__ inline AscendC::LocalTensor<uint8_t> read(GM_ADDR source, uint32_t bytes) {
        auto local = alloc_input(); copy_in(local, source, bytes); return ready_input(local);
    }
    __aicore__ inline void release(AscendC::LocalTensor<uint8_t> local) { input_.FreeTensor(local); }
    // Direct DMA into a scratch buffer, ready for scalar consumption.
    __aicore__ inline void read_into(AscendC::LocalTensor<uint8_t> local, GM_ADDR source, uint32_t bytes) {
        copy_in(local, source, bytes);
        const auto e = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(e);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(e);
    }
    __aicore__ inline AscendC::LocalTensor<uint8_t> alloc_output() { return output_.AllocTensor<uint8_t>(); }
    __aicore__ inline void write(AscendC::LocalTensor<uint8_t> local, GM_ADDR destination, uint32_t bytes) {
        if (!bytes) { output_.FreeTensor(local); return; }
        output_.EnQue(local); local = output_.DeQue<uint8_t>();
        auto e = pipe_.FetchEventID(AscendC::HardEvent::S_MTE3);
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(e);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(e);
        AscendC::GlobalTensor<uint8_t> gm; gm.SetGlobalBuffer(destination);
        AscendC::DataCopyPad(gm, local, AscendC::DataCopyExtParams{1, bytes, 0, 0, 0});
        e = pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(e);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(e);
        output_.FreeTensor(local);
    }
    // Scalar-written buffers (TBuf) and pure copies bypass the output queue.
    __aicore__ inline void store(AscendC::LocalTensor<uint8_t> local, GM_ADDR destination, uint32_t bytes) {
        if (!bytes) return;
        auto e = pipe_.FetchEventID(AscendC::HardEvent::S_MTE3);
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(e);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(e);
        AscendC::GlobalTensor<uint8_t> gm; gm.SetGlobalBuffer(destination);
        AscendC::DataCopyPad(gm, local, AscendC::DataCopyExtParams{1, bytes, 0, 0, 0});
        e = pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(e);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(e);
    }
    __aicore__ inline AscendC::LocalTensor<uint8_t> scratch1() { return scratch1_.Get<uint8_t>(); }
    __aicore__ inline AscendC::LocalTensor<uint8_t> scratch2() { return scratch2_.Get<uint8_t>(); }
    __aicore__ inline AscendC::LocalTensor<uint8_t> scratch3() { return scratch3_.Get<uint8_t>(); }
private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> input_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> output_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratch1_, scratch2_, scratch3_;
};

// Every gated kernel returns before touching records, descriptors or totals
// when the device-selected fallback route is not the required one.
template<class IO>
__aicore__ inline bool gate_skip(IO& io, GM_ADDR control, uint32_t required) {
    if (!control) return false;
    auto value = io.read(control, 8);
    const uint32_t fallback = value.template ReinterpretCast<uint32_t>().GetValue(1);
    io.release(value);
    return fallback != required;
}

// 4096 records per DataCopyPad: 4096*8 == the frozen 32768-byte maximum.
constexpr uint32_t record_piece = msm_radix_max_datacopypad_bytes / 8;

} // namespace

// Per-chunk per-digit histogram: layout [chunk*bins + digit] u32.
__global__ __aicore__ void hp_msm_radix_hist(
    GM_ADDR records, GM_ADDR histogram, GM_ADDR control, uint64_t count,
    uint32_t chunks, uint32_t shift, uint32_t bits, uint32_t bins, uint32_t required_fallback)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    RadixIO<32768, 0, msm_radix_max_bins * 4> io;
    if (gate_skip(io, control, required_fallback)) return;
    const uint32_t mask = (1u << bits) - 1;
    auto tables = io.scratch1();
    auto counts = tables.ReinterpretCast<uint32_t>();
    for (uint64_t chunk = AscendC::GetBlockIdx(); chunk < chunks;
         chunk += AscendC::GetBlockNum()) {
        for (uint32_t d = 0; d < bins; ++d) counts.SetValue(d, 0);
        const uint64_t begin = chunk * msm_radix_chunk_records;
        const uint32_t n = min32(count - begin, msm_radix_chunk_records);
        uint32_t done = 0;
        while (done < n) {
            const uint32_t take = min32(uint64_t(n) - done, record_piece);
            auto input = io.read(records + (begin + done) * 8, take * 8);
            const auto words = input.ReinterpretCast<uint32_t>();
            for (uint32_t i = 0; i < take; ++i) {
                const uint32_t digit = (words.GetValue(2 * i) >> shift) & mask;
                counts.SetValue(digit, counts.GetValue(digit) + 1);
            }
            io.release(input);
            done += take;
        }
        io.store(tables, histogram + chunk * bins * 4, bins * 4);
    }
}

// Digit-prefix scan: descriptors {physical u64, logical u64, valid u32, pad u32}
// per (chunk, digit) and per-digit totals {count, padded}. One block keeps the
// 8192-record chunk order exact, so the scan is a single sequential pass.
__global__ __aicore__ void hp_msm_radix_prefix(
    GM_ADDR histogram, GM_ADDR descriptors, GM_ADDR totals, GM_ADDR control,
    uint32_t chunks, uint32_t bins, uint32_t required_fallback)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    RadixIO<32768, 32768, 4096> io;
    if (gate_skip(io, control, required_fallback)) return;
    auto tables = io.scratch1();
    auto logical = tables.ReinterpretCast<uint64_t>();
    auto physical = logical[256];
    for (uint32_t d = 0; d < bins; ++d) { logical.SetValue(d, 0); physical.SetValue(d, 0); }
    uint32_t done = 0;
    while (done < chunks) {
        const uint32_t rows = 32768 / (bins * 32);
        const uint32_t n = min32(uint64_t(chunks) - done, rows ? rows : 1);
        auto input = io.read(histogram + uint64_t(done) * bins * 4, n * bins * 4);
        const auto hist = input.ReinterpretCast<uint32_t>();
        auto output = io.alloc_output();
        const auto d64 = output.ReinterpretCast<uint64_t>();
        const auto d32 = output.ReinterpretCast<uint32_t>();
        for (uint32_t i = 0; i < n; ++i) {
            for (uint32_t d = 0; d < bins; ++d) {
                const uint32_t valid = hist.GetValue(i * bins + d);
                d64.SetValue((i * bins + d) * 4 + 0, physical.GetValue(d));
                d64.SetValue((i * bins + d) * 4 + 1, logical.GetValue(d));
                d32.SetValue((i * bins + d) * 8 + 4, valid);
                d32.SetValue((i * bins + d) * 8 + 5, 0);
                logical.SetValue(d, logical.GetValue(d) + valid);
                physical.SetValue(d, physical.GetValue(d) + uint64_t((valid + 7) / 8) * 8);
            }
        }
        io.release(input);
        io.write(output, descriptors + uint64_t(done) * bins * 32, n * bins * 32);
        done += n;
    }
    auto summary = io.alloc_output();
    zero(summary, bins * 64);
    const auto s64 = summary.ReinterpretCast<uint64_t>();
    for (uint32_t d = 0; d < bins; ++d) {
        s64.SetValue(d * 8, logical.GetValue(d));
        s64.SetValue(d * 8 + 1, physical.GetValue(d));
    }
    io.write(summary, totals, bins * 64);
}

// Digit totals become bases: {count, padded, logical_base, physical_base}.
__global__ __aicore__ void hp_msm_radix_bases(
    GM_ADDR totals, GM_ADDR control, uint32_t bins, uint32_t required_fallback)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    RadixIO<16384, 16384> io;
    if (gate_skip(io, control, required_fallback)) return;
    auto input = io.read(totals, bins * 64);
    const auto in = input.ReinterpretCast<uint64_t>();
    auto output = io.alloc_output();
    zero(output, bins * 64);
    const auto out = output.ReinterpretCast<uint64_t>();
    uint64_t logical = 0, physical = 0;
    for (uint32_t d = 0; d < bins; ++d) {
        const uint64_t n = in.GetValue(d * 8), padded = in.GetValue(d * 8 + 1);
        out.SetValue(d * 8 + 0, n);
        out.SetValue(d * 8 + 1, padded);
        out.SetValue(d * 8 + 2, logical);
        out.SetValue(d * 8 + 3, physical);
        logical += n; physical += padded;
    }
    io.release(input);
    io.write(output, totals, bins * 64);
}

// Chunk-local stable scatter into 8-record-padded digit runs of RadixFragments.
__global__ __aicore__ void hp_msm_radix_scatter(
    GM_ADDR records, GM_ADDR descriptors, GM_ADDR totals, GM_ADDR fragments,
    GM_ADDR control, uint64_t count, uint32_t chunks, uint32_t shift, uint32_t bits,
    uint32_t bins, uint32_t required_fallback)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    RadixIO<32768, 32832, 65536, 8192> io;
    if (gate_skip(io, control, required_fallback)) return;
    const uint32_t mask = (1u << bits) - 1;
    auto tables = io.scratch2();
    auto t32 = tables.ReinterpretCast<uint32_t>();
    auto t64 = tables.ReinterpretCast<uint64_t>();
    auto counts = t32;            // [0, 256)   chunk-local valid counts
    auto starts = t32[256];       // [256,512)  chunk-local run starts
    auto ranks = t32[512];        // [512,768)  running write ranks
    auto destinations = t64[384]; // [3072B..)  fragment record offsets
    auto bases = t64[640];        // [5120B..)  per-digit fragment bases
    {
        auto headers = io.read(totals, bins * 64);
        const auto h = headers.ReinterpretCast<uint64_t>();
        for (uint32_t d = 0; d < bins; ++d) bases.SetValue(d, h.GetValue(d * 8 + 3));
        io.release(headers);
    }
    auto sorted = io.scratch1();
    const auto sorted_words = sorted.ReinterpretCast<uint32_t>();
    for (uint64_t chunk = AscendC::GetBlockIdx(); chunk < chunks;
         chunk += AscendC::GetBlockNum()) {
        {
            auto descriptor = io.read(descriptors + chunk * bins * 32, bins * 32);
            const auto d64 = descriptor.ReinterpretCast<uint64_t>();
            const auto d32 = descriptor.ReinterpretCast<uint32_t>();
            uint32_t next = 0;
            for (uint32_t d = 0; d < bins; ++d) {
                const uint32_t valid = d32.GetValue(d * 8 + 4);
                counts.SetValue(d, valid);
                starts.SetValue(d, next);
                ranks.SetValue(d, next);
                destinations.SetValue(d, bases.GetValue(d) + d64.GetValue(d * 4));
                next += valid;
            }
            io.release(descriptor);
        }
        const uint64_t begin = chunk * msm_radix_chunk_records;
        const uint32_t n = min32(count - begin, msm_radix_chunk_records);
        uint32_t consumed = 0;
        while (consumed < n) {
            const uint32_t take = min32(uint64_t(n) - consumed, record_piece);
            auto input = io.read(records + (begin + consumed) * 8, take * 8);
            const auto words = input.ReinterpretCast<uint32_t>();
            for (uint32_t i = 0; i < take; ++i) {
                const uint32_t bucket = words.GetValue(2 * i);
                const uint32_t index = words.GetValue(2 * i + 1);
                const uint32_t digit = (bucket >> shift) & mask;
                const uint32_t target = ranks.GetValue(digit);
                sorted_words.SetValue(2 * target, bucket);
                sorted_words.SetValue(2 * target + 1, index);
                ranks.SetValue(digit, target + 1);
            }
            io.release(input);
            consumed += take;
        }
        for (uint32_t d = 0; d < bins; ++d) {
            const uint32_t valid = counts.GetValue(d), first = starts.GetValue(d);
            if (!valid) continue;
            uint32_t done = 0;
            while (done < valid) {
                const uint32_t last = valid - done;
                const uint32_t take = min32(uint64_t(last), record_piece);
                const uint32_t padded = last <= record_piece ? (take + 7) / 8 * 8 : take;
                auto output = io.alloc_output();
                auto out = output.ReinterpretCast<uint32_t>();
                for (uint32_t i = 0; i < take; ++i) {
                    out.SetValue(2 * i, sorted_words.GetValue(2 * (first + done + i)));
                    out.SetValue(2 * i + 1, sorted_words.GetValue(2 * (first + done + i) + 1));
                }
                for (uint32_t i = take; i < padded; ++i) {
                    out.SetValue(2 * i, 0);
                    out.SetValue(2 * i + 1, 0xffffffffu);
                }
                io.write(output, fragments + (destinations.GetValue(d) + done) * 8, padded * 8);
                done += take;
            }
        }
    }
}

// Gathers the padded digit runs back into a dense stable record array.
__global__ __aicore__ void hp_msm_radix_compact(
    GM_ADDR fragments, GM_ADDR descriptors, GM_ADDR totals, GM_ADDR records,
    GM_ADDR control, uint32_t chunks, uint32_t bins, uint32_t required_fallback)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    RadixIO<32768, 0, 16384, 8192> io;
    if (gate_skip(io, control, required_fallback)) return;
    auto header = io.scratch1();
    io.read_into(header, totals, bins * 64);
    const auto h = header.ReinterpretCast<uint64_t>();
    auto table = io.scratch2();
    for (uint64_t chunk = AscendC::GetBlockIdx(); chunk < chunks;
         chunk += AscendC::GetBlockNum()) {
        io.read_into(table, descriptors + chunk * bins * 32, bins * 32);
        const auto d64 = table.ReinterpretCast<uint64_t>();
        const auto d32 = table.ReinterpretCast<uint32_t>();
        for (uint32_t d = 0; d < bins; ++d) {
            const uint32_t valid = d32.GetValue(d * 8 + 4);
            if (!valid) continue;
            const uint64_t source = h.GetValue(d * 8 + 3) + d64.GetValue(d * 4);
            const uint64_t target = h.GetValue(d * 8 + 2) + d64.GetValue(d * 4 + 1);
            uint32_t done = 0;
            while (done < valid) {
                const uint32_t take = min32(uint64_t(valid) - done, record_piece);
                auto piece = io.read(fragments + (source + done) * 8, take * 8);
                io.store(piece, records + (target + done) * 8, take * 8);
                io.release(piece);
                done += take;
            }
        }
    }
}

// Fast route tail: stable in-place counting sort of each dense coarse partition
// by the low digit. A partition never exceeds 8192 records (guarded), so the
// whole partition fits 2*8192 records plus two 256-entry u32 tables.
__global__ __aicore__ void hp_msm_radix_partition(
    GM_ADDR records, GM_ADDR totals, GM_ADDR control, uint32_t bins,
    uint32_t low_bits, uint32_t required_fallback)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    RadixIO<0, 0, 65536, 65536, 2112> io;
    auto tables = io.scratch3();
    // This kernel has no input queue, so the gate word is staged through the
    // still-untouched table buffer.
    if (control) {
        io.read_into(tables[2048], control, 8);
        if (tables.ReinterpretCast<uint32_t>().GetValue(513) != required_fallback) return;
    }
    const uint32_t low_bins = 1u << low_bits, mask = low_bins - 1;
    auto counts = tables.ReinterpretCast<uint32_t>();
    auto ranks = counts[256];
    auto header = tables[2048];
    auto sorted = io.scratch2();
    const auto sorted_words = sorted.ReinterpretCast<uint32_t>();
    for (uint32_t d = AscendC::GetBlockIdx(); d < bins; d += AscendC::GetBlockNum()) {
        io.read_into(header, totals + uint64_t(d) * 64, 64);
        const uint64_t base = header.ReinterpretCast<uint64_t>().GetValue(2);
        const uint32_t n = static_cast<uint32_t>(header.ReinterpretCast<uint64_t>().GetValue(0));
        if (!n) continue;
        auto input = io.scratch1();
        uint32_t done = 0;
        while (done < n) {
            const uint32_t take = min32(uint64_t(n) - done, record_piece);
            io.read_into(input[done * 8], records + (base + done) * 8, take * 8);
            done += take;
        }
        const auto words = input.ReinterpretCast<uint32_t>();
        for (uint32_t i = 0; i < low_bins; ++i) counts.SetValue(i, 0);
        for (uint32_t i = 0; i < n; ++i) {
            const uint32_t digit = words.GetValue(2 * i) & mask;
            counts.SetValue(digit, counts.GetValue(digit) + 1);
        }
        uint32_t next = 0;
        for (uint32_t i = 0; i < low_bins; ++i) {
            ranks.SetValue(i, next);
            next += counts.GetValue(i);
        }
        for (uint32_t i = 0; i < n; ++i) {
            const uint32_t bucket = words.GetValue(2 * i), index = words.GetValue(2 * i + 1);
            const uint32_t digit = bucket & mask;
            const uint32_t target = ranks.GetValue(digit);
            sorted_words.SetValue(2 * target, bucket);
            sorted_words.SetValue(2 * target + 1, index);
            ranks.SetValue(digit, target + 1);
        }
        done = 0;
        while (done < n) {
            const uint32_t take = min32(uint64_t(n) - done, record_piece);
            io.store(sorted[done * 8], records + (base + done) * 8, take * 8);
            done += take;
        }
    }
}

// Guard: max coarse partition over every high digit, including digit 0.
__global__ __aicore__ void hp_msm_radix_guard(GM_ADDR totals, GM_ADDR control, uint32_t bins)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<16384, 64> io;
    auto input = io.read(totals, bins * 64);
    const auto h = input.ReinterpretCast<uint64_t>();
    uint64_t largest = 0;
    for (uint32_t d = 0; d < bins; ++d) {
        const uint64_t n = h.GetValue(d * 8);
        if (n > largest) largest = n;
    }
    io.release(input);
    auto output = io.alloc_output();
    zero(output, 64);
    auto words = output.ReinterpretCast<uint32_t>();
    words.SetValue(1, largest > msm_radix_partition_records ? 1u : 0u);
    words.SetValue(2, static_cast<uint32_t>(largest));
    io.write(output, control, 64);
}

// Select: publish the record parity the consumers switch on.
__global__ __aicore__ void hp_msm_radix_select(GM_ADDR control, uint32_t route)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<32, 32> io;
    uint32_t fallback = 0;
    if (route == 1) {
        auto input = io.read(control, 8);
        fallback = input.ReinterpretCast<uint32_t>().GetValue(1);
        io.release(input);
    }
    auto output = io.alloc_output();
    zero(output, 32);
    auto words = output.ReinterpretCast<uint32_t>();
    words.SetValue(0, route == 1 && fallback ? 0u : 1u);
    words.SetValue(1, route == 1 ? fallback : 0u);
    io.write(output, control, 8);
}

// Dense tail: the frozen compact convention pads to round8(count) with
// {bucket 0, index UINT32_MAX} in whichever buffer the route selected.
__global__ __aicore__ void hp_msm_radix_pad(
    GM_ADDR records_a, GM_ADDR records_b, GM_ADDR control, uint64_t count)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<32, 64> io;
    auto routing = io.read(control, 8);
    const uint32_t parity = routing.ReinterpretCast<uint32_t>().GetValue(0);
    io.release(routing);
    const uint32_t padded = static_cast<uint32_t>((count + 7) / 8 * 8 - count);
    if (!padded) return;
    GM_ADDR records = parity ? records_b : records_a;
    auto output = io.alloc_output();
    zero(output, 64);
    auto words = output.ReinterpretCast<uint32_t>();
    for (uint32_t i = 0; i < padded; ++i) {
        words.SetValue(2 * i, 0);
        words.SetValue(2 * i + 1, 0xffffffffu);
    }
    io.write(output, records + count * 8, padded * 8);
}

namespace hyperplonk::ascend910b3::detail {
namespace {
// One digit level: histogram -> descriptor prefix -> digit bases, then the
// chunk-local stable scatter and the dense compact gather. `control` is null
// for the always-run decision phase and route 0/2 passes.
void launch_radix_level(aclrtStream stream, void* workspace, const MsmPlan& p,
                        MsmRegion in, MsmRegion out, uint32_t bits, uint32_t shift,
                        GM_ADDR control, uint32_t required_fallback) {
    auto input = region(workspace, p, in);
    auto target = region(workspace, p, out);
    auto histogram = region(workspace, p, MsmRegion::RadixHistogram);
    auto descriptors = region(workspace, p, MsmRegion::RadixDescriptors);
    auto totals = region(workspace, p, MsmRegion::RadixDigitTotals);
    auto fragments = region(workspace, p, MsmRegion::RadixFragments);
    const uint32_t bins = 1u << bits;
    const uint32_t chunk_blocks = msm_device::blocks(p, p.chunks);
    hp_msm_radix_hist<<<chunk_blocks, nullptr, stream>>>(
        input, histogram, control, p.count, p.chunks, shift, bits, bins, required_fallback);
    hp_msm_radix_prefix<<<1, nullptr, stream>>>(
        histogram, descriptors, totals, control, p.chunks, bins, required_fallback);
    hp_msm_radix_bases<<<1, nullptr, stream>>>(totals, control, bins, required_fallback);
    hp_msm_radix_scatter<<<chunk_blocks, nullptr, stream>>>(
        input, descriptors, totals, fragments, control, p.count, p.chunks, shift, bits, bins,
        required_fallback);
    hp_msm_radix_compact<<<chunk_blocks, nullptr, stream>>>(
        fragments, descriptors, totals, target, control, p.chunks, bins, required_fallback);
}
// Decision phase without the record pass: metadata only.
void launch_radix_metadata(aclrtStream stream, void* workspace, const MsmPlan& p,
                           MsmRegion in, uint32_t bits, uint32_t shift) {
    auto input = region(workspace, p, in);
    auto histogram = region(workspace, p, MsmRegion::RadixHistogram);
    auto descriptors = region(workspace, p, MsmRegion::RadixDescriptors);
    auto totals = region(workspace, p, MsmRegion::RadixDigitTotals);
    const uint32_t bins = 1u << bits;
    hp_msm_radix_hist<<<msm_device::blocks(p, p.chunks), nullptr, stream>>>(
        input, histogram, nullptr, p.count, p.chunks, shift, bits, bins, 0);
    hp_msm_radix_prefix<<<1, nullptr, stream>>>(
        histogram, descriptors, totals, nullptr, p.chunks, bins, 0);
    hp_msm_radix_bases<<<1, nullptr, stream>>>(totals, nullptr, bins, 0);
}
} // namespace

void launch_msm_extract(aclrtStream stream,const Fr* scalars,void* workspace,
                        const MsmPlan& plan,uint32_t window)
{
    if(plan.count==0) return;
    const uint32_t bit=window*plan.window_bits;
    const uint32_t remaining=255-bit;
    const uint32_t bits=remaining<plan.window_bits ? remaining : plan.window_bits;
    hp_msm_extract<<<blocks(plan,(plan.count+255)/256),nullptr,stream>>>(
        reinterpret_cast<uint8_t*>(const_cast<Fr*>(scalars)),region(workspace,plan,MsmRegion::RecordsA),
        plan.count,bit,bits);
}

// One coherent 8-bit radix grouping: a single pass for c<=8, the decision/gated
// fast/fallback pair for c=9..16, and three LSD passes for c=17..20. Every
// dynamic choice is made on device through RadixControl.
void launch_msm_radix_group(aclrtStream stream,void* workspace,const MsmPlan& plan)
{
    if(plan.count==0) return;
    auto control=region(workspace,plan,MsmRegion::RadixControl);
    auto records_a=region(workspace,plan,MsmRegion::RecordsA);
    auto records_b=region(workspace,plan,MsmRegion::RecordsB);
    auto totals=region(workspace,plan,MsmRegion::RadixDigitTotals);
    const uint32_t low=plan.radix_pass_bits[0];
    if (plan.radix_route==0) {
        launch_radix_level(stream,workspace,plan,MsmRegion::RecordsA,MsmRegion::RecordsB,
                           low,0,nullptr,0);
    } else if (plan.radix_route==1) {
        const uint32_t high=plan.radix_pass_bits[1];
        // Correctness decision first: high-digit metadata and the guard.
        launch_radix_metadata(stream,workspace,plan,MsmRegion::RecordsA,high,low);
        hp_msm_radix_guard<<<1,nullptr,stream>>>(totals,control,1u<<high);
        // Fast route: coarse stable high-digit scatter+compact, then the
        // in-place whole-partition low-digit sort. Both are gated off when the
        // guard selected the bounded fallback.
        hp_msm_radix_scatter<<<blocks(plan,plan.chunks),nullptr,stream>>>(
            records_a,region(workspace,plan,MsmRegion::RadixDescriptors),totals,
            region(workspace,plan,MsmRegion::RadixFragments),control,plan.count,plan.chunks,
            low,high,1u<<high,0);
        hp_msm_radix_compact<<<blocks(plan,plan.chunks),nullptr,stream>>>(
            region(workspace,plan,MsmRegion::RadixFragments),
            region(workspace,plan,MsmRegion::RadixDescriptors),totals,records_b,control,
            plan.chunks,1u<<high,0);
        hp_msm_radix_partition<<<blocks(plan,1u<<high),nullptr,stream>>>(
            records_b,totals,control,1u<<high,low,0);
        // Fallback from the untouched original: canonical two global LSD passes.
        launch_radix_level(stream,workspace,plan,MsmRegion::RecordsA,MsmRegion::RecordsB,
                           low,0,control,1);
        launch_radix_level(stream,workspace,plan,MsmRegion::RecordsB,MsmRegion::RecordsA,
                           high,low,control,1);
    } else {
        const uint32_t b0=plan.radix_pass_bits[0], b1=plan.radix_pass_bits[1];
        const uint32_t b2=plan.radix_pass_bits[2];
        launch_radix_level(stream,workspace,plan,MsmRegion::RecordsA,MsmRegion::RecordsB,
                           b0,0,nullptr,0);
        launch_radix_level(stream,workspace,plan,MsmRegion::RecordsB,MsmRegion::RecordsA,
                           b1,b0,nullptr,0);
        launch_radix_level(stream,workspace,plan,MsmRegion::RecordsA,MsmRegion::RecordsB,
                           b2,b0+b1,nullptr,0);
    }
    hp_msm_radix_select<<<1,nullptr,stream>>>(control,plan.radix_route);
    hp_msm_radix_pad<<<1,nullptr,stream>>>(records_a,records_b,control,plan.count);
}
} // namespace hyperplonk::ascend910b3::detail
