#include "msm_device.h"
#include "msm_internal.h"
#include "g1_vector.h"

using namespace hyperplonk::ascend910b3;
using namespace hyperplonk::ascend910b3::detail;
using namespace hyperplonk::ascend910b3::detail::msm_device;

namespace {
constexpr uint32_t weighted_fan_in = 4;
using MsmPoints = G1VectorEngine<msm_point_lanes, true>;
}

namespace {
// Dynamic task counts are read through a scoped staging pipe; the point engine
// is built afterwards, so an idle block never pays for (or runs) G1 work.
struct MsmProbeWords { uint64_t word[8]{}; };
class MsmProbe {
public:
    __aicore__ inline MsmProbe() { pipe_.InitBuffer(buffer_, 1, 64); }
    __aicore__ inline void load(GM_ADDR source, MsmProbeWords& out) {
        auto local = buffer_.AllocTensor<uint8_t>();
        AscendC::GlobalTensor<uint8_t> gm; gm.SetGlobalBuffer(source);
        AscendC::DataCopyPad(local, gm, AscendC::DataCopyExtParams{1, 64, 0, 0, 0},
                             AscendC::DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
        buffer_.EnQue(local); local = buffer_.DeQue<uint8_t>();
        const auto e = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(e);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(e);
        const auto words = local.ReinterpretCast<uint64_t>();
        for (uint32_t i = 0; i < 8; ++i) out.word[i] = words.GetValue(i);
        buffer_.FreeTensor(local);
    }
private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> buffer_;
};
} // namespace
// Unconditional window identity: internal Montgomery identity, including the
// zeroed 48-byte tuple padding. Later stages overwrite it when there is work.
__global__ __aicore__ void hp_msm_empty_window(GM_ADDR window)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<32,192> io;
    auto output=io.alloc_output();
    zero(output,192);
    auto words=output.ReinterpretCast<uint32_t>();
    for (uint32_t word=0;word<Bls12381FqParams::word_count;++word)
        words.SetValue(12+word,msm_montgomery_one_words[word]);
    io.write(output,window,192);
}

__global__ __aicore__ void hp_msm_weighted_segments(
    GM_ADDR buckets,GM_ADDR output_points,GM_ADDR meta,uint32_t bucket_count,uint32_t segments,
    uint32_t segment_length)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    {
        MsmProbeWords header{};
        { MsmProbe probe; probe.load(meta, header); }
        if (!header.word[0]) return;
    }
    MsmPoints points;
    constexpr uint32_t tile=MsmPoints::tile_size;
    uint64_t begin[tile], offsets[tile], weights[tile];
    uint32_t counts[tile];
    const uint64_t stride=uint64_t(AscendC::GetBlockNum())*tile;
    for (uint64_t t=uint64_t(AscendC::GetBlockIdx())*tile; t<segments; t+=stride) {
        const uint32_t valid=min32(uint64_t(segments)-t,tile);
        uint32_t max_count=0;
        for (uint32_t lane=0;lane<valid;++lane) {
            begin[lane]=1+uint64_t(segment_length)*(t+lane);
            counts[lane]=min32(uint64_t(bucket_count)-begin[lane],segment_length);
            weights[lane]=begin[lane]-1;
            if (counts[lane]>max_count) max_count=counts[lane];
        }
        // Each lane retains its own descending segment order, including short tails.
        for (uint32_t i=max_count;i>0;--i) {
            for (uint32_t lane=0;lane<valid;++lane)
                offsets[lane]=i<=counts[lane]
                    ? (begin[lane]+i-1)*192 : MsmPoints::absent;
            if (i==max_count) {
                points.load_points_montgomery(0,buckets,offsets,valid);
                points.copy_point(14,0);
            } else {
                points.load_points_montgomery(3,buckets,offsets,valid);
                points.add_assign(0,3);
                points.add_assign(14,0);
            }
        }
        // The segment's local weights start at one; restore absolute bucket weights.
        // mul_by_u64 may destroy running(0), but must preserve local(14).
        points.mul_by_u64(3,0,weights,valid);
        points.add_assign(14,3);
        for (uint32_t lane=0;lane<valid;++lane) offsets[lane]=(t+lane)*192;
        points.store_points_montgomery(14,output_points,offsets,valid);
    }
}

__global__ __aicore__ void hp_msm_weighted_tree(
    GM_ADDR children,GM_ADDR output_points,GM_ADDR meta,uint32_t child_count,uint32_t task_count)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    {
        MsmProbeWords header{};
        { MsmProbe probe; probe.load(meta, header); }
        if (!header.word[0]) return;
    }
    MsmPoints points;
    constexpr uint32_t tile=MsmPoints::tile_size;
    uint64_t begin[tile], offsets[tile];
    uint32_t counts[tile];
    const uint64_t stride=uint64_t(AscendC::GetBlockNum())*tile;
    for (uint64_t t=uint64_t(AscendC::GetBlockIdx())*tile; t<task_count; t+=stride) {
        const uint32_t valid=min32(uint64_t(task_count)-t,tile);
        uint32_t max_count=0;
        for (uint32_t lane=0;lane<valid;++lane) {
            begin[lane]=weighted_fan_in*(t+lane);
            counts[lane]=min32(uint64_t(child_count)-begin[lane],weighted_fan_in);
            if (counts[lane]>max_count) max_count=counts[lane];
        }
        for (uint32_t i=0;i<max_count;++i) {
            for (uint32_t lane=0;lane<valid;++lane)
                offsets[lane]=i<counts[lane] ? (begin[lane]+i)*192 : MsmPoints::absent;
            points.load_points_montgomery(i ? 3 : 0,children,offsets,valid);
            if (i) points.add_assign(0,3);
        }
        for (uint32_t lane=0;lane<valid;++lane) offsets[lane]=(t+lane)*192;
        points.store_points_montgomery(0,output_points,offsets,valid);
    }
}

__global__ __aicore__ void hp_msm_finish(
    GM_ADDR windows,GM_ADDR affine_out,uint32_t window_count,uint32_t window_bits)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    // N=0 writes only the public affine identity, without touching workspace
    // or constructing the field engine for an unnecessary zero inverse.
    if (!window_count) {
        Staging<32,96> io;
        auto output=io.alloc_output();
        zero(output,96);
        io.write(output,affine_out,96);
        return;
    }
    G1Vector points;
    uint64_t offsets[G1Vector::tile_size];
    offsets[0]=uint64_t(window_count-1)*192;
    points.load_points_montgomery(0,windows,offsets,1);
    for (uint32_t w=window_count-1;w>0;--w) {
        for (uint32_t bit=0;bit<window_bits;++bit) points.double_in_place(0);
        offsets[0]=uint64_t(w-1)*192;
        points.load_points_montgomery(3,windows,offsets,1);
        points.add_assign(0,3);
    }
    points.store_affine(0,affine_out);
}

namespace hyperplonk::ascend910b3::detail {
void launch_msm_window_reduce(aclrtStream stream,void* workspace,const MsmPlan& p,
                              uint32_t window) {
    auto destination=region(workspace,p,MsmRegion::Windows)+uint64_t(window)*192;
    // Identity first, unconditionally: an empty window keeps exact component
    // outputs and every later stage cheaply idles on the device task count.
    hp_msm_empty_window<<<1,nullptr,stream>>>(destination);
    launch_msm_bucket_materialize(stream,workspace,p);
    const uint32_t segments=p.weighted_segments;
    const uint64_t lanes=uint64_t(p.platform.aiv_cores)*MsmPoints::tile_size;
    const uint64_t ideal=(uint64_t(p.buckets)-1+lanes-1)/lanes;
    const uint32_t segment_length=ideal<16 ? 16 : static_cast<uint32_t>(ideal);
    auto meta=region(workspace,p,MsmRegion::ScheduleMeta);
    auto source=region(workspace,p,MsmRegion::PartialA);
    hp_msm_weighted_segments<<<blocks(p,(uint64_t(segments)+msm_point_lanes-1)/msm_point_lanes),
        nullptr,stream>>>(region(workspace,p,MsmRegion::Buckets),
        segments==1 ? destination : source,meta,p.buckets,segments,segment_length);
    uint32_t children=segments;
    bool source_is_a=true;
    while (children>1) {
        const uint32_t tasks=(children+weighted_fan_in-1)/weighted_fan_in;
        auto target=tasks==1 ? destination : region(workspace,p,
            source_is_a ? MsmRegion::PartialB : MsmRegion::PartialA);
        hp_msm_weighted_tree<<<blocks(p,(uint64_t(tasks)+msm_point_lanes-1)/msm_point_lanes),
            nullptr,stream>>>(source,target,meta,children,tasks);
        source=target;
        source_is_a=!source_is_a;
        children=tasks;
    }
}
void launch_msm_finish(aclrtStream stream,const void* workspace,G1Affine* out,const MsmPlan& p) {
    // Do not form a region pointer from the permitted null N=0 workspace.
    GM_ADDR windows=nullptr;
    if (p.count) windows=region(const_cast<void*>(workspace),p,MsmRegion::Windows);
    hp_msm_finish<<<1,nullptr,stream>>>(windows,reinterpret_cast<uint8_t*>(out),p.windows,p.window_bits);
}
} // namespace hyperplonk::ascend910b3::detail
