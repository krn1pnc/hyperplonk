#include "msm_device.h"
#include "msm_internal.h"

using namespace hyperplonk::ascend910b3::detail;
using namespace hyperplonk::ascend910b3::detail::msm_device;

// Device CSR schedule: RowPtr -> ScheduleMeta + TaskPrefix with exactly the
// make_msm_schedule byte layout. Metadata only: four kernels, no atomics, no
// point engine, no host round trip. Every tile is written by one block.
namespace {

// One TPipe per kernel (the SDK contract), so this unit carries its own small
// metadata staging instead of the point-engine Staging template.
template<uint32_t In, uint32_t S1 = 0, uint32_t S2 = 0, uint32_t S3 = 0>
class SchedIO {
public:
    __aicore__ inline SchedIO() {
        if constexpr (In) pipe_.InitBuffer(input_, 1, In);
        if constexpr (S1) pipe_.InitBuffer(scratch1_, S1);
        if constexpr (S2) pipe_.InitBuffer(scratch2_, S2);
        if constexpr (S3) pipe_.InitBuffer(scratch3_, S3);
    }
    __aicore__ inline AscendC::LocalTensor<uint8_t> alloc_input() { return input_.AllocTensor<uint8_t>(); }
    __aicore__ inline void copy_in(AscendC::LocalTensor<uint8_t> local, GM_ADDR source, uint32_t bytes) {
        if (!bytes) return;
        AscendC::GlobalTensor<uint8_t> gm; gm.SetGlobalBuffer(source);
        AscendC::DataCopyPad(local, gm, AscendC::DataCopyExtParams{1, bytes, 0, 0, 0},
                             AscendC::DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
    }
    __aicore__ inline void sync_in() {
        const auto e = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(e);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(e);
    }
    __aicore__ inline AscendC::LocalTensor<uint8_t> read(GM_ADDR source, uint32_t bytes) {
        auto local = alloc_input(); copy_in(local, source, bytes);
        input_.EnQue(local); local = input_.DeQue<uint8_t>(); sync_in();
        return local;
    }
    __aicore__ inline void release(AscendC::LocalTensor<uint8_t> local) { input_.FreeTensor(local); }
    __aicore__ inline void read_into(AscendC::LocalTensor<uint8_t> local, GM_ADDR source, uint32_t bytes) {
        copy_in(local, source, bytes); sync_in();
    }
    __aicore__ inline void store(AscendC::LocalTensor<uint8_t> local, GM_ADDR destination, uint32_t bytes) {
        if (!bytes) return;
        auto e = pipe_.FetchEventID(AscendC::HardEvent::S_MTE3);
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(e);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(e);
        AscendC::GlobalTensor<uint8_t> gm; gm.SetGlobalBuffer(destination);
        AscendC::DataCopyPad(gm, local, AscendC::DataCopyExtParams{1, bytes, 0, 0, 0});
        e = pipe_.FetchEventID(AscendC::HardEvent::MTE3_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(e);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(e);
    }
    __aicore__ inline AscendC::LocalTensor<uint8_t> scratch1() { return scratch1_.Get<uint8_t>(); }
    __aicore__ inline AscendC::LocalTensor<uint8_t> scratch2() { return scratch2_.Get<uint8_t>(); }
    __aicore__ inline AscendC::LocalTensor<uint8_t> scratch3() { return scratch3_.Get<uint8_t>(); }
private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> input_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratch1_, scratch2_, scratch3_;
};

constexpr uint32_t sched_merge_levels_word = 12;   // byte 48
constexpr uint32_t sched_order_offset_word = 7;    // byte 56
constexpr uint32_t sched_header_bytes = 64;
constexpr uint32_t sched_cat_hist_byte = 64;
constexpr uint32_t sched_cat_start_meta = 584;     // frozen destination offset
constexpr uint32_t sched_cat_start_byte = 640;     // 32-byte aligned staging slot
constexpr uint32_t sched_header_block = 1184;
constexpr uint32_t sched_table_block = 2048;
constexpr uint32_t sched_tile_block = 24576;
constexpr uint32_t tile_buckets = 256;
constexpr uint32_t cat_batch = 92;                 // 92*260 <= 24576

__aicore__ inline uint64_t meta_cat_base() { return msm_schedule_meta_header_bytes; }
__aicore__ inline uint64_t meta_cat_off_base(uint32_t row_blocks) {
    return meta_cat_base() + uint64_t(msm_schedule_tile_cat_bytes) * row_blocks;
}
__aicore__ inline uint64_t meta_level_sum_base(uint32_t row_blocks) {
    return meta_cat_off_base(row_blocks) + uint64_t(msm_schedule_tile_cat_bytes) * row_blocks;
}
__aicore__ inline uint64_t meta_level_off_base(uint32_t row_blocks) {
    return meta_level_sum_base(row_blocks) + uint64_t(msm_schedule_tile_level_bytes) * row_blocks;
}

} // namespace

// Per row-block tile: category histogram, level task counts and level sums.
__global__ __aicore__ void hp_msm_sched_tiles(
    GM_ADDR rows, GM_ADDR meta, uint32_t buckets, uint32_t row_blocks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    SchedIO<4096, 0, 352> io;
    for (uint32_t t = AscendC::GetBlockIdx(); t < row_blocks; t += AscendC::GetBlockNum()) {
        const uint32_t first = t * tile_buckets;
        const uint32_t n = min32(uint64_t(buckets) + 1 - first, tile_buckets);
        auto input = io.read(rows + uint64_t(first) * 8, (n + 1) * 8);
        const auto values = input.ReinterpretCast<uint64_t>();
        uint32_t cat[msm_schedule_categories]{};
        uint64_t level[msm_schedule_levels]{};
        for (uint32_t i = 0; i < n; ++i) {
            const uint32_t b = first + i;
            // Bucket 0 and the terminating row never contribute a task.
            if (!b || b >= buckets) continue;
            const uint64_t length = values.GetValue(i + 1) - values.GetValue(i);
            const uint64_t tasks = length / 64 + (length % 64 != 0);
            cat[64] += static_cast<uint32_t>(length / 64);
            if (length % 64) ++cat[length % 64];
            uint64_t scale = 1;
            for (uint32_t k = 0; k < msm_schedule_levels; ++k) {
                level[k] += tasks / scale + (tasks % scale != 0);
                scale *= 64;
            }
        }
        io.release(input);
        auto out = io.scratch2();
        zero(out, 352);
        auto out32 = out.ReinterpretCast<uint32_t>();
        auto out64 = out.ReinterpretCast<uint64_t>();
        for (uint32_t c = 0; c < msm_schedule_categories; ++c) out32.SetValue(c, cat[c]);
        // Level sums live at a 32-byte aligned offset so both writes are legal.
        for (uint32_t k = 0; k < msm_schedule_levels; ++k) out64.SetValue(k + 36, level[k]);
        io.store(out, meta + meta_cat_base() + uint64_t(t) * msm_schedule_tile_cat_bytes,
                 msm_schedule_tile_cat_bytes);
        io.store(out[288], meta + meta_level_sum_base(row_blocks) +
                 uint64_t(t) * msm_schedule_tile_level_bytes, msm_schedule_tile_level_bytes);
    }
}

// One block: global descending category starts, merge level, and the absolute
// per-tile category/level offsets used by the fill kernel.
__global__ __aicore__ void hp_msm_sched_scan(
    GM_ADDR meta, uint32_t row_blocks, uint64_t prefix_stride_bytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    SchedIO<sched_tile_block, sched_tile_block, sched_header_block, sched_table_block> io;
    auto level = io.scratch1();
    auto header = io.scratch2();
    auto tables = io.scratch3();
    auto t64 = tables.ReinterpretCast<uint64_t>();
    auto hist = t64[0];
    auto start = t64[65];
    auto running = t64[130];
    auto totals = t64[195];
    auto level_running = t64[201];
    for (uint32_t c = 0; c < msm_schedule_categories; ++c) hist.SetValue(c, 0);
    for (uint32_t k = 0; k < msm_schedule_levels; ++k) totals.SetValue(k, 0);
    uint32_t done = 0;
    while (done < row_blocks) {
        const uint32_t n = min32(uint64_t(row_blocks) - done, cat_batch);
        auto cat = io.read(meta + meta_cat_base() + uint64_t(done) * msm_schedule_tile_cat_bytes,
                           n * msm_schedule_tile_cat_bytes);
        const auto values = cat.ReinterpretCast<uint32_t>();
        for (uint32_t i = 0; i < n; ++i)
            for (uint32_t c = 0; c < msm_schedule_categories; ++c)
                hist.SetValue(c, hist.GetValue(c) + values.GetValue(i * msm_schedule_categories + c));
        io.release(cat);
        io.read_into(level, meta + meta_level_sum_base(row_blocks) +
                     uint64_t(done) * msm_schedule_tile_level_bytes,
                     n * msm_schedule_tile_level_bytes);
        const auto sums = level.ReinterpretCast<uint64_t>();
        for (uint32_t i = 0; i < n; ++i)
            for (uint32_t k = 0; k < msm_schedule_levels; ++k)
                totals.SetValue(k, totals.GetValue(k) + sums.GetValue(i * 6 + k));
        done += n;
    }
    uint64_t position = 0;
    for (uint32_t c = msm_schedule_categories - 1; c >= 1; --c) {
        start.SetValue(c, position);
        position += hist.GetValue(c);
    }
    start.SetValue(0, 0);
    uint32_t merge_levels = msm_schedule_levels - 1;
    for (uint32_t k = 0; k < msm_schedule_levels; ++k)
        if (totals.GetValue(k) == totals.GetValue(msm_schedule_levels - 1)) {
            merge_levels = k;
            break;
        }
    // Absolute per-tile starts: category start plus every earlier tile.
    for (uint32_t c = 0; c < msm_schedule_categories; ++c) running.SetValue(c, start.GetValue(c));
    for (uint32_t k = 0; k < msm_schedule_levels; ++k) level_running.SetValue(k, 0);
    done = 0;
    while (done < row_blocks) {
        const uint32_t n = min32(uint64_t(row_blocks) - done, cat_batch);
        auto cat = io.read(meta + meta_cat_base() + uint64_t(done) * msm_schedule_tile_cat_bytes,
                           n * msm_schedule_tile_cat_bytes);
        auto values = cat.ReinterpretCast<uint32_t>();
        for (uint32_t i = 0; i < n * msm_schedule_categories; ++i) {
            const uint32_t c = i % msm_schedule_categories;
            const uint32_t count = values.GetValue(i);
            values.SetValue(i, static_cast<uint32_t>(running.GetValue(c)));
            running.SetValue(c, running.GetValue(c) + count);
        }
        io.store(cat, meta + meta_cat_off_base(row_blocks) +
                 uint64_t(done) * msm_schedule_tile_cat_bytes, n * msm_schedule_tile_cat_bytes);
        io.release(cat);
        io.read_into(level, meta + meta_level_sum_base(row_blocks) +
                     uint64_t(done) * msm_schedule_tile_level_bytes,
                     n * msm_schedule_tile_level_bytes);
        auto sums = level.ReinterpretCast<uint64_t>();
        for (uint32_t i = 0; i < n; ++i)
            for (uint32_t k = 0; k < msm_schedule_levels; ++k) {
                const uint64_t count = sums.GetValue(i * 6 + k);
                sums.SetValue(i * 6 + k, level_running.GetValue(k));
                level_running.SetValue(k, level_running.GetValue(k) + count);
            }
        io.store(level, meta + meta_level_off_base(row_blocks) +
                 uint64_t(done) * msm_schedule_tile_level_bytes, n * msm_schedule_tile_level_bytes);
        done += n;
    }
    zero(header, sched_header_block);
    auto h32 = header.ReinterpretCast<uint32_t>();
    auto h64 = header.ReinterpretCast<uint64_t>();
    for (uint32_t k = 0; k <= merge_levels; ++k) h64.SetValue(k, totals.GetValue(k));
    h32.SetValue(sched_merge_levels_word, merge_levels);
    h64.SetValue(sched_order_offset_word, prefix_stride_bytes * uint64_t(merge_levels + 1));
    for (uint32_t c = 0; c < msm_schedule_categories; ++c) {
        h64.SetValue(sched_cat_hist_byte / 8 + c, hist.GetValue(c));
        h64.SetValue(sched_cat_start_byte / 8 + c, start.GetValue(c));
    }
    io.store(header, meta, sched_header_bytes);
    io.store(header[sched_cat_hist_byte], meta + sched_cat_hist_byte, msm_schedule_categories * 8);
    io.store(header[sched_cat_start_byte], meta + sched_cat_start_meta,
             msm_schedule_categories * 8);
    // Trailing region padding is part of the published region, so zero it.
    const uint64_t end = meta_level_off_base(row_blocks) +
        uint64_t(msm_schedule_tile_level_bytes) * row_blocks;
    const uint64_t bytes = (end + 63) / 64 * 64;
    if (bytes > end) io.store(header[1024], meta + end, static_cast<uint32_t>(bytes - end));
}

// Fixed grid over tiles: level prefixes and the descending-category task order.
__global__ __aicore__ void hp_msm_sched_fill(
    GM_ADDR rows, GM_ADDR meta, GM_ADDR prefix, uint32_t buckets, uint32_t row_blocks,
    uint64_t prefix_stride_bytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    SchedIO<4096, 16640, 6144> io;
    auto order = io.scratch1();
    auto order_words = order.ReinterpretCast<uint32_t>();
    auto scratch = io.scratch2();
    auto level_row = scratch;
    auto cat_off_at = scratch[4096];
    auto level_off_at = scratch[4384]; // after the 260-byte category offsets + DMA padding
    for (uint32_t t = AscendC::GetBlockIdx(); t < row_blocks; t += AscendC::GetBlockNum()) {
        auto head = io.read(meta, sched_header_bytes);
        const uint32_t merge_levels = head.ReinterpretCast<uint32_t>().GetValue(sched_merge_levels_word);
        const uint64_t order_offset =
            head.ReinterpretCast<uint64_t>().GetValue(sched_order_offset_word);
        io.release(head);
        io.read_into(cat_off_at, meta + meta_cat_off_base(row_blocks) +
                     uint64_t(t) * msm_schedule_tile_cat_bytes, msm_schedule_tile_cat_bytes);
        const auto offsets = cat_off_at.ReinterpretCast<uint32_t>();
        io.read_into(level_off_at, meta + meta_level_off_base(row_blocks) +
                     uint64_t(t) * msm_schedule_tile_level_bytes, msm_schedule_tile_level_bytes);
        const auto level_starts = level_off_at.ReinterpretCast<uint64_t>();
        const uint32_t first = t * tile_buckets;
        const uint32_t n = min32(uint64_t(buckets) + 1 - first, tile_buckets);
        auto input = io.read(rows + uint64_t(first) * 8, (n + 1) * 8);
        const auto values = input.ReinterpretCast<uint64_t>();
        GM_ADDR order_base = prefix + order_offset;
        uint32_t staged[msm_schedule_categories]{};
        uint32_t flushed[msm_schedule_categories]{};
        for (uint32_t k = 0; k <= merge_levels; ++k) {
            uint64_t cumulative = level_starts.GetValue(k), scale = 1;
            for (uint32_t i = 0; i < k; ++i) scale *= 64;
            auto row = level_row.ReinterpretCast<uint64_t>();
            for (uint32_t i = 0; i < n; ++i) {
                row.SetValue(i, cumulative);
                const uint32_t b = first + i;
                if (!b || b >= buckets) continue;
                const uint64_t length = values.GetValue(i + 1) - values.GetValue(i);
                const uint64_t tasks = length / 64 + (length % 64 != 0);
                if (!k) {
                    // Order ids are this bucket's level-0 prefix run: category 64
                    // for full 64-record tasks plus the remainder category.
                    const uint64_t full = length / 64;
                    const uint32_t base = static_cast<uint32_t>(cumulative);
                    const uint64_t rem = length % 64;
                    const uint64_t emits = full + (rem ? 1 : 0);
                    for (uint64_t task = 0; task < emits; ++task) {
                        const uint32_t category = task < full ? 64u : static_cast<uint32_t>(rem);
                        const uint32_t id = base + static_cast<uint32_t>(task < full ? task : full);
                        order_words.SetValue(category * 64 + staged[category], id);
                        if (staged[category] + 1 == 64) {
                            io.store(order[category * 256],
                                     order_base + uint64_t(offsets.GetValue(category) +
                                                           flushed[category]) * 4, 256);
                            flushed[category] += 64;
                            staged[category] = 0;
                        } else {
                            ++staged[category];
                        }
                    }
                }
                cumulative += tasks / scale + (tasks % scale != 0);
            }
            io.store(level_row, prefix + uint64_t(k) * prefix_stride_bytes + uint64_t(first) * 8,
                     n * 8);
        }
        io.release(input);
        for (uint32_t c = 0; c < msm_schedule_categories; ++c)
            if (staged[c])
                io.store(order[c * 256],
                         order_base + uint64_t(offsets.GetValue(c) + flushed[c]) * 4,
                         staged[c] * 4);
    }
}

// One block: prefix[k][0] = 0 and prefix[k][buckets..stride) = total_k.
__global__ __aicore__ void hp_msm_sched_edges(
    GM_ADDR meta, GM_ADDR prefix, uint32_t buckets, uint64_t prefix_stride_bytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    SchedIO<4096, 128> io;
    auto head = io.read(meta, sched_header_bytes);
    const auto t64 = head.ReinterpretCast<uint64_t>();
    const uint32_t merge_levels = head.ReinterpretCast<uint32_t>().GetValue(sched_merge_levels_word);
    uint64_t totals[msm_schedule_levels]{};
    for (uint32_t k = 0; k < msm_schedule_levels; ++k) totals[k] = t64.GetValue(k);
    io.release(head);
    auto out = io.scratch1();
    const uint64_t stride = prefix_stride_bytes / 8;
    const uint32_t tail = static_cast<uint32_t>(stride - buckets);
    for (uint32_t k = 0; k <= merge_levels; ++k) {
        zero(out, 128);
        auto words = out.ReinterpretCast<uint64_t>();
        for (uint32_t i = 0; i < tail; ++i) words.SetValue(8 + i, totals[k]);
        GM_ADDR row = prefix + uint64_t(k) * prefix_stride_bytes;
        io.store(out, row, 8);
        io.store(out[64], row + uint64_t(buckets) * 8, tail * 8);
    }
}

namespace hyperplonk::ascend910b3::detail {
void launch_msm_schedule(aclrtStream stream, void* workspace, const MsmPlan& p)
{
    if (!p.count) return;
    auto rows = region(workspace, p, MsmRegion::RowPtr);
    auto meta = region(workspace, p, MsmRegion::ScheduleMeta);
    auto prefix = region(workspace, p, MsmRegion::TaskPrefix);
    const uint64_t stride = p.host_prefix_offset;
    const uint32_t grid = msm_device::blocks(p, p.row_blocks);
    hp_msm_sched_tiles<<<grid, nullptr, stream>>>(rows, meta, p.buckets, p.row_blocks);
    hp_msm_sched_scan<<<1, nullptr, stream>>>(meta, p.row_blocks, stride);
    hp_msm_sched_fill<<<grid, nullptr, stream>>>(rows, meta, prefix, p.buckets, p.row_blocks,
                                                 stride);
    hp_msm_sched_edges<<<1, nullptr, stream>>>(meta, prefix, p.buckets, stride);
}
} // namespace hyperplonk::ascend910b3::detail
