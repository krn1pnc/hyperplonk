// Resident SumCheck prover kernels over the shared Fr vector engine.
//
// Ownership: this translation unit owns only device algorithm code. Every
// table, coefficient, weight, partial and output buffer belongs to the caller
// (bridge_sumcheck.cpp) through the shared runtime registry; the kernels here
// allocate nothing, copy no host data and never synchronize.
//
// Domain: resident subject tables are canonical numeric Fr. Each generic
// arity-a product has scale R^(1-a); coefficients are scaled once on device
// to c*R^(a+1). The unchanged reduce kernel projects the result to canonical.
// Fold converts only the challenge to rR, never the subject table.
//
// Round semantics (matches backend/src/cpu/sum_check.rs and
// ark_poly::DenseMultilinearExtension::fix_variables):
//   * table index bits are low-bit-first, so a fold pairs elements 2b/2b+1;
//   * round r evaluates the CURRENT tables at every grid point t = 0..degree
//     directly,   g(t) = sum over rest entries b of prod_j f_j(t, b), where
//     f_j(t, b) = even_j(b) + t * (odd_j(b) - even_j(b));
//     for a product of arity a this is the same degree-a polynomial the CPU
//     reconstructs by barycentric extrapolation, so the d+1 message values are
//     identical for every t, not only the first a+1;
//   * folding with the previous challenge r is f' = even + r * (odd - even);
//   * the last challenge r_n is never folded and never passed here.
//
// Degenerate metadata stays exact: an empty product list writes d+1 canonical
// zeros, a repeated multiplicand is evaluated repeatedly from one table, and a
// degree-34 product with 34 factors runs the same generic path (the resident
// grid is tiled when degree + 1 exceeds the lane variant's capacity).
//
// UB budget (196352B total, 8192B SDK planning reserve) is checked per variant
// with static_asserts; the lane variant's resident t-grid capacity is published
// in sumcheck_kernels.h and is what the host uses to split the grid.
//
#include "kernel_operator.h"
#include "field.h"
#include "sumcheck_vector_engine.h"
#include "mle_kernels.h"
#include "sumcheck_kernels.h"

using namespace AscendC;
using namespace hyperplonk::ascend910b3;


namespace hyperplonk::ascend910b3::sumcheck_detail {

__aicore__ inline uint32_t min_u32(uint32_t a, uint32_t b) { return a < b ? a : b; }

template<uint32_t Lanes>
__aicore__ inline void convert_impl(GM_ADDR input, GM_ADDR output, uint64_t count) {
    using Engine = SumcheckVectorEngine<Lanes>;
    if (count == 0) return;
    Engine engine;
    const uint64_t stride = uint64_t(AscendC::GetBlockNum()) * Lanes;
    for (uint64_t offset = uint64_t(AscendC::GetBlockIdx()) * Lanes; offset < count;
         offset += stride) {
        const uint32_t valid =
            uint32_t(count - offset < Lanes ? count - offset : Lanes);
        engine.load_plain(input + offset * 32, valid);
        engine.to_montgomery(Engine::value_row);
        engine.store_plain(output + offset * 32, Engine::value_row, valid);
    }
}

template<uint32_t Lanes>
__aicore__ inline void fold_impl(GM_ADDR input, GM_ADDR coordinate, GM_ADDR output,
                                 uint32_t exponent) {
    using Engine = SumcheckVectorEngine<Lanes>;
    if (exponent == 0) return;
    Engine engine;
    const uint64_t out_count = uint64_t(1) << (exponent - 1);
    // Canonical challenge -> one Montgomery scalar replicated over all lanes.
    engine.replicate_value(Engine::scratch2_row, coordinate);
    engine.to_montgomery(Engine::scratch2_row);
    const uint64_t stride = uint64_t(AscendC::GetBlockNum()) * Lanes;
    for (uint64_t offset = uint64_t(AscendC::GetBlockIdx()) * Lanes; offset < out_count;
         offset += stride) {
        const uint32_t valid =
            uint32_t(out_count - offset < Lanes ? out_count - offset : Lanes);
        engine.load_pair(input + offset * 64, valid);
        engine.mul_row(Engine::scratch_row, Engine::delta_row, Engine::scratch2_row);
        engine.add_row(Engine::value_row, Engine::value_row, Engine::scratch_row);
        engine.store_plain(output + offset * 32, Engine::value_row, valid);
    }
}

template<uint32_t Lanes>
__aicore__ inline void scale_coefficients_impl(GM_ADDR canonical, GM_ADDR arities,
                                               GM_ADDR scaled, uint32_t count) {
    using Engine = SumcheckVectorEngine<Lanes>;
    Engine engine;
    for (uint64_t p = AscendC::GetBlockIdx(); p < count; p += AscendC::GetBlockNum()) {
        // Copy one u32 with the engine's padded DMA staging, not a GM scalar
        // load. Adjacent arities may differ, so scalar coefficients are
        // independently replicated, scaled and stored once at state creation.
        const uint32_t arity = engine.load_u32(arities + p * 4);
        engine.replicate_value(Engine::value_row, canonical + p * 32);
        const uint64_t repetitions = uint64_t(arity) + 1;
        for (uint64_t i = 0; i < repetitions; ++i)
            engine.to_montgomery(Engine::value_row);
        engine.store_plain(scaled + p * 32, Engine::value_row, 1);
    }
}

template<uint32_t Lanes>
__aicore__ inline void message_impl(GM_ADDR offsets, uint32_t arity,
                                    uint64_t rest_count,
                                    uint32_t t_begin, uint32_t t_count, GM_ADDR partial,
                                    uint32_t product_index, uint32_t degree,
                                    GM_ADDR chunk_weight, uint32_t blocks) {
    using Engine = SumcheckVectorEngine<Lanes>;
    constexpr uint32_t capacity = Engine::address_capacity;
    if (arity == 0 || rest_count == 0 || t_count == 0 || blocks == 0) return;
    Engine engine;
    for (uint32_t t = 0; t < t_count; ++t) engine.zero_digits(Engine::acc_row(t));
    if (t_begin != 0) engine.replicate_value(Engine::scratch2_row, chunk_weight);
    const bool staged_once = arity <= capacity;
    if (staged_once) engine.stage_offsets(offsets, arity);

    const uint64_t tiles = (rest_count + Lanes - 1) / Lanes;
    const uint64_t grid = uint64_t(AscendC::GetBlockNum());
    for (uint64_t tile = uint64_t(AscendC::GetBlockIdx()); tile < tiles; tile += grid) {
        const uint64_t pair_begin = tile * Lanes;
        const uint32_t valid =
            uint32_t(rest_count - pair_begin < Lanes ? rest_count - pair_begin : Lanes);
        uint32_t done = 0;
        while (done < arity) {
            const uint32_t chunk = min_u32(arity - done, capacity);
            if (!staged_once) engine.stage_offsets(offsets + uint64_t(done) * Engine::address_stride,
                                                   chunk);
            for (uint32_t i = 0; i < chunk; ++i) {
                GM_ADDR table = reinterpret_cast<GM_ADDR>(engine.staged_offset(i));
                engine.load_pair(table + pair_begin * 64, valid);
                engine.copy_digits(Engine::v_row, Engine::value_row);
                if (t_begin != 0) {
                    engine.mul_row(Engine::scratch_row, Engine::delta_row,
                                   Engine::scratch2_row);
                    engine.add_row(Engine::v_row, Engine::v_row, Engine::scratch_row);
                }
                for (uint32_t t = 0; t < t_count; ++t) {
                    if (t != 0) engine.add_row(Engine::v_row, Engine::v_row, Engine::delta_row);
                    if (done == 0 && i == 0)
                        engine.copy_digits(Engine::prod_row(t), Engine::v_row);
                    else
                        engine.mul_row(Engine::prod_row(t), Engine::prod_row(t),
                                       Engine::v_row);
                }
            }
            done += chunk;
        }
        for (uint32_t t = 0; t < t_count; ++t)
            engine.add_row(Engine::acc_row(t), Engine::acc_row(t), Engine::prod_row(t));
    }

    for (uint32_t t = 0; t < t_count; ++t) {
        engine.lane_sum(Engine::acc_row(t));
        const uint64_t record =
            (uint64_t(product_index) * (uint64_t(degree) + 1) + uint64_t(t_begin) + t) *
                blocks +
            AscendC::GetBlockIdx();
        engine.store_plain(partial + record * 32, Engine::acc_row(t), 1);
    }
}

template<uint32_t Lanes>
__aicore__ inline void reduce_impl(GM_ADDR partial, GM_ADDR coefficients, GM_ADDR output,
                                   uint32_t product_count, uint32_t degree,
                                   uint32_t blocks) {
    using Engine = SumcheckVectorEngine<Lanes>;
    if (degree == UINT32_MAX) return;
    Engine engine;
    const uint32_t total = degree + 1;
    const uint32_t grid = uint32_t(AscendC::GetBlockNum());
    for (uint32_t t = uint32_t(AscendC::GetBlockIdx()); t < total; t += grid) {
        engine.zero_digits(Engine::acc_row(0));
        for (uint32_t p = 0; p < product_count; ++p) {
            engine.zero_digits(Engine::acc_row(1));
            for (uint32_t first = 0; first < blocks; first += Lanes) {
                const uint32_t count = min_u32(blocks - first, Lanes);
                const uint64_t record =
                    (uint64_t(p) * total + t) * blocks + first;
                engine.load_plain(partial + record * 32, count);
                engine.add_row(Engine::acc_row(1), Engine::acc_row(1),
                               Engine::value_row);
            }
            engine.lane_sum(Engine::acc_row(1));
            engine.load_lane_zero(Engine::scratch_row, coefficients + uint64_t(p) * 32);
            engine.mul_row(Engine::acc_row(1), Engine::acc_row(1), Engine::scratch_row);
            engine.add_row(Engine::acc_row(0), Engine::acc_row(0), Engine::acc_row(1));
        }
        engine.mul_row(Engine::acc_row(0), Engine::acc_row(0), Engine::one_row);
        engine.store_plain(output + uint64_t(t) * 32, Engine::acc_row(0), 1);
    }
}

} // namespace hyperplonk::ascend910b3::sumcheck_detail

// Explicit per-variant kernels: the launcher selects one exported entry per
// (operation, lane variant) so no work depends on templated __global__ symbols.
__global__ __aicore__ void hp_sumcheck_convert_48(GM_ADDR input, GM_ADDR output,
                                                 uint64_t count) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    hyperplonk::ascend910b3::sumcheck_detail::convert_impl<48>(input, output, count);
}
__global__ __aicore__ void hp_sumcheck_convert_32(GM_ADDR input, GM_ADDR output,
                                                 uint64_t count) {
