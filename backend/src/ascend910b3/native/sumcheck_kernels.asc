namespace hyperplonk::ascend910b3::detail {
namespace {

uint8_t* byte_address(const void* pointer) {
    return reinterpret_cast<uint8_t*>(const_cast<void*>(pointer));
}

// Convert/fold grids are a parallelism hint only: one block per lane tile,
// never more than the platform's real AIV count and never more than the
// published DAV2201 cap. The shared MLE helper caches the platform query; it is
// host control metadata, not field arithmetic.
uint32_t tile_blocks(uint64_t count, uint32_t lanes) {
    const uint32_t cores = mle_aiv_cores();
    if (cores == 0) return 0;
    const uint64_t tiles = (count + lanes - 1) / lanes;
    if (tiles == 0) return 0;
    const uint32_t limit = cores < sumcheck_block_cap ? cores : sumcheck_block_cap;
    return uint32_t(tiles < limit ? tiles : limit);
}

} // namespace

bool launch_sumcheck_convert(aclrtStream stream, const Fr* input, Fr* output,
                             uint64_t count, uint32_t lanes) {
    if (!stream) return false;
    if (count == 0) return true;
    if (!input || !output) return false;
    const uint32_t blocks = tile_blocks(count, lanes);
    if (blocks == 0) return false;
    GM_ADDR source = byte_address(input);
    GM_ADDR destination = byte_address(output);
    switch (lanes) {
    case sumcheck_lane_wide:
        hp_sumcheck_convert_48<<<blocks, nullptr, stream>>>(source, destination, count);
        return true;
    case sumcheck_lane_medium:
        hp_sumcheck_convert_32<<<blocks, nullptr, stream>>>(source, destination, count);
        return true;
    case sumcheck_lane_narrow:
        hp_sumcheck_convert_16<<<blocks, nullptr, stream>>>(source, destination, count);
        return true;
    default:
        return false;
    }
}

bool launch_sumcheck_fold(aclrtStream stream, const Fr* input, const Fr* coordinate,
                          Fr* output, uint32_t exponent, uint32_t lanes) {
    if (!stream) return false;
    if (exponent == 0 || exponent > 63) return false;
    if (!input || !coordinate || !output) return false;
    if (input == output) return false;
    const uint64_t count = uint64_t(1) << (exponent - 1);
    const uint32_t blocks = tile_blocks(count, lanes);
    if (blocks == 0) return false;
    GM_ADDR source = byte_address(input);
    GM_ADDR point = byte_address(coordinate);
    GM_ADDR destination = byte_address(output);
    switch (lanes) {
    case sumcheck_lane_wide:
        hp_sumcheck_fold_48<<<blocks, nullptr, stream>>>(source, point, destination,
                                                         exponent);
        return true;
    case sumcheck_lane_medium:
        hp_sumcheck_fold_32<<<blocks, nullptr, stream>>>(source, point, destination,
                                                         exponent);
        return true;
    case sumcheck_lane_narrow:
        hp_sumcheck_fold_16<<<blocks, nullptr, stream>>>(source, point, destination,
                                                         exponent);
        return true;
    default:
        return false;
    }
}

bool launch_sumcheck_message(aclrtStream stream, const uint64_t* offsets,
                             uint32_t arity, uint64_t rest_count,
                             uint32_t t_begin, uint32_t t_count, Fr* partial,
                             uint32_t product_index, uint32_t degree,
                             const Fr* chunk_weight, uint32_t blocks, uint32_t lanes) {
    if (!stream) return false;
    if (!offsets || !partial) return false;
    if (arity == 0 || rest_count == 0 || t_count == 0 || blocks == 0) return false;
    if (t_begin != 0 && !chunk_weight) return false;
    // Defensive: the resident t-grid capacity is the published chunk per lane
    // variant; a larger t_count would index outside the engine's row arena.
    const uint32_t capacity = lanes == sumcheck_lane_wide
                                  ? sumcheck_chunk_wide
                                  : (lanes == sumcheck_lane_medium
                                         ? sumcheck_chunk_medium
                                         : sumcheck_chunk_narrow);
    if (t_count > capacity) return false;
    GM_ADDR offset_address = byte_address(offsets);
    GM_ADDR partial_address = byte_address(partial);
    GM_ADDR weight_address = nullptr;
    if (chunk_weight) weight_address = byte_address(chunk_weight);
    switch (lanes) {
    case sumcheck_lane_wide:
        hp_sumcheck_message_48<<<blocks, nullptr, stream>>>(
            offset_address, arity, rest_count, t_begin,
            t_count, partial_address, product_index, degree, weight_address, blocks);
        return true;
    case sumcheck_lane_medium:
        hp_sumcheck_message_32<<<blocks, nullptr, stream>>>(
            offset_address, arity, rest_count, t_begin,
            t_count, partial_address, product_index, degree, weight_address, blocks);
        return true;
    case sumcheck_lane_narrow:
        hp_sumcheck_message_16<<<blocks, nullptr, stream>>>(
            offset_address, arity, rest_count, t_begin,
            t_count, partial_address, product_index, degree, weight_address, blocks);
        return true;
    default:
        return false;
    }
}

bool launch_sumcheck_scale_coefficients(aclrtStream stream, const Fr* canonical,
                                        const uint32_t* arities, Fr* scaled,
                                        uint32_t count, uint32_t lanes) {
    if (!stream) return false;
    if (count == 0) return true;
    if (!canonical || !arities || !scaled) return false;
    const uint32_t blocks = tile_blocks(count, 1);
    if (!blocks) return false;
    GM_ADDR source = byte_address(canonical);
    GM_ADDR metadata = byte_address(arities);
    GM_ADDR destination = byte_address(scaled);
    switch (lanes) {
    case sumcheck_lane_wide:
        hp_sumcheck_scale_coefficients_48<<<blocks, nullptr, stream>>>(
            source, metadata, destination, count);
        return true;
    case sumcheck_lane_medium:
        hp_sumcheck_scale_coefficients_32<<<blocks, nullptr, stream>>>(
            source, metadata, destination, count);
        return true;
    case sumcheck_lane_narrow:
        hp_sumcheck_scale_coefficients_16<<<blocks, nullptr, stream>>>(
            source, metadata, destination, count);
        return true;
    default: return false;
    }
}

bool launch_sumcheck_reduce(aclrtStream stream, const Fr* partial, const Fr* coefficients,
                            Fr* output, uint32_t product_count, uint32_t degree,
                            uint32_t blocks, uint32_t lanes) {
    if (!stream) return false;
    if (!output) return false;
    if (degree == UINT32_MAX) return false;
    if (product_count != 0 && (!partial || !coefficients || blocks == 0)) return false;
    GM_ADDR partial_address = nullptr;
    if (partial) partial_address = byte_address(partial);
    GM_ADDR coefficient_address = nullptr;
    if (coefficients) coefficient_address = byte_address(coefficients);
    GM_ADDR output_address = byte_address(output);
    const uint32_t grid = uint32_t(degree + 1 < sumcheck_block_cap ? degree + 1
                                                                 : sumcheck_block_cap);
    switch (lanes) {
    case sumcheck_lane_wide:
        hp_sumcheck_reduce_48<<<grid, nullptr, stream>>>(partial_address,
                                                         coefficient_address,
                                                         output_address, product_count,
                                                         degree, blocks);
        return true;
    case sumcheck_lane_medium:
        hp_sumcheck_reduce_32<<<grid, nullptr, stream>>>(partial_address,
                                                         coefficient_address,
                                                         output_address, product_count,
                                                         degree, blocks);
        return true;
    case sumcheck_lane_narrow:
        hp_sumcheck_reduce_16<<<grid, nullptr, stream>>>(partial_address,
                                                         coefficient_address,
                                                         output_address, product_count,
                                                         degree, blocks);
        return true;
    default:
        return false;
    }
}

} // namespace hyperplonk::ascend910b3::detail
