#include "square_probe.h"
#include "g1_vector.h"

namespace hyperplonk::ascend910b3 {
struct SquareProbeAccess {
    template<class E> __aicore__ static inline void initialize(E& e) {
        AscendC::Duplicate(e.i32(0), int32_t(0x13579), E::banks / 4);
        // Logical modulus bank 7 and radix mask 15 are constructor-owned.
        AscendC::Duplicate(e.template bank<0>(), int32_t(0x13579),
                          (E::accumulator - E::banks - E::bank_bytes) / 4);
        AscendC::Duplicate(e.acc(), int32_t(0x24681), 65 * E::lanes);
        AscendC::Duplicate(e.tmp(0), int32_t(0x35791), 15 * E::lanes);
        e.vector_barrier();
    }
    template<class E> __aicore__ static inline void snapshot(E& e, GM_ADDR out) {
        e.template sync<AscendC::HardEvent::V_MTE3>();
        e.copy_out(e.bytes(0), out, E::arena_bytes);
        e.template sync<AscendC::HardEvent::MTE3_V>();
    }
    template<class E> __aicore__ static inline void load(E& e,
        AscendC::LocalTensor<uint8_t> dst, GM_ADDR input, uint32_t bytes) {
        e.template sync<AscendC::HardEvent::V_MTE2>();
        e.copy_in(dst, input, bytes);
        e.template sync<AscendC::HardEvent::MTE2_V>();
    }
    template<class F, uint32_t L, bool C> __aicore__ static inline void primitive(
        GM_ADDR input, GM_ADDR debug, uint32_t count, bool canonical, bool alias) {
        using E = FieldVector<F,L,C>;
        E e;
        initialize(e);
        const uint32_t tiles = (count + L - 1) / L;
        for (uint32_t tile = 0; tile < tiles; ++tile) {
            for (uint32_t pass = 0; pass < 2; ++pass) {
                const uint32_t record = tile * 2 + pass;
                load(e, e.template bank<0>().template ReinterpretCast<uint8_t>(),
                     input + uint64_t(record) * E::digits * L * 4, E::digits * L * 4);
                // Distinct lane sentinels are debug data, never scalar field reads.
                for (uint32_t j = 6; j < 15; ++j)
                    load(e, e.tmp(j).template ReinterpretCast<uint8_t>(),
                         input + uint64_t(tiles) * 2 * E::digits * L * 4, L * 4);
                AscendC::Duplicate(e.acc(), int32_t(0x24681), 65 * L);
                AscendC::Duplicate(e.template bank<6>(), int32_t(0x46813), 32 * L);
                e.vector_barrier();
                GM_ADDR out = debug + uint64_t(record) * 2 * E::arena_bytes;
                snapshot(e, out);
                auto dst = alias ? e.template bank<0>() : e.template bank<2>();
                if (canonical) e.montgomery_square(dst, e.template bank<0>());
                else e.montgomery_square_redundant(dst, e.template bank<0>());
                snapshot(e, out + E::arena_bytes);
            }
        }
    }
    template<uint32_t L, bool P> __aicore__ static inline void adapter(
        GM_ADDR input, GM_ADDR debug, uint32_t count, bool alias) {
        using G = G1VectorEngine<L,P>;
        using E = FieldVector<Fq,L,P>;
        G g;
        auto& e = g.fq_;
        initialize(e);
        AscendC::Duplicate(g.extra_memory_.template ReinterpretCast<int32_t>(),
                          int32_t(0x57913), G::mont_one_offset / 4);
        e.vector_barrier();
        if constexpr (P) g.prepare_widen_indices();
        const uint32_t tiles = (count + L - 1) / L;
        constexpr uint32_t size = E::arena_bytes + G::extra_bytes;
        for (uint32_t tile = 0; tile < tiles; ++tile) {
            for (uint32_t pass = 0; pass < 2; ++pass) {
                const uint32_t record = tile * 2 + pass;
                load(e, g.slot(0).template ReinterpretCast<uint8_t>(),
                     input + uint64_t(record) * G::field_bytes, G::field_bytes);
                for (uint32_t j = 6; j < 15; ++j) {
                    load(e, e.tmp(j).template ReinterpretCast<uint8_t>(),
                         input + uint64_t(tiles) * 2 * G::field_bytes, L * 4);
                }
                AscendC::Duplicate(e.acc(), int32_t(0x24681), 65 * L);
                e.vector_barrier();
                GM_ADDR out = debug + uint64_t(record) * 2 * size;
                snapshot(e, out);
                e.template sync<AscendC::HardEvent::V_MTE3>();
                e.copy_out(g.extra_memory_, out + E::arena_bytes, G::extra_bytes);
                e.template sync<AscendC::HardEvent::MTE3_V>();
                g.square(g.slot(alias ? 0 : 3), g.slot(0));
                snapshot(e, out + size);
                e.template sync<AscendC::HardEvent::V_MTE3>();
                e.copy_out(g.extra_memory_, out + size + E::arena_bytes, G::extra_bytes);
                e.template sync<AscendC::HardEvent::MTE3_V>();
            }
        }
    }
};
}

__global__ __aicore__ void square_probe_kernel(GM_ADDR input, GM_ADDR debug,
    uint32_t count, uint32_t lanes, uint32_t mode, bool canonical, bool alias) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    using namespace hyperplonk::ascend910b3;
    if (mode == 2) {
        if (lanes == 64) SquareProbeAccess::adapter<64,true>(input,debug,count,alias);
        else SquareProbeAccess::adapter<48,false>(input,debug,count,alias);
    } else if (mode == 0) {
        if (lanes == 64) SquareProbeAccess::primitive<Fr,64,true>(input,debug,count,canonical,alias);
        else SquareProbeAccess::primitive<Fr,48,false>(input,debug,count,canonical,alias);
    } else {
        if (lanes == 64) SquareProbeAccess::primitive<Fq,64,true>(input,debug,count,canonical,alias);
        else SquareProbeAccess::primitive<Fq,48,false>(input,debug,count,canonical,alias);
    }
}
namespace hyperplonk::ascend910b3::test {
void launch_square_probe(aclrtStream stream, uint8_t* input, uint8_t* debug,
    uint32_t count, uint32_t lanes, uint32_t mode, bool canonical, bool alias) {
    square_probe_kernel<<<1,nullptr,stream>>>(input,debug,count,lanes,mode,canonical,alias);
}
}
