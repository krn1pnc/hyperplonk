#include "kernel_operator.h"
#include "field.h"
#include "math_kernels.h"
#include "field_vector.h"

using namespace hyperplonk::ascend910b3;

template<class Field>
__global__ __aicore__ void field_elementwise_vector(GM_ADDR lhs, GM_ADDR rhs, GM_ADDR out,
                                                   GM_ADDR mask, uint64_t count, uint32_t op)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    FieldVector<Field> engine;
    engine.run(lhs, rhs, out, mask, count, op);
}

namespace hyperplonk::ascend910b3::detail {
namespace {
inline uint8_t* field_address(const void* pointer) {
    return reinterpret_cast<uint8_t*>(const_cast<void*>(pointer));
}
}

template<class Field>
void launch_field(aclrtStream stream, const void* lhs, const void* rhs, Field* out,
                  uint8_t* mask, size_t count, uint32_t cores, FieldOperation op)
{
    if (!count) return;
    const size_t tiles = count / 48 + (count % 48 != 0);
    const uint32_t blocks = static_cast<uint32_t>(tiles < cores ? tiles : cores);
    field_elementwise_vector<Field><<<blocks, nullptr, stream>>>(
        field_address(lhs), field_address(rhs), field_address(out), mask,
        static_cast<uint64_t>(count), static_cast<uint32_t>(op));
}

template void launch_field<Fr>(aclrtStream, const void*, const void*, Fr*, uint8_t*,
                                size_t, uint32_t, FieldOperation);
template void launch_field<Fq>(aclrtStream, const void*, const void*, Fq*, uint8_t*,
                                size_t, uint32_t, FieldOperation);
} // namespace hyperplonk::ascend910b3::detail
