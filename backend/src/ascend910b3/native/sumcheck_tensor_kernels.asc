// DAV2201 MemBase MIX: four genuine 32x32 K512 int8 products per pair tile.
// Passed mixed-ring Cube layout and DotREDC conversion are reused here.
// Raw L0C staging is device HBM (arch22 Fixpipe has no L0C->UB route).
// Corrected cells and radix digits remain UB resident, with no corrected-C
// writeback and no host intermediate transfer. All mathematical masks remain.
//
// Message-input double buffering with strictly per-slot event channels. Each
// group owns two 64 KiB four-corner operand slots - slot 0 inside the original
// record, slot 1 appended after it - and tile n uses slot n&1, so a subblock
// publishes the following tile while the Cube core still loads, multiplies and
// stores the current one. Every logical handshake has its own flag id per slot
// and is used one event at a time:
//   ready_s  (0/1, V->C): both subblocks finished their two corners of the
//     tile that owns slot s.
//   free_s   (2/3, C->V): that tile's four GM reads retired (queued behind
//     them on the Cube MTE2 pipe).
//   result_s (4/5, C->V): that tile's four Fixpipe raw-C stores completed.
//   peerRead (6,   V<->V): the two subblocks' batch barrier (mode 1).
// A slot is reused only after its own free_s and result_s have been waited,
// and both are drained before correction, so no channel ever receives a Set
// while its previous event is unconsumed: the protocol does not depend on a
// flag counter holding more than one event, on any interleaving of the two
// subblocks and the Cube core. Two AIV subblocks still set ready_s and wait
// free_s/result_s - the mode-2 AIC<->all-AIV shape of the original kernel -
// and the repeated-call state returns balanced.
#include "kernel_operator.h"
#include "adv_api/math/xor.h"
#include "sumcheck_tensor.h"
#include "sumcheck_vector_engine.h"
#include "tiling/platform/platform_ascendc.h"
using namespace AscendC;
using namespace hyperplonk::ascend910b3;
using namespace hyperplonk::ascend910b3::detail;
namespace {
using Engine = SumcheckVectorEngine<16>;
using I32 = LocalTensor<int32_t>;
using U32 = LocalTensor<uint32_t>;
using Bytes = LocalTensor<uint8_t>;
constexpr uint32_t kLanes=16, kBatchTiles=16, kCells=1024, kByteLanes=32;
constexpr uint32_t kDigitsOut=44, kWords=8, kCarryBytes=66, kDiagonalCount=63;
constexpr uint32_t kRowBlocks=2, kSumRows=64, kByteRows=68, kGatherCount=512;
constexpr uint32_t kCarrySweeps=66;
constexpr uint32_t kCBytes=65536, kSBytes=4096, kIdxBytes=2048, kTmpBytes=2048;
constexpr uint32_t kByteFieldBytes=4352, kDBytes=2816;
constexpr uint32_t kAccessoryBytes=93952, kPackBytes=28160;
constexpr uint32_t kDigits=32, kTilePoints=512, kC0=32;
constexpr uint32_t kFractalBytes=512;
// Seven fixed flag ids, one per logical channel instance: ready/free/result
// each own one id per operand slot, peer owns its own. Every id is used with
// at most one unconsumed event, so no channel relies on counter capacity.
constexpr uint16_t kFlagReady0=0, kFlagReady1=1;
constexpr uint16_t kFlagFree0=2, kFlagFree1=3;
constexpr uint16_t kFlagResult0=4, kFlagResult1=5;
constexpr uint16_t kFlagPeerRead=6;
// The per-group workspace records, input slots and the appended second input
// slot are fixed by sumcheck_tensor.h: the host allocates from that layout and
// this kernel only reads it, so there is no second copy of the geometry here.
static_assert(sumcheck_tensor_input_slots==2,
              "slot rotation below is written for two slots");
static_assert(kFlagReady1==kFlagReady0+1 && kFlagFree1==kFlagFree0+1 &&
              kFlagResult1==kFlagResult0+1,"per-slot ids must be contiguous");
static_assert(kFlagReady1<kFlagFree0 && kFlagFree1<kFlagResult0 &&
              kFlagResult1<kFlagPeerRead && kFlagPeerRead<=10,
              "channel ids must be distinct and outside the SyncAll reserve");
static_assert(Engine::arena_bytes == 29504 && Engine::tensor_extra_bytes == 26080);
static_assert(kCBytes+kSBytes+kIdxBytes+kTmpBytes+4*kByteFieldBytes+kDBytes==kAccessoryBytes);
static_assert(Engine::arena_bytes+Engine::tensor_extra_bytes+kAccessoryBytes+kPackBytes
              ==sumcheck_tensor_ub_user_bytes);
static_assert(kByteRows==68 && kCarryBytes*8==kDigitsOut*12);
static_assert(32ull*512*255*255 < (1ull<<31));
// Every Access region ends exactly where the next begins; no hidden overlap.
static_assert(65536+kSBytes==69632 && 69632+kIdxBytes==71680);
static_assert(71680+kTmpBytes==73728 && 73728+kByteFieldBytes==78080);
static_assert(78080+kByteFieldBytes==82432 && 82432+kByteFieldBytes==86784);
static_assert(86784+kByteFieldBytes==91136 && 91136+kDBytes==kAccessoryBytes);
// Packing scratch: raw, parity, centered, mask, half, float, sums/temp, XOR,
// and both natural de-interleave gather tables. Correction reuses it only
// after publish/flag-result, with its final index region ending at 16640.
static_assert(0+4096==4096 && 4096+2048==6144 && 6144+2048==8192);
static_assert(8192+2048==10240 && 10240+4096==14336);
static_assert(14336+8192==22528 && 22528+512==23040);
static_assert(23040+1024==24064 && 24064+4096==kPackBytes);
static_assert(12544+4096<=kPackBytes);
// Canonical Fr has p<2^255, hence 512*p<2^264=R and raw T<512*p^2<pR.

template<HardEvent event> __aicore__ inline void sync_event(int32_t id) {
    SetFlag<event>(id); WaitFlag<event>(id);
}
__attribute__((noinline)) __aicore__ inline void normalize_vector_mask() {
    SetMaskNorm(); ResetMask();
}
struct Access {
    TBuf<TPosition::VECCALC> memory;
    Bytes bytes;
    __aicore__ inline void init(Engine& e) {
        e.init_buffer(memory,kAccessoryBytes+kPackBytes); bytes=memory.Get<uint8_t>();
    }
    __aicore__ inline I32 at(uint32_t off) { return bytes[off].ReinterpretCast<int32_t>(); }
    __aicore__ inline I32 c() {return at(0);}
    __aicore__ inline I32 s() {return at(65536);}
    __aicore__ inline U32 idx() {return at(69632).ReinterpretCast<uint32_t>();}
    __aicore__ inline I32 tmp() {return at(71680);}
    __aicore__ inline I32 a() {return at(73728);}
    __aicore__ inline I32 b() {return at(78080);}
    __aicore__ inline I32 carry() {return at(82432);}
    __aicore__ inline I32 digit() {return at(86784);}
    __aicore__ inline I32 d() {return at(91136);}
    __aicore__ inline Bytes pack() {return bytes[kAccessoryBytes];}
    __aicore__ static inline void vector_barrier(Engine& e) {e.vector_barrier();}
    __aicore__ static inline void normalize_mask(Engine& e) {e.normalize_mask();}
    __aicore__ static inline void fence_scalar_to_vector(Engine& e) {e.sync<HardEvent::S_V>();}
};
__aicore__ inline void copy_to_l1_nz(LocalTensor<int8_t> dst, GM_ADDR src, uint32_t rows,
                                     uint32_t cols, uint16_t dstNzC0Stride) {
    GlobalTensor<int8_t> source;
    source.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(src));
    Nd2NzParams params;
    params.ndNum = 1;
    params.nValue = static_cast<uint16_t>(rows);
    params.dValue = static_cast<uint16_t>(cols);
    params.srcNdMatrixStride = 0;
    params.srcDValue = static_cast<uint16_t>(cols);
    params.dstNzC0Stride = dstNzC0Stride;
    params.dstNzNStride = 1;
    params.dstNzMatrixStride = 0;
    DataCopy(dst, source, params);
}

__aicore__ inline U32 as_u32(I32 tensor) {
    return tensor.ReinterpretCast<uint32_t>();
}
__aicore__ inline AscendC::LocalTensor<uint16_t> as_u16(I32 tensor) {
    return tensor.ReinterpretCast<uint16_t>();
}

// Byte base of one message-input slot inside the group record: slot 0 is the
// original operand block at offset 0, later slots are appended after the
// record, so no slot aliases raw C, sums or corner sums.
__aicore__ inline GM_ADDR input_slot(GM_ADDR base,uint32_t slot) {
    return base+(slot==0?uint64_t(0):sumcheck_tensor_input_alt_offset
                +uint64_t(slot-1)*sumcheck_tensor_input_slot_bytes);
}

// One id per slot per logical channel; every Set and Wait below goes through
// these so a single spelling identifies the channel instance.
__aicore__ inline uint16_t ready_flag(uint32_t slot) {return uint16_t(kFlagReady0+slot);}
__aicore__ inline uint16_t free_flag(uint32_t slot) {return uint16_t(kFlagFree0+slot);}
__aicore__ inline uint16_t result_flag(uint32_t slot) {return uint16_t(kFlagResult0+slot);}

// Consume one slot's own free then result event. Reuse inside a batch and the
// pre-correction drain both go through here, so the slot's channels are always
// waited in the same order and no second event can be queued behind them.
__aicore__ inline void consume_slot(uint32_t slot) {
    CrossCoreWaitFlag<2>(free_flag(slot));
    CrossCoreWaitFlag<2>(result_flag(slot));
}

// Public Gather byte-offset table: destination element n = column*16 + tile
// reads element tile*1024 + column of the C tile block. Byte offsets, so the
// table is purely index/control data and holds no field value.
__aicore__ inline void build_tile_index(Engine& engine, U32 indices) {
    engine.sync<HardEvent::V_S>();
    for (uint32_t n = 0; n < kGatherCount; ++n) {
        const uint32_t tile = n % kLanes;
        const uint32_t column = n / kLanes;
        indices.SetValue(n, 4u * (tile * kCells + column));
    }
    Access::fence_scalar_to_vector(engine);
}

// Two broadcast constant rows live in the gather scratch once the 32 diagonal
// gathers of this batch are done: int32 255 (byte mask) and int32 15 (nibble
// mask). The uint16 views are byte-identical to an int32 mask because the high
// halfword of the int32 pattern is zero; And/Or are issued on the uint16 view,
// which is the validated non-broken path in the arena.
__aicore__ inline void build_masks(Engine& engine, I32 tmp) {
    AscendC::Duplicate(tmp, int32_t(255), int32_t(kLanes));
    AscendC::Duplicate(tmp[kLanes], int32_t(15), int32_t(kLanes));
    Access::vector_barrier(engine);
}

// Step 2: d[k][tile] = sum_{u+v=k} C[tile][u][v].
// For fixed u the 16 tiles x 32 columns block is gathered into 32 rows of
// (column v, tile lane) and added at row offset u, so row (u+v) of lane tile
// accumulates C[tile][u][v]. Bounds: each row is written by at most 32 adds of
// values <= 33,292,800, so the int32 sum stays < 2^31.
__aicore__ inline void accumulate_diagonals(Engine& engine, Access& access) {
    I32 c = access.c();
    I32 s = access.s();
    I32 tmp = access.tmp();
    U32 idx = access.idx();
    for (uint32_t u = 0; u < kByteLanes; ++u) {
        Access::normalize_mask(engine);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Gather(tmp, c[u * kByteLanes], idx, uint32_t(0), kGatherCount);
        Access::vector_barrier(engine);
        AscendC::Add(s[u * kLanes], s[u * kLanes], tmp, uint64_t(kLanes),
                     uint8_t(kByteLanes),
                     AscendC::BinaryRepeatParams{1, 1, 1, kRowBlocks, kRowBlocks,
                                                 kRowBlocks});
        Access::vector_barrier(engine);
    }
}

// Step 3: base-256 normalization of T = sum_k d[k] * 256^k.
// Byte plane i of every diagonal row is added at byte position k+i, then the
// carry sweep turns the column sums (<= 4*255) into canonical bytes. The plane
// scratch is `carry`, which is free here and is reused by the sweeps; `tmp`
// holds the two broadcast constants and is never written again this batch.
__aicore__ inline void normalize_bytes(Engine& engine, Access& access) {
    I32 s = access.s();
    I32 a = access.a();
    I32 plane = access.carry();
    I32 tmp = access.tmp();
    for (uint32_t i = 0; i < 4; ++i) {
        if (i == 0) {
            AscendC::And(as_u16(plane), as_u16(s), as_u16(tmp), uint64_t(2 * kLanes),
                         uint8_t(kSumRows),
                         AscendC::BinaryRepeatParams{1, 1, 1, kRowBlocks, kRowBlocks, 0});
        } else {
            AscendC::ShiftRight(as_u32(plane), as_u32(s), uint32_t(8 * i),
                                uint64_t(kLanes), uint8_t(kSumRows),
                                AscendC::UnaryRepeatParams{1, 1, kRowBlocks, kRowBlocks});
            Access::vector_barrier(engine);
            AscendC::And(as_u16(plane), as_u16(plane), as_u16(tmp), uint64_t(2 * kLanes),
                         uint8_t(kSumRows),
                         AscendC::BinaryRepeatParams{1, 1, 1, kRowBlocks, kRowBlocks, 0});
        }
        Access::vector_barrier(engine);
        AscendC::Add(a[i * kLanes], a[i * kLanes], plane, uint64_t(kLanes),
                     uint8_t(kDiagonalCount),
                     AscendC::BinaryRepeatParams{1, 1, 1, kRowBlocks, kRowBlocks,
                                                 kRowBlocks});
        Access::vector_barrier(engine);
    }
    // Guard rows 66/67 carry no contribution but must be zero before the carry
    // sweeps and the later 12-bit shifts read them.
    AscendC::Duplicate(a[kCarryBytes * kLanes], int32_t(0), int32_t(2 * kLanes));
    Access::vector_barrier(engine);
}

// Fixed 66-sweep carry pass over all 16 tile lanes at once. Each sweep keeps
// digit = byte and moves carry = value >> 8 one byte position up; positions
// 0..s-1 are canonical after sweep s, so 66 sweeps finalize bytes 0..65.
__aicore__ inline void canonicalize_bytes(Engine& engine, Access& access) {
    I32 a = access.a();
    I32 carry = access.carry();
    I32 digit = access.digit();
    I32 tmp = access.tmp();
    for (uint32_t sweep = 0; sweep < kCarrySweeps; ++sweep) {
        AscendC::ShiftRight(as_u32(carry), as_u32(a), uint32_t(8), uint64_t(kLanes),
                            uint8_t(kByteRows),
                            AscendC::UnaryRepeatParams{1, 1, kRowBlocks, kRowBlocks});
        Access::vector_barrier(engine);
        AscendC::And(as_u16(digit), as_u16(a), as_u16(tmp), uint64_t(2 * kLanes),
                     uint8_t(kByteRows),
                     AscendC::BinaryRepeatParams{1, 1, 1, kRowBlocks, kRowBlocks, 0});
        Access::vector_barrier(engine);
        // Row r (1..67) = digit row r + carry row r-1: separate tensor bases
        // give the one-row shift, repeat stride stays 2 blocks.
        AscendC::Add(a[kLanes], digit[kLanes], carry, uint64_t(kLanes),
                     uint8_t(kByteRows - 1),
                     AscendC::BinaryRepeatParams{1, 1, 1, kRowBlocks, kRowBlocks,
                                                 kRowBlocks});
        Access::vector_barrier(engine);
        AscendC::Adds(a, digit, int32_t(0), uint64_t(kLanes), uint8_t(1),
                      AscendC::UnaryRepeatParams{1, 1, kRowBlocks, kRowBlocks});
        Access::vector_barrier(engine);
    }
}

// Step 4: canonical bytes -> 44 radix-2^12 digits, least significant first.
//   digit_j = (b[0] | (b[1] & 15) << 8)      (low 12 bits of the field)
//   field  := field >> 12 bits:
//     b'[p] = (b[p+1] >> 4) | ((b[p+2] & 15) << 4), p = 0..65
// Both buffers are 68 rows, so the two guard rows supply b[66], b[67] = 0.
// Ping-pong between the two byte fields; the digit row is written once.
__aicore__ inline void extract_digits(Engine& engine, Access& access) {
    I32 a = access.a();
    I32 b = access.b();
    I32 carry = access.carry();
    I32 digit = access.digit();
    I32 tmp = access.tmp();
    I32 dst = access.d();
    for (uint32_t j = 0; j < kDigitsOut; ++j) {
        I32 src = (j & 1u) ? b : a;
        I32 out = (j & 1u) ? a : b;
        // digit = (src row1 & 15) << 8 | src row0
        AscendC::And(as_u16(digit), as_u16(src[kLanes]), as_u16(tmp[kLanes]),
                     uint64_t(2 * kLanes), uint8_t(1),
                     AscendC::BinaryRepeatParams{1, 1, 1, kRowBlocks, kRowBlocks, 0});
        Access::vector_barrier(engine);
        AscendC::ShiftLeft(as_u32(digit), as_u32(digit), uint32_t(8), uint64_t(kLanes),
                           uint8_t(1),
                           AscendC::UnaryRepeatParams{1, 1, kRowBlocks, kRowBlocks});
        Access::vector_barrier(engine);
        AscendC::Or(as_u16(digit), as_u16(digit), as_u16(src), uint64_t(2 * kLanes),
                    uint8_t(1),
                    AscendC::BinaryRepeatParams{1, 1, 1, kRowBlocks, kRowBlocks,
                                                kRowBlocks});
        Access::vector_barrier(engine);
        AscendC::Adds(dst[j * kLanes], digit, int32_t(0), uint64_t(kLanes),
                      uint8_t(1),
                      AscendC::UnaryRepeatParams{1, 1, kRowBlocks, kRowBlocks});
        Access::vector_barrier(engine);
        // field >>= 12 bits into the other byte buffer.
        AscendC::ShiftRight(as_u32(carry), as_u32(src[kLanes]), uint32_t(4), uint64_t(kLanes),
                            uint8_t(kCarryBytes),
                            AscendC::UnaryRepeatParams{1, 1, kRowBlocks, kRowBlocks});
        Access::vector_barrier(engine);
        AscendC::And(as_u16(digit[kLanes]), as_u16(src[2 * kLanes]),
                     as_u16(tmp[kLanes]), uint64_t(2 * kLanes), uint8_t(kCarryBytes),
                     AscendC::BinaryRepeatParams{1, 1, 1, kRowBlocks, kRowBlocks, 0});
        Access::vector_barrier(engine);
        AscendC::ShiftLeft(as_u32(digit[kLanes]), as_u32(digit[kLanes]), uint32_t(4),
                           uint64_t(kLanes), uint8_t(kCarryBytes),
                           AscendC::UnaryRepeatParams{1, 1, kRowBlocks, kRowBlocks});
        Access::vector_barrier(engine);
        AscendC::Or(as_u16(out), as_u16(carry), as_u16(digit[kLanes]),
                    uint64_t(2 * kLanes), uint8_t(kCarryBytes),
                    AscendC::BinaryRepeatParams{1, 1, 1, kRowBlocks, kRowBlocks,
                                                kRowBlocks});
        Access::vector_barrier(engine);
    }
}


// Packing uses 64-pair chunks so temporary byte/half/float storage stays
// bounded. Only signed sums (magnitude <=65536) enter float, never C cells.
// `input` is the operand slot this tile is published into; `groupbase` still
// addresses the per-slot sums, so both buffers keep their original lifetimes.
__aicore__ inline void publish_tile(Engine& e, Access& a, GM_ADDR factor,
                                    GM_ADDR input, GM_ADDR groupbase, uint64_t rest,
                                    uint64_t tile, uint32_t batch_slot, uint32_t sub) {
    Bytes p=a.pack();
    auto raw=p.ReinterpretCast<int8_t>();
    auto parity=p[4096].ReinterpretCast<int8_t>();
    auto center=p[6144].ReinterpretCast<int8_t>();
    auto mask=p[8192].ReinterpretCast<uint16_t>();
    auto halfwork=p[10240].ReinterpretCast<half>();
    auto floats=p[14336].ReinterpretCast<float>();
    auto sums=p[22528].ReinterpretCast<int32_t>();
    auto temp=p[22784].ReinterpretCast<int32_t>();
    auto xorwork=p[23040];
    xorwork.SetSize(1024);
    auto indices=p[24064].ReinterpretCast<uint32_t>();
    Duplicate(mask,uint16_t(0x8080),1024);
    Duplicate(sums,int32_t(0),64);
    e.sync<HardEvent::V_S>();
    for(uint32_t side=0;side<2;++side)
        for(uint32_t lane=0;lane<64;++lane)
            for(uint32_t word=0;word<8;++word)
                indices.SetValue(side*512+lane*8+word,
                                  4*(lane*16+side*8+word));
    e.sync<HardEvent::S_V>();
    for(uint32_t chunk=0;chunk<8;++chunk) {
        const uint64_t first=tile*512+chunk*64;
        const uint32_t valid=first<rest ? uint32_t(rest-first<64?rest-first:64):0;
        Duplicate(raw.ReinterpretCast<uint16_t>(),uint16_t(0),2048);
        if(valid) e.stage_in(p,factor+first*64,valid*64);
        for(uint32_t side=0;side<2;++side) {
            e.normalize_mask(); PipeBarrier<PIPE_V>();
            Gather(parity.ReinterpretCast<uint32_t>(),raw.ReinterpretCast<uint32_t>(),
                   indices[side*512],uint32_t(0),512);
            e.vector_barrier();
            Xor<uint16_t>(center.ReinterpretCast<uint16_t>(),
                          parity.ReinterpretCast<uint16_t>(),mask,xorwork,1024);
            e.vector_barrier();
            Cast<half,int8_t>(halfwork,center,RoundMode::CAST_NONE,2048);
            e.vector_barrier();
            Cast<float,half>(floats,halfwork,RoundMode::CAST_NONE,2048);
            e.vector_barrier();
            for(uint32_t n=2048;n>32;n/=2) {
                Add(floats,floats,floats[n/2],n/2); e.vector_barrier();
            }
            Cast<int32_t,float>(temp,floats,RoundMode::CAST_ROUND,32);
            e.vector_barrier();
            Add(sums[side*32],sums[side*32],temp,32); e.vector_barrier();
            e.store_out(p[6144],input+(sub*2+side)*16384+chunk*2048,2048);
        }
    }
    for(uint32_t side=0;side<2;++side)
        e.store_out(p[22528+side*128],groupbase+sumcheck_tensor_sums_offset+
                    ((sub*2+side)*16+batch_slot)*128,128);
}

// Each owner corrects all 32x32 cells for its corner directly in the batch
// buffer. Exact integer broadcast/correction; no corrected HBM writeback.
__aicore__ inline void correct_corner(Engine& e, Access& a, GM_ADDR base,
                                      uint32_t corner, uint32_t valid) {
    Bytes p=a.pack();
    I32 sa=p.ReinterpretCast<int32_t>(), sb=p[128].ReinterpretCast<int32_t>();
    I32 row=p[256].ReinterpretCast<int32_t>();
    I32 col=p[4352].ReinterpretCast<int32_t>();
    U32 ri=p[8448].ReinterpretCast<uint32_t>();
    U32 ci=p[12544].ReinterpretCast<uint32_t>();
    e.sync<HardEvent::V_S>();
    for(uint32_t u=0;u<32;++u) for(uint32_t v=0;v<32;++v) {
        ri.SetValue(u*32+v,u*4); ci.SetValue(u*32+v,v*4);
    }
    e.sync<HardEvent::S_V>();
    for(uint32_t t=0;t<16;++t) Duplicate(a.c()[t*1024],int32_t(0),1024);
    e.stage_in(a.c().ReinterpretCast<uint8_t>(),base+sumcheck_tensor_raw_c_offset+
                corner*16*4096,valid*4096);
    const uint32_t fa=corner&1, gb=2+(corner>>1);
    for(uint32_t t=0;t<valid;++t) {
        e.stage_in(p,base+sumcheck_tensor_sums_offset+(fa*16+t)*128,128);
        e.stage_in(p[128],base+sumcheck_tensor_sums_offset+(gb*16+t)*128,128);
        Muls<int32_t,true>(sa,sa,int32_t(128),32);
        Muls<int32_t,true>(sb,sb,int32_t(128),32); e.vector_barrier();
        e.normalize_mask(); PipeBarrier<PIPE_V>(); Gather(row,sa,ri,uint32_t(0),1024);
        e.vector_barrier();
        e.normalize_mask(); PipeBarrier<PIPE_V>(); Gather(col,sb,ci,uint32_t(0),1024);
        e.vector_barrier();
        Add(a.c()[t*1024],a.c()[t*1024],row,1024); e.vector_barrier();
        Add(a.c()[t*1024],a.c()[t*1024],col,1024); e.vector_barrier();
        Adds<int32_t,true>(a.c()[t*1024],a.c()[t*1024],int32_t(8388608),1024);
        e.vector_barrier();
    }
    Duplicate(a.s(),int32_t(0),kSumRows*kLanes);
    Duplicate(a.a(),int32_t(0),kByteRows*kLanes);
    Duplicate(a.b(),int32_t(0),kByteRows*kLanes); e.vector_barrier();
    // pack/correction scratch has no overlap with the REDC accessory arena.
    build_tile_index(e,a.idx());
    accumulate_diagonals(e,a);
    build_masks(e,a.tmp()); normalize_bytes(e,a); canonicalize_bytes(e,a);
    extract_digits(e,a); e.redc_wide_soa(0,a.d());
}

__aicore__ inline void run_aiv(GM_ADDR bindings, uint64_t rest, GM_ADDR partial,
                               uint32_t product, uint32_t groups, GM_ADDR workspace,
                               uint32_t group, uint32_t sub) {
    Engine e(true); Access a; a.init(e);
    e.stage_offsets(bindings,2);
    GM_ADDR factor=reinterpret_cast<GM_ADDR>(e.staged_offset(sub));
    GM_ADDR base=workspace+uint64_t(group)*sumcheck_tensor_group_stride;
    const uint64_t tiles=(rest+511)/512;
    e.zero_digits(7); e.zero_digits(8);
    // Bit s means slot s holds a tile whose free_s/result_s events this
    // subblock has not consumed yet. Together with the rotating slot it is the
    // whole per-slot state: a slot is only rewritten after its own events
    // were waited, so every channel holds at most one event.
    uint32_t occupied=0;
    uint32_t slot=0;
    for(uint64_t first=group;first<tiles;first+=uint64_t(groups)*16) {
        const uint64_t remaining=(tiles-1-first)/groups+1;
        const uint32_t count=uint32_t(remaining<16?remaining:16);
        for(uint32_t local=0;local<count;++local) {
            if(occupied&(1u<<slot)) {
                consume_slot(slot);
                occupied&=~(1u<<slot);
            }
            publish_tile(e,a,factor,input_slot(base,slot),base,rest,
                         first+uint64_t(local)*groups,local,sub);
            CrossCoreSetFlag<2,PIPE_MTE3>(ready_flag(slot));
            occupied|=1u<<slot;
            slot^=1u;
        }
        // Correction reads raw C and the peer sums of the whole batch, so the
        // events of the batch's trailing tiles are consumed first.
        for(uint32_t s=0;s<sumcheck_tensor_input_slots;++s) {
            if(occupied&(1u<<s)) {
                consume_slot(s);
                occupied&=~(1u<<s);
            }
        }
        for(uint32_t local=0;local<2;++local) {
            correct_corner(e,a,base,sub*2+local,count);
            e.add_row(7+local,7+local,0);
        }
        // WAR: both AIVs copied every peer sum before either next publish.
        CrossCoreSetFlag<1,PIPE_MTE2>(kFlagPeerRead);
        CrossCoreWaitFlag<1>(kFlagPeerRead);
    }
    e.lane_sum(7); e.lane_sum(8);
    if(sub==1) {
        e.store_plain(base+sumcheck_tensor_corner_sums_offset,7,1);
        e.store_plain(base+sumcheck_tensor_corner_sums_offset+32,8,1);
    }
    // The same matched mode-1 channel orders the final p2,p3 HBM stores.
    CrossCoreSetFlag<1,PIPE_MTE3>(kFlagPeerRead);
    CrossCoreWaitFlag<1>(kFlagPeerRead);
    if(sub==0) {
        e.load_lane_zero(9,base+sumcheck_tensor_corner_sums_offset);
        e.load_lane_zero(10,base+sumcheck_tensor_corner_sums_offset+32);
        const uint64_t record=uint64_t(product)*3*groups+group;
        e.store_plain(partial+record*32,7,1);                 // S0 = p0
        e.store_plain(partial+(record+groups)*32,10,1);       // S1 = p3
        e.add_row(8,8,8); e.add_row(9,9,9);
        e.add_row(10,10,10); e.add_row(10,10,10);
        e.sub_row(0,7,8); e.sub_row(0,0,9); e.add_row(0,0,10);
        e.store_plain(partial+(record+2*groups)*32,0,1);      // S2 = p0-2p1-2p2+4p3
    }
}

__aicore__ inline void run_aic(GM_ADDR workspace,uint64_t tiles,uint32_t groups,
                               uint32_t group) {
    const LocalTensor<int8_t> a1(TPosition::A1,0,32768);
    const LocalTensor<int8_t> b1(TPosition::B1,32768,32768);
    const LocalTensor<int8_t> a2(TPosition::A2,0,16384);
    const LocalTensor<int8_t> b2(TPosition::B2,0,16384);
    const LocalTensor<int32_t> c(TPosition::CO1,0,1024);
    GM_ADDR base=workspace+uint64_t(group)*sumcheck_tensor_group_stride;
    // Same rotating slot sequence as the publishers (one slot per tile).
    uint32_t slot=0;
    SetFlag<HardEvent::FIX_M>(EVENT_ID3);
    for(uint64_t first=group;first<tiles;first+=uint64_t(groups)*16) {
        const uint64_t remaining=(tiles-1-first)/groups+1;
        const uint32_t count=uint32_t(remaining<16?remaining:16);
        for(uint32_t local=0;local<count;++local) {
            CrossCoreWaitFlag<2>(ready_flag(slot));
            GM_ADDR input=input_slot(base,slot);
            for(uint32_t m=0;m<2;++m) {
                copy_to_l1_nz(a1[m*16384],input+m*16384,512,32,512);
                copy_to_l1_nz(b1[m*16384],input+(m+2)*16384,512,32,512);
            }
            // These four GM reads are the only consumers of the slot: the sync
            // is queued behind them on MTE2, so free_s means the reads retired.
            CrossCoreSetFlag<2,PIPE_MTE2>(free_flag(slot));
            sync_event<HardEvent::MTE2_MTE1>(EVENT_ID0);
            for(uint32_t corner=0;corner<4;++corner) {
                LoadData2dTransposeParams ap;
                ap.startIndex=0; ap.repeatTimes=16; ap.srcStride=1;
                ap.dstGap=0; ap.dstFracGap=15;
                LoadDataWithTranspose(a2,a1[(corner&1)*16384],ap);
                LoadData2dTransposeParams bp;
                bp.startIndex=0; bp.repeatTimes=1; bp.srcStride=16;
                bp.dstGap=1; bp.dstFracGap=0;
                for(uint32_t block=0;block<16;++block)
                    LoadDataWithTranspose(b2[block*1024],
                        b1[(corner>>1)*16384+block*1024],bp);
                sync_event<HardEvent::MTE1_M>(EVENT_ID1);
                WaitFlag<HardEvent::FIX_M>(EVENT_ID3);
                MmadParams mm; mm.m=32;mm.n=32;mm.k=512;mm.cmatrixInitVal=true;
                Mmad(c,a2,b2,mm);
                sync_event<HardEvent::M_FIX>(EVENT_ID2);
                FixpipeParamsV220 store;
                store.nSize=32;store.mSize=32;store.srcStride=32;store.dstStride=32;
                store.quantPre=QuantMode_t::NoQuant;store.reluEn=false;store.ndNum=1;
                GlobalTensor<int32_t> out;
                out.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(
                    base+sumcheck_tensor_raw_c_offset+(corner*16+local)*4096));
                Fixpipe(out,c,store);
                SetFlag<HardEvent::FIX_M>(EVENT_ID3);
                // Retire Mmad's A2/B2 reads before the next corner reload.
                sync_event<HardEvent::M_MTE1>(EVENT_ID4);
            }
            // L1 is not overwritten until MTE1 has consumed this tile.
            sync_event<HardEvent::MTE1_MTE2>(EVENT_ID5);
            CrossCoreSetFlag<2,PIPE_FIX>(result_flag(slot));
            slot^=1u;
        }
    }
    WaitFlag<HardEvent::FIX_M>(EVENT_ID3);
}

__aicore__ inline void dispatch(GM_ADDR bindings,uint64_t rest,GM_ADDR partial,
    uint32_t product,uint32_t groups,GM_ADDR workspace) {
    const uint64_t tiles=(rest+511)/512;
    if ASCEND_IS_AIC {
        const uint32_t group=GetBlockIdx();
        if(group<groups && group<tiles) run_aic(workspace,tiles,groups,group);
    }
    if ASCEND_IS_AIV {
        const uint32_t group=GetBlockIdx()/2;
        if(group<groups && group<tiles)
            run_aiv(bindings,rest,partial,product,groups,workspace,group,GetSubBlockIdx());
    }
}
} // namespace

__global__ __mix__(1,2) __aicore__ void hp_sumcheck_tensor_message_d2_natural(
    GM_ADDR bindings,uint64_t rest,GM_ADDR partial,uint32_t product,uint32_t groups,
    GM_ADDR workspace) {
    InitSocState(); dispatch(bindings,rest,partial,product,groups,workspace);
    PipeBarrier<PIPE_ALL>();
}

namespace hyperplonk::ascend910b3::detail {
namespace {
bool resources_fit(uint32_t groups);
bool resources_available() {
    // First invoked by the workspace-size query during create, before rounds.
    static const bool available=resources_fit(sumcheck_tensor_max_groups);
    return available;
}
}
uint64_t sumcheck_tensor_workspace_bytes(uint32_t groups) {
    // Each group now owns two message-input slots, so the size query that the
    // unchanged Host uses at create time already yields the wider allocation.
    return groups && groups<=sumcheck_tensor_max_groups && resources_available()
        ? uint64_t(groups)*sumcheck_tensor_group_stride : 0;
}
namespace {
bool resources_fit(uint32_t groups) {
    const char* soc=aclrtGetSocName();
    if(!soc) return false;
    auto* platform=platform_ascendc::PlatformAscendCManager::GetInstance(soc);
    if(!platform || platform->GetCoreNumAic()<groups ||
       platform->GetCoreNumAiv()<2*groups) return false;
    using Mem=platform_ascendc::CoreMemType;
    uint64_t ub=0,l1=0,l0a=0,l0b=0,l0c=0;
    platform->GetCoreMemSize(Mem::UB,ub);platform->GetCoreMemSize(Mem::L1,l1);
    platform->GetCoreMemSize(Mem::L0_A,l0a);platform->GetCoreMemSize(Mem::L0_B,l0b);
    platform->GetCoreMemSize(Mem::L0_C,l0c);
    return ub>=sumcheck_tensor_ub_user_bytes+sumcheck_tensor_sdk_reserve_bytes &&
        l1>=sumcheck_tensor_l1_bytes && l0a>=sumcheck_tensor_l0a_bytes &&
        l0b>=sumcheck_tensor_l0b_bytes && l0c>=sumcheck_tensor_l0c_bytes;
}
bool geometry(aclrtStream stream,const uint64_t* bindings,uint64_t rest,
              Fr* partial,uint32_t groups,void* workspace) {
    if(!stream || !bindings || !partial || !workspace || !rest ||
       rest>UINT64_MAX/64 || !groups || groups>sumcheck_tensor_max_groups) return false;
    const uint64_t tiles=(rest+511)/512;
    if(groups!=(tiles<sumcheck_tensor_max_groups?tiles:sumcheck_tensor_max_groups))
        return false;
    return resources_available();
}
uint8_t* address(const void* p) {return reinterpret_cast<uint8_t*>(const_cast<void*>(p));}
}
bool launch_sumcheck_tensor_message_d2(aclrtStream stream,const uint64_t* bindings,
    uint64_t rest,Fr* partial,uint32_t product,uint32_t groups,void* workspace) {
    if(!geometry(stream,bindings,rest,partial,groups,workspace)) return false;
    hp_sumcheck_tensor_message_d2_natural<<<groups,nullptr,stream>>>(
        address(bindings),rest,address(partial),product,groups,address(workspace));
    return true;
}
} // namespace hyperplonk::ascend910b3::detail
