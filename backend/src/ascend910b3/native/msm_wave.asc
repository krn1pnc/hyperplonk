// Production whole-wave affine bucket reduction with long-chain batch inversion.
//
// ONE production device translation unit.  It owns the private controller
// G1WaveAffine<64> (UB staging on FieldVector::pipe_, six coordinate tensors,
// sixteen control rows and one DMA area), the wave metadata kernels and their
// six private launchers.  The point arithmetic is built directly on FieldVector
// primitives, which is why field_vector.h carries the single
// `template<uint32_t> friend class G1WaveAffine;` access grant.
//
// Numeric domain (frozen): normalized redundant Montgomery integers < 2p in the
// 32-row radix-12 domain.  Products use montgomery_redundant /
// montgomery_square_redundant, add/sub use add_mod_redundant / sub_mod_redundant
// with the cached packed-radix-24 2p table, and inversion is one
// inverse_montgomery per (block, sub-wave).  No Scalar field arithmetic: every
// Fq row operation is Vector; Scalar only touches ids, copy positions, bit masks
// and loop counters.
//
// Format separation (frozen): 96 B nodes and 192 B tuples are packed 32-bit
// Montgomery limbs; a 128 B D/N/P slot is one lane's 32 radix-12 digits.  The two
// formats never share a buffer: a node is unpacked before use and packed before
// store, a digit tile is only ever gathered to/from the lane-major form.

#include "msm_wave.h"

#include "field_vector.h"
#include "msm_internal.h"
#include "msm_device.h"

#include <type_traits>

using namespace hyperplonk::ascend910b3;
using namespace hyperplonk::ascend910b3::detail;
using hyperplonk::ascend910b3::detail::msm_device::Staging;

// ---------------------------------------------------------------------------
// Geometry and DMA helpers (public formulas; Scalar metadata only).  The wave
// constants, WaveControl/WaveDiag blocks and the arena contract come from
// msm_wave.h, so there is exactly one definition of each.
// ---------------------------------------------------------------------------
namespace hyperplonk::ascend910b3 {
namespace wave_detail {

__aicore__ inline uint32_t min_u32(uint32_t a, uint32_t b) { return a < b ? a : b; }
__aicore__ inline uint64_t min_u64(uint64_t a, uint64_t b) { return a < b ? a : b; }

// n_l = ceil(n0 / 2^l) ; m_l = floor(n_l / 2) ; cap = ceil(n0 / 2)
__aicore__ inline uint32_t nodes_at(uint64_t n0, uint32_t level) {
    const uint64_t step = uint64_t(1) << level;
    return static_cast<uint32_t>((n0 + step - 1) >> level);
}
__aicore__ inline uint32_t ops_at(uint64_t n0, uint32_t level) { return nodes_at(n0, level) >> 1; }
__aicore__ inline uint32_t cap_at(uint64_t n0) { return static_cast<uint32_t>((n0 + 1) >> 1); }
__aicore__ inline uint32_t depth_at(uint64_t n0) {
    uint32_t d = 0;
    while (n0 > 1) {
        n0 = (n0 + 1) >> 1;
        ++d;
    }
    return d;
}
// Carry rule (frozen): the unpaired last node is copied only while the bucket
// still has pairs, i.e. n_l odd, n_l >= 3 and l < depth(u,b).
__aicore__ inline bool carry_here(uint64_t n0, uint32_t level) {
    const uint32_t n = nodes_at(n0, level);
    return (n & 1u) != 0 && n >= 3u && level < depth_at(n0);
}

__aicore__ inline void gm_in(AscendC::LocalTensor<uint8_t> dst, GM_ADDR src, uint32_t bytes) {
    AscendC::GlobalTensor<uint8_t> gm;
    gm.SetGlobalBuffer(src);
    AscendC::DataCopyPad(dst, gm, AscendC::DataCopyExtParams{1, bytes, 0, 0, 0},
                         AscendC::DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
}
__aicore__ inline void gm_out(GM_ADDR dst, AscendC::LocalTensor<uint8_t> src, uint32_t bytes) {
    AscendC::GlobalTensor<uint8_t> gm;
    gm.SetGlobalBuffer(dst);
    AscendC::DataCopyPad(gm, src, AscendC::DataCopyExtParams{1, bytes, 0, 0, 0});
}

// Bounded grid-stride copy through one Staging instance.
template<uint32_t InBytes, uint32_t OutBytes>
__aicore__ inline void copy_range(Staging<InBytes, OutBytes>& io, GM_ADDR src, GM_ADDR dst,
                                  uint64_t bytes, uint32_t chunk) {
    if (bytes == 0) return;
    const uint32_t block = static_cast<uint32_t>(AscendC::GetBlockIdx());
    const uint64_t grid = static_cast<uint32_t>(AscendC::GetBlockNum());
    for (uint64_t first = uint64_t(block) * chunk; first < bytes; first += grid * chunk) {
        const uint32_t n = static_cast<uint32_t>(bytes - first < chunk ? bytes - first : chunk);
        auto in = io.read(src + first, n);
        auto out = io.alloc_output();
        AscendC::Adds(out.template ReinterpretCast<int32_t>(),
                      in.template ReinterpretCast<int32_t>(), int32_t(0), uint64_t(n / 4));
        // Order the copy before both the input-buffer reuse and the store.
        // Io is a dependent type here, so the member template needs the keyword.
        io.template sync<AscendC::HardEvent::V_MTE2>();
        io.template sync<AscendC::HardEvent::V_MTE3>();
        io.release(in);
        io.write(out, dst + first, n);
    }
}

}  // namespace wave_detail

// The wave contract is target-private but shared by the device TU; import the
// names it defines once, inside the device namespace.
using detail::msm_montgomery_one_words;
using detail::msm_wave_chain_granularity;
using detail::msm_wave_control_magic;
using detail::msm_wave_core_slots;
using detail::msm_wave_error_chain_over_l_max;
using detail::msm_wave_error_control_magic;
using detail::msm_wave_error_control_shape;
using detail::msm_wave_l_max;
using detail::msm_wave_level_slots;
using detail::msm_wave_slot_meta_bytes;
using detail::msm_wave_window_slots;
using detail::WaveControl;
using detail::WaveDiag;

// ---------------------------------------------------------------------------
// G1WaveAffine<64>: private staging controller.
//
// UB budget (196352 B incl. the 8192 B SDK planning reserve):
//   FieldVector<Fq,64,false> arena  [0,      118016)  production layout, unchanged
//   this controller stage           [118016, 183552)  65536 B on the SAME pipe
//     coordinate tensor i (i<6)     118016 + i*8192  (32 radix-12 rows x 64 lanes)
//     control row r (r<16)          167168 + r*256
//     DMA area                      171264 .. 183552 12288 B (2 x 64 x 96)
//   SDK planning reserve            [183552, 191744)  8192 B, never addressed
// Exactly one TPipe owner: a second TPipe would start its pool at UB 0 and
// overlay the field arena (the R29 finding ub_tpipe_owners == 1 still holds).
//
// Reserved regions inside the FieldVector arena (documented; no new UB):
//   FqV::raw_lhs   (25 rows) rows 0..23  AoS 96 B/lane staging for node stores
//   FqV::raw_rhs   (12 rows)             interleave index table, 768 entries
//   FqV::raw_out   (12 rows)             packed-limb -> SoA gather table (768)
//   FqV::raw_mask  ( 1 row)              unused by this controller
//   FqV::soa_lhs   (25 rows) rows 0..15  packed radix-24 2p table (16 rows)
//   FqV::soa_rhs   (12 rows)             packed-limb SoA staging (x / load)
//   FqV::soa_out   (12 rows)             packed-limb SoA staging (y)
//   FqV::offsets   (25 rows) rows 0..15  1024-entry transpose table (16 rows)
// None of them overlaps bank0..bank7, acc(), tmp0..15 or the modulus row.
//
// Bank assignment (frozen):
//   bank0 forward running prefix P / backward invD / backward lambda
//   bank1 chain inverse invP (one inverse_montgomery per block and sub-wave)
//   bank2 lambda^2 -> affine x3 intermediate, also the doubling scratch tile
//   bank3 Montgomery one R, immutable
//   bank4/bank5 backward staged P_(j-1) / D / N tiles; inverse_montgomery scratch
//   bank6 field engine scratch (nonzero workspace, add/sub modulus staging)
//   bank7 modulus digits, immutable; tmp15 radix-1 mask, immutable
// ---------------------------------------------------------------------------
template<uint32_t Lanes>
class G1WaveAffine {
public:
    static_assert(Lanes == 64, "the wave controller is fixed at 64 lanes");
    using FqV = FieldVector<Fq, Lanes, false>;
    using Params = FieldVectorParams<Fq::Parameters>;
    using I32 = AscendC::LocalTensor<int32_t>;
    using U32 = AscendC::LocalTensor<uint32_t>;
    using U64 = AscendC::LocalTensor<uint64_t>;
    using Bytes = AscendC::LocalTensor<uint8_t>;

    static constexpr uint32_t lanes = Lanes;
    static constexpr uint32_t digits = FqV::digits;                 // 32 radix-12 rows
    static constexpr uint32_t words = Fq::word_count;               // 12 packed limbs
    static constexpr uint32_t packed_digits = FqV::packed_digits;    // 16 radix-24 rows
    static constexpr uint32_t row_bytes = FqV::vector_bytes;        // 256
    static constexpr uint32_t coordinate_bytes = FqV::bank_bytes;   // 8192
    static constexpr uint32_t point_bytes = 96;
    static constexpr uint32_t lane_digits_bytes = digits * 4;       // 128 B D/N/P slot
    static constexpr uint32_t coordinate_count = 6;
    static constexpr uint32_t control_row_count = 16;
    static constexpr uint32_t dma_bytes = 2 * lanes * point_bytes;  // 12288
    static constexpr uint32_t control_base = coordinate_count * coordinate_bytes;
    static constexpr uint32_t dma_base = control_base + control_row_count * row_bytes;
    static constexpr uint32_t stage_bytes = dma_base + dma_bytes;
    static constexpr uint32_t sdk_reserve_bytes = 8192;
    static constexpr uint32_t ub_bytes = 196352;
    // Lane-major transpose scratch.  It must NOT live in coordinate slot 0: the
    // backward pass keeps x1 (coord 0) live across the prefix load, so a scratch
    // that aliased it would corrupt x3/y3.  The DMA area is dead once the
    // children have been unpacked (they are read into the scalars/tiles first),
    // and its 12288 B hold the 8192 B lane-major tile with room to spare.
    static constexpr uint32_t tile_stage = dma_base;

    static_assert(FqV::arena_bytes == 118016, "field arena layout changed");
    static_assert(row_bytes == 256 && FqV::row_stride == 8 && coordinate_bytes == 8192,
                  "coordinate staging must match one FieldVector digit bank");
    static_assert(digits == 32 && words == 12 && packed_digits == 16,
                  "unexpected Fq geometry for the wave controller");
    static_assert(lane_digits_bytes == 128, "a D/N/P slot must be 32 radix-12 digits");
    static_assert(dma_bytes == 2 * 64 * 96, "DMA staging must hold two 96 B point tiles");
    static_assert(control_base == 6 * 8192 && control_row_count * row_bytes == 4096 &&
                      dma_base == 53248,
                  "controller stage layout changed");
    static_assert(stage_bytes == 65536, "controller stage must be exactly 65536 B");
    static_assert(tile_stage == dma_base && tile_stage >= coordinate_count * coordinate_bytes &&
                      tile_stage + coordinate_bytes <= dma_base + dma_bytes &&
                      tile_stage + coordinate_bytes <= stage_bytes,
                  "transpose scratch must be the dead DMA area, never a coordinate slot");
    static_assert(FqV::arena_bytes + stage_bytes + sdk_reserve_bytes == 191744 &&
                      191744 <= ub_bytes,
                  "wave controller exceeds the 196352 B UB budget");
    static_assert(!std::is_same<FqV, FieldVector<Fq, Lanes, true>>::value,
                  "inverse_montgomery requires the non-compact field arena");

    // Control rows (one 64-lane int32 row each).  Every mask is produced by
    // Vector ops; Scalar writes only ids, offsets and the 0/1 lane-valid flag.
    static constexpr uint32_t row_work0 = 0;
    static constexpr uint32_t row_work1 = 1;
    static constexpr uint32_t row_tmp0 = 2;
    static constexpr uint32_t row_tmp1 = 3;
    static constexpr uint32_t row_id_a = 4;
    static constexpr uint32_t row_id_b = 5;
    static constexpr uint32_t row_eqx = 6;    // becomes opp
    static constexpr uint32_t row_eqy = 7;    // becomes both
    static constexpr uint32_t row_same = 8;
    static constexpr uint32_t row_pass_b = 9;
    static constexpr uint32_t row_pass_a = 10;
    static constexpr uint32_t row_valid = 11;
    static constexpr uint32_t row_finite = 12;
    static constexpr uint32_t row_identity = 13;
    static constexpr uint32_t row_tmp2 = 14;
    static constexpr uint32_t row_tmp3 = 15;

    // diag byte offsets of the per-block arrays owned by this controller.
    static constexpr uint32_t diag_inversion_offset =
        offsetof(WaveDiag, inversion_calls_per_block);
    static constexpr uint32_t diag_idle_offset = offsetof(WaveDiag, idle_lane_steps_per_block);

    __aicore__ inline G1WaveAffine() {
        fq_.pipe_.InitBuffer(stage_, stage_bytes);
        stage_memory_ = stage_.template Get<uint8_t>();
        // Cached packed radix-24 double modulus (16 rows) used by the redundant
        // add/sub primitives; the prepared cache holds normalized values < 2p.
        for (uint32_t j = 0; j < packed_digits; ++j)
            fq_.fill(fq_.digit(packed_two_p(), j), FqV::packed_double_modulus.values[j]);
        // Montgomery representation of one, immutable for the whole launch.
        for (uint32_t j = 0; j < digits; ++j)
            fq_.fill(fq_.digit(one(), j), Params::r_digits[j]);
        build_load_table();
        build_interleave_table();
        build_forward_transpose_table();
    }

    // ---- per-level point kernel -------------------------------------------
    // One (block, sub-wave) of one level: forward prefix chain, exactly one
    // 64-lane inversion, backward substitution, 96 B node stores.
    template<bool Level0>
    __aicore__ inline void level(GM_ADDR cache, GM_ADDR records, GM_ADDR op_src, GM_ADDR op_dst,
                                 GM_ADDR src_nodes, GM_ADDR dst_nodes, GM_ADDR prefixes,
                                 GM_ADDR control, GM_ADDR diag, uint32_t fuse_windows,
                                 uint32_t level_index, uint32_t subwave,
                                 uint32_t chain_granularity, uint32_t l_max) {
        const uint32_t block = static_cast<uint32_t>(AscendC::GetBlockIdx());
        const uint32_t grid = static_cast<uint32_t>(AscendC::GetBlockNum());
        uint32_t head[44];
        read_words(head, control, 176);
        if (head[0] != uint32_t(msm_wave_control_magic) ||
            head[1] != uint32_t(uint64_t(msm_wave_control_magic) >> 32)) {
            store_word(control + offsetof(WaveControl, status), msm_wave_error_control_magic);
            return;
        }
        if (head[6] != fuse_windows || level_index >= msm_wave_level_slots || l_max != head[7] ||
            chain_granularity == 0) {
            if (block == 0) {
                store_word(control + offsetof(WaveControl, status),
                           msm_wave_error_control_shape);
                store_word(control + offsetof(WaveControl, status_detail), level_index);
            }
            return;
        }
        if (level_index >= head[8]) return;  // device depth gate: finished wave
        const uint64_t ops_total = head[16 + level_index];
        const uint64_t chunk = uint64_t(grid) * lanes * l_max;
        const uint64_t begin = uint64_t(subwave) * chunk;
        if (ops_total == 0 || begin >= ops_total) return;  // sub-wave self-gate
        const uint64_t ops_s = wave_detail::min_u64(ops_total - begin, chunk);
        // chains_s = clamp(ceil(ops_s / L_MIN), 1, min(lanes_total, ops_s))
        uint64_t chains = (ops_s + chain_granularity - 1) / chain_granularity;
        const uint64_t lanes_total = uint64_t(grid) * lanes;
        chains = wave_detail::min_u64(chains, lanes_total);
        chains = wave_detail::min_u64(chains, ops_s);
        if (chains == 0) return;
        const uint64_t base = ops_s / chains;
        const uint64_t rem = ops_s % chains;
        if (block == 0 && subwave == 0) {
            // Device-derived chain geometry of this level (no host read, no atomics).
            const uint64_t subwaves = (ops_total + chunk - 1) / chunk;
            store_word(diag + offsetof(WaveDiag, processed_ops_per_level) + 4 * level_index,
                       static_cast<uint32_t>(ops_total));
            store_word(diag + offsetof(WaveDiag, blocks_used_per_level) + 4 * level_index,
                       static_cast<uint32_t>((chains + 63) / 64));
            store_word(diag + offsetof(WaveDiag, subwaves_per_level) + 4 * level_index,
                       static_cast<uint32_t>(subwaves));
            store_word(diag + offsetof(WaveDiag, chains_per_level) + 4 * level_index,
                       static_cast<uint32_t>(chains));
        }
        const uint32_t lane_base = block * lanes;
        if (uint64_t(lane_base) >= chains) return;  // no chain: no inversion
        // Cyclic assignment: the op visited by (step j, chain c) is
        // begin + j*chains + c, so the live lanes of a step are always the
        // leading contiguous prefix [0, nvalid) of the block and every per-step
        // transfer (descriptors and prefix) is one contiguous DMA.
        begin_ = begin;
        current_chains_ = static_cast<uint32_t>(chains);
        uint64_t max_steps = 0;
        for (uint32_t l = 0; l < lanes; ++l) {
            const uint64_t c = uint64_t(lane_base) + l;
            count_[l] = c < chains ? static_cast<uint32_t>(base + (c < rem ? 1 : 0)) : 0u;
            if (count_[l] > max_steps) max_steps = count_[l];
        }
        if (max_steps > l_max) {
            store_word(control + offsetof(WaveControl, status),
                       msm_wave_error_chain_over_l_max);
            store_word(control + offsetof(WaveControl, status_detail), level_index);
            return;
        }
        uint64_t idle_steps = 0;
        for (uint32_t l = 0; l < lanes; ++l)
            idle_steps += max_steps > count_[l] ? max_steps - count_[l] : 0;

        // Forward: P_j = P_(j-1) * D_j with P_(-1) = R; the chain product can
        // never be zero because every effective D is clamped to 1.
        copy_field(fq_.template bank<0>(), one());
        build_forward_transpose_table();
        for (uint64_t j = 0; j < max_steps; ++j)
            forward_step<Level0>(cache, records, op_src, op_dst, src_nodes, prefixes, j);
        // Exactly one 64-lane inversion per block and sub-wave.
        fq_.inverse_montgomery(fq_.template bank<1>(), fq_.template bank<0>());
        // Per-block diagnostics accumulate across levels and sub-waves; each slot
        // is owned by one block, so no cross-core ordering is involved.
        add_word(diag + diag_inversion_offset + block * 4, 1u);
        add_word(diag + diag_idle_offset + block * 4, static_cast<uint32_t>(idle_steps));
        build_reverse_transpose_table();
        for (uint64_t j = max_steps; j-- > 0;)
            backward_step<Level0>(cache, records, op_src, op_dst, src_nodes, dst_nodes,
                                  prefixes, j);
    }

private:
    FqV fq_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> stage_;
    Bytes stage_memory_;
    uint64_t begin_{0};  // subwave op-stream origin (cyclic index base)
    uint32_t count_[lanes]{};
    uint32_t src_[lanes]{};
    uint32_t dst_[lanes]{};
    uint32_t pid1_[lanes]{};
    uint32_t pid2_[lanes]{};

    // ---- stage accessors ---------------------------------------------------
    __aicore__ inline Bytes stage(uint32_t offset) { return stage_memory_[offset]; }
    __aicore__ inline I32 stage_i32(uint32_t offset) {
        return stage_memory_[offset].template ReinterpretCast<int32_t>();
    }
    __aicore__ inline U32 stage_u32(uint32_t offset) {
        return stage_memory_[offset].template ReinterpretCast<uint32_t>();
    }
    __aicore__ inline I32 coord(uint32_t index) { return stage_i32(index * coordinate_bytes); }
    __aicore__ inline I32 ctrl(uint32_t r) { return stage_i32(control_base + r * row_bytes); }
    __aicore__ inline I32 row(uint32_t r) { return ctrl(r); }
    __aicore__ inline Bytes dma(uint32_t offset) { return stage_memory_[dma_base + offset]; }
    __aicore__ inline U32 dma_u32() { return stage_u32(dma_base); }
    // ---- reserved regions inside the FieldVector arena ---------------------
    __aicore__ inline I32 packed_two_p() { return fq_.i32(FqV::soa_lhs); }
    __aicore__ inline U32 transpose_table() { return fq_.u32(FqV::offsets); }
    __aicore__ inline U32 load_table() { return fq_.u32(FqV::raw_out); }
    __aicore__ inline U32 interleave_table() { return fq_.u32(FqV::raw_rhs); }
    __aicore__ inline U32 interleave_out() { return fq_.u32(FqV::raw_lhs); }
    __aicore__ inline Bytes interleave_bytes() { return fq_.bytes(FqV::raw_lhs); }
    __aicore__ inline I32 pack_x() { return fq_.i32(FqV::soa_rhs); }
    __aicore__ inline I32 pack_y() { return fq_.i32(FqV::soa_out); }
    __aicore__ inline U32 pack_soa() { return fq_.u32(FqV::soa_rhs); }
    __aicore__ inline I32 one() { return fq_.template bank<3>(); }

    template<AscendC::HardEvent event>
    __aicore__ inline void sync() { fq_.template sync<event>(); }
    __aicore__ inline void barrier() { fq_.vector_barrier(); }

    // ---- immutable Scalar tables (built once per core) ---------------------
    __aicore__ inline void build_load_table() {
        sync<AscendC::HardEvent::V_S>();
        auto table = load_table();
        for (uint32_t r = 0; r < words; ++r)
            for (uint32_t lane = 0; lane < lanes; ++lane)
                table.SetValue(r * lanes + lane, lane * point_bytes + r * 4);
        sync<AscendC::HardEvent::S_V>();
    }
    __aicore__ inline void build_interleave_table() {
        sync<AscendC::HardEvent::V_S>();
        auto table = interleave_table();
        for (uint32_t lane = 0; lane < lanes / 2; ++lane)
            for (uint32_t c = 0; c < 2; ++c)
                for (uint32_t w = 0; w < words; ++w)
                    table.SetValue(lane * 2 * words + c * words + w,
                                   (c * words + w) * row_bytes + lane * 4);
        sync<AscendC::HardEvent::S_V>();
    }
    // Digit tile (32 rows x 64 lanes) -> 64 consecutive 128 B lane blocks.
    __aicore__ inline void build_forward_transpose_table() {
        sync<AscendC::HardEvent::V_S>();
        auto table = transpose_table();
        for (uint32_t e = 0; e < 1024; ++e) {
            const uint32_t lane = e / digits;
            const uint32_t digit = e % digits;
            table.SetValue(e, (digit * lanes + lane) * 4);
        }
        sync<AscendC::HardEvent::S_V>();
    }
    // 64 consecutive 128 B lane blocks -> digit tile (16 digits per gather).
    __aicore__ inline void build_reverse_transpose_table() {
        sync<AscendC::HardEvent::V_S>();
        auto table = transpose_table();
        for (uint32_t e = 0; e < 1024; ++e) {
            const uint32_t digit = e / lanes;
            const uint32_t lane = e % lanes;
            table.SetValue(e, (lane * digits + digit) * 4);
        }
        sync<AscendC::HardEvent::S_V>();
    }

    // ---- field primitives (existing FieldVector math only) -----------------
    __aicore__ inline void field_add(I32 dst, I32 a, I32 b) {
        fq_.add_mod_redundant(dst, a, b, packed_two_p());
    }
    __aicore__ inline void field_sub(I32 dst, I32 a, I32 b) {
        fq_.sub_mod_redundant(dst, a, b, packed_two_p());
    }
    __aicore__ inline void field_mul(I32 dst, I32 a, I32 b) {
        fq_.montgomery_redundant(dst, a, b);
    }
    __aicore__ inline void field_square(I32 dst, I32 a) {
        fq_.montgomery_square_redundant(dst, a);
    }
    __aicore__ inline void copy_field(I32 dst, I32 src) {
        for (uint32_t j = 0; j < digits; ++j)
            fq_.copy(fq_.digit(dst, j), fq_.digit(src, j));
    }
    __aicore__ inline void sum_digit_rows(I32 workspace, I32 field) {
        uint32_t half = (digits + 1) / 2;
        AscendC::Add(workspace, field, fq_.digit(field, half), uint64_t(lanes),
                     uint8_t(digits - half),
                     AscendC::BinaryRepeatParams{1, 1, 1, FqV::row_stride, FqV::row_stride,
                                                 FqV::row_stride});
        barrier();
        if constexpr (digits % 2 != 0)
            fq_.adds(fq_.digit(workspace, half - 1), fq_.digit(field, half - 1), 0);
        for (uint32_t active = half; active > 1; active = half) {
            half = (active + 1) / 2;
            AscendC::Add(workspace, workspace, fq_.digit(workspace, half), uint64_t(lanes),
                         uint8_t(active - half),
                         AscendC::BinaryRepeatParams{1, 1, 1, FqV::row_stride, FqV::row_stride,
                                                     FqV::row_stride});
            barrier();
        }
    }
    // Exact 0/1 "field != 0 mod p": zero has exactly the representatives 0 and p
    // in [0,2p).  bank6 is the engine scratch workspace, tmp12 the first mask;
    // neither is live across a step boundary.
    // Every helper below names its mask operands by ROW INDEX (the row_* integers
    // above are offsets into the 16-row / 4096 B control allotment, never
    // tensors) and converts exactly once here through ctrl().  Tensor operands
    // keep the I32 type, so index and tensor can never be confused again.
    __aicore__ inline void mask_nonzero(uint32_t dst_row, I32 field) {
        I32 dst = ctrl(dst_row);
        auto workspace = fq_.template bank<6>();
        sum_digit_rows(workspace, field);
        fq_.adds(fq_.tmp(12), workspace, 1048575);
        fq_.shift_right(fq_.tmp(12), fq_.tmp(12), 20);
        fq_.subtract_rows(workspace, field, fq_.template bank<7>());
        fq_.multiply_rows(workspace, workspace, workspace, false);
        sum_digit_rows(workspace, workspace);
        fq_.adds(workspace, workspace, 536870911);
        fq_.shift_right(workspace, workspace, 29);
        fq_.mul(dst, fq_.tmp(12), workspace);
    }
    __aicore__ inline void mask_not(uint32_t dst_row, uint32_t src_row) {
        I32 dst = ctrl(dst_row);
        I32 src = ctrl(src_row);
        fq_.muls(dst, src, int32_t(-1));
        fq_.adds(dst, dst, int32_t(1));
    }
    __aicore__ inline void mask_zero(uint32_t dst_row, I32 field) {
        mask_nonzero(dst_row, field);
        mask_not(dst_row, dst_row);
    }
    __aicore__ inline void mask_or(uint32_t dst_row, uint32_t a_row, uint32_t b_row,
                                   uint32_t scratch_row) {
        I32 dst = ctrl(dst_row);
        I32 a = ctrl(a_row);
        I32 b = ctrl(b_row);
        I32 scratch = ctrl(scratch_row);
        fq_.mul(scratch, a, b);
        fq_.add(dst, a, b);
        fq_.sub(dst, dst, scratch);
    }
    // Mask-row arithmetic keeps the same index convention (the operands are the
    // finalized 0/1 control rows above; the arithmetic is a plain product/sum).
    __aicore__ inline void row_mul(uint32_t dst_row, uint32_t a_row, uint32_t b_row) {
        fq_.mul(ctrl(dst_row), ctrl(a_row), ctrl(b_row));
    }
    __aicore__ inline void clear_where(I32 dst, uint32_t keep_row) {
        fq_.multiply_rows(dst, dst, ctrl(keep_row), true);
    }
    __aicore__ inline void select_field(I32 dst, I32 yes, uint32_t mask_row, I32 scratch) {
        fq_.subtract_rows(scratch, yes, dst);
        fq_.multiply_rows(scratch, scratch, ctrl(mask_row), true);
        fq_.add_rows(dst, dst, scratch);
    }
    // Exact tile vote on a finalized 0/1 mask row (data dependent, not constant
    // time; same shape as the production any_same_vote).
    __aicore__ inline bool any_set(uint32_t mask_row_index) {
        I32 mask_row = ctrl(mask_row_index);
        auto aggregate = fq_.tmp(11);
        const AscendC::BinaryRepeatParams strides{1, 1, 1, FqV::row_stride, FqV::row_stride,
                                                  FqV::row_stride};
        AscendC::Add<int32_t, true>(aggregate, mask_row, mask_row[16], uint64_t(16), uint8_t(1),
                                    strides);
        barrier();
        for (uint32_t first = 32; first < lanes; first += 16) {
            AscendC::Add<int32_t, true>(aggregate, aggregate, mask_row[first], uint64_t(16),
                                        uint8_t(1), strides);
            barrier();
        }
        AscendC::Add<int32_t, true>(aggregate, aggregate, aggregate[8], uint64_t(8), uint8_t(1),
                                    strides);
        barrier();
        sync<AscendC::HardEvent::V_S>();
        uint32_t total = 0;
        for (uint32_t i = 0; i < 8; ++i) total |= uint32_t(aggregate.GetValue(i));
        sync<AscendC::HardEvent::S_V>();
        return total != 0;
    }

    // ---- HBM helpers -------------------------------------------------------
    __aicore__ inline void read_words(uint32_t* out, GM_ADDR src, uint32_t bytes) {
        sync<AscendC::HardEvent::MTE3_V>();
        sync<AscendC::HardEvent::V_MTE2>();
        wave_detail::gm_in(dma(0), src, bytes);
        sync<AscendC::HardEvent::MTE2_S>();
        auto values = dma_u32();
        for (uint32_t i = 0; i < bytes / 4; ++i) out[i] = values.GetValue(i);
        sync<AscendC::HardEvent::S_MTE2>();
    }
    __aicore__ inline void store_word(GM_ADDR dst, uint32_t value) {
        sync<AscendC::HardEvent::MTE3_V>();
        sync<AscendC::HardEvent::V_S>();
        dma_u32().SetValue(0, value);
        sync<AscendC::HardEvent::S_MTE3>();
        wave_detail::gm_out(dst, dma(0), 4);
        sync<AscendC::HardEvent::MTE3_V>();
    }
    // Single-owner 4 B accumulate.  Every slot has exactly one writer (its own
    // block) across stream-ordered launches, so the read-modify-write needs no
    // inter-core coordination; each level/sub-wave of that block adds to it.
    __aicore__ inline void add_word(GM_ADDR dst, uint32_t value) {
        sync<AscendC::HardEvent::MTE3_V>();
        sync<AscendC::HardEvent::V_MTE2>();
        wave_detail::gm_in(dma(0), dst, 4);
        sync<AscendC::HardEvent::MTE2_S>();
        const uint32_t current = dma_u32().GetValue(0);
        sync<AscendC::HardEvent::S_MTE2>();
        store_word(dst, current + value);
    }
    // One coordinate of a packed-limb record at `base` + `record_offset`.
    __aicore__ inline void unpack_coordinate(I32 dst, uint32_t record_offset) {
        const uint32_t base = dma_base;
        AscendC::Gather(fq_.u32(FqV::soa_rhs), stage_u32(base), load_table(), record_offset,
                        words * lanes);
        barrier();
        fq_.unpack(dst, fq_.u32(FqV::soa_rhs));
    }
    // 32 radix-12 rows of tile -> 64 lane-major 128 B blocks at dst_slot.
    __aicore__ inline void transpose_to_lanes(I32 tile, uint32_t dst_slot) {
        auto source = tile.template ReinterpretCast<uint32_t>();
        for (uint32_t chunk = 0; chunk < 2; ++chunk)
            AscendC::Gather(stage_u32(dst_slot + chunk * 4096), source, transpose_table(),
                            chunk * (lanes / 2) * 4, 1024);
        barrier();
    }
    // 64 lane-major 128 B blocks at src_slot -> 32 radix-12 rows of dst.
    __aicore__ inline void transpose_from_lanes(uint32_t src_slot, I32 dst) {
        auto target = dst.template ReinterpretCast<uint32_t>();
        for (uint32_t chunk = 0; chunk < 2; ++chunk)
            AscendC::Gather(target[chunk * 1024], stage_u32(src_slot), transpose_table(),
                            chunk * 16 * 4, 1024);
        barrier();
    }
    // Number of leading lanes of this block that have a work step at the current
    // step index.  Counts are non-increasing in the chain index, so the valid
    // lanes are always the contiguous prefix [0, nvalid).
    __aicore__ inline uint32_t step_valid() const {
        uint32_t n = 0;
        for (uint32_t l = 0; l < lanes; ++l)
            if (current_step_ < count_[l]) ++n;
        return n;
    }
    // Step-major prefix: P_j of this block's lanes sits at (j*C + c0)*128, so one
    // contiguous DMA covers the whole valid prefix (<= 8192 B) instead of 64
    // 128 B copies with a (l_max-1)*128 byte GM stride.
    __aicore__ inline void store_prefix(GM_ADDR base, uint32_t c0, uint64_t j) {
        sync<AscendC::HardEvent::MTE3_V>();
        transpose_to_lanes(fq_.template bank<0>(), tile_stage);
        sync<AscendC::HardEvent::V_MTE3>();
        const uint32_t nvalid = step_valid();
        if (nvalid != 0)
            wave_detail::gm_out(base + (uint64_t(j) * current_chains_ + c0) * lane_digits_bytes,
                                stage(tile_stage), nvalid * lane_digits_bytes);
        sync<AscendC::HardEvent::MTE3_V>();
    }
    __aicore__ inline void load_prefix(GM_ADDR base, uint32_t c0, uint64_t j, I32 tile) {
        sync<AscendC::HardEvent::MTE3_V>();
        sync<AscendC::HardEvent::V_MTE2>();
        const uint32_t nvalid = step_valid();
        if (nvalid != 0)
            wave_detail::gm_in(stage(tile_stage),
                               base + (uint64_t(j) * current_chains_ + c0) * lane_digits_bytes,
                               nvalid * lane_digits_bytes);
        sync<AscendC::HardEvent::MTE2_V>();
        transpose_from_lanes(tile_stage, tile);
        sync<AscendC::HardEvent::V_MTE2>();
    }

    // ---- per-step descriptor traffic (cyclic, coalesced) -------------------
    // A step visits op_src/op_dst[begin + j*C + c0 + c] for the valid chain
    // prefix c < nvalid, so both descriptor arrays are contiguous per step: one
    // DataCopyPad each (nvalid*4 <= 256 B) instead of 64 single-word gathers.
    __aicore__ inline void load_descriptors_step(GM_ADDR op_src, GM_ADDR op_dst, uint64_t j) {
        sync<AscendC::HardEvent::MTE3_V>();
        sync<AscendC::HardEvent::V_MTE2>();
        const uint32_t c0 = static_cast<uint32_t>(AscendC::GetBlockIdx()) * lanes;
        const uint32_t nvalid = step_valid();
        if (nvalid != 0) {
            wave_detail::gm_in(dma(0), op_src + (begin_ + j * current_chains_ + c0) * 4,
                               4 * nvalid);
            wave_detail::gm_in(dma(256), op_dst + (begin_ + j * current_chains_ + c0) * 4,
                               4 * nvalid);
        }
        sync<AscendC::HardEvent::MTE2_S>();
        const auto src_words = dma_u32();
        const auto dst_words = stage_u32(dma_base + 256);
        for (uint32_t l = 0; l < lanes; ++l) {
            src_[l] = l < nvalid ? src_words.GetValue(l) : 0u;
            dst_[l] = l < nvalid ? dst_words.GetValue(l) : 0u;
        }
        sync<AscendC::HardEvent::S_MTE2>();
    }
    // Level 0 sources are records {u32 digit, u32 point_id}; the sibling record
    // follows.  Read the pair per lane, then the two 96 B SRS points.
    __aicore__ inline void load_children_level0(GM_ADDR cache, GM_ADDR records) {
        for (uint32_t l = 0; l < lanes; ++l)
            if (j_valid(l)) wave_detail::gm_in(dma(l * 32), records + uint64_t(src_[l]) * 8, 16);
        sync<AscendC::HardEvent::MTE2_S>();
        for (uint32_t l = 0; l < lanes; ++l) {
            if (!j_valid(l)) continue;
            pid1_[l] = dma_u32().GetValue(l * 8 + 1);
            pid2_[l] = dma_u32().GetValue(l * 8 + 3);
        }
        sync<AscendC::HardEvent::S_MTE2>();
        for (uint32_t l = 0; l < lanes; ++l) {
            if (!j_valid(l)) continue;
            wave_detail::gm_in(dma(l * point_bytes), cache + uint64_t(pid1_[l]) * point_bytes,
                               point_bytes);
            wave_detail::gm_in(dma(lanes * point_bytes + l * point_bytes),
                               cache + uint64_t(pid2_[l]) * point_bytes, point_bytes);
        }
        sync<AscendC::HardEvent::MTE2_V>();
    }
    // Level >= 1 sources are 96 B nodes; the sibling is the next node index.
    __aicore__ inline void load_children_nodes(GM_ADDR src_nodes) {
        for (uint32_t l = 0; l < lanes; ++l) {
            if (!j_valid(l)) continue;
            wave_detail::gm_in(dma(l * point_bytes), src_nodes + uint64_t(src_[l]) * point_bytes,
                               point_bytes);
            wave_detail::gm_in(dma(lanes * point_bytes + l * point_bytes),
                               src_nodes + uint64_t(src_[l] + 1) * point_bytes, point_bytes);
        }
        sync<AscendC::HardEvent::MTE2_V>();
    }
    __aicore__ inline bool j_valid(uint32_t lane) const {
        return current_step_ < count_[lane];
    }
    __aicore__ inline void unpack_children() {
        unpack_coordinate(coord(0), 0);
        unpack_coordinate(coord(1), words * 4);
        unpack_coordinate(coord(2), lanes * point_bytes);
        unpack_coordinate(coord(3), lanes * point_bytes + words * 4);
    }
    // Packs x,y into 96 B AoS per lane and stores one node per lane.
    __aicore__ inline void store_nodes(I32 x, I32 y, GM_ADDR dst_nodes) {
        fq_.pack_words(pack_x(), x);
        fq_.pack_words(pack_y(), y);
        barrier();
        for (uint32_t chunk = 0; chunk < 2; ++chunk)
            AscendC::Gather(interleave_out()[chunk * 768], pack_soa(), interleave_table(),
                            chunk * (lanes / 2) * 4, 768);
        barrier();
        sync<AscendC::HardEvent::V_MTE3>();
        for (uint32_t l = 0; l < lanes; ++l)
            if (j_valid(l))
                wave_detail::gm_out(dst_nodes + uint64_t(dst_[l]) * point_bytes,
                                    interleave_bytes()[l * point_bytes], point_bytes);
        sync<AscendC::HardEvent::MTE3_V>();
    }

    // ---- shared D/N preparation -------------------------------------------
    // Both directions load the same immutable children (level-0 records or the
    // previous level's nodes, read-only for the whole level), rebuild the exact
    // mask set and the effective denominator/numerator.  Coordinates 0..3 are
    // raw inputs of the backward formula and MUST survive, so every intermediate
    // goes to scratch banks 2/4/5; bank0 (forward P / backward invD), bank1
    // (backward invP) and bank3 (cached one) are never touched here.
    template<bool Level0>
    __aicore__ inline void prepare_pair(GM_ADDR cache, GM_ADDR records, GM_ADDR src_nodes,
                                        uint64_t j) {
        current_step_ = j;
        sync<AscendC::HardEvent::V_S>();
        for (uint32_t l = 0; l < lanes; ++l) row(row_valid).SetValue(l, j < count_[l] ? 1 : 0);
        sync<AscendC::HardEvent::S_V>();
        if constexpr (Level0) {
            load_children_level0(cache, records);
        } else {
            load_children_nodes(src_nodes);
        }
        unpack_children();
        // Masks (frozen order): identity predicates, dx/dy, equal/opposite.
        mask_nonzero(row_work0, coord(0));
        mask_nonzero(row_work1, coord(1));
        mask_or(row_tmp0, row_work0, row_work1, row_tmp1);
        mask_not(row_id_a, row_tmp0);
        mask_nonzero(row_work0, coord(2));
        mask_nonzero(row_work1, coord(3));
        mask_or(row_tmp0, row_work0, row_work1, row_tmp1);
        mask_not(row_id_b, row_tmp0);
        field_sub(coord(4), coord(2), coord(0));  // dx
        field_sub(coord(5), coord(3), coord(1));  // dy
        mask_zero(row_eqx, coord(4));
        mask_zero(row_eqy, coord(5));
        row_mul(row_same, row_eqx, row_eqy);
        mask_not(row_tmp0, row_id_b);
        row_mul(row_pass_b, row_id_a, row_tmp0);  // lhs identity, rhs finite
        mask_not(row_tmp0, row_id_a);
        row_mul(row_pass_a, row_id_b, row_tmp0);  // rhs identity, lhs finite
        // The doubling vote must ignore padding lanes: an invalid lane keeps the
        // previous tile and may look like a same-lane pair, which would only burn
        // whole-tile squares.  Data dependent, not constant time, not a security
        // property here.
        row_mul(row_same, row_same, row_valid);
        if (any_set(row_same)) {
            // Doubling: lambda = 3*x1^2 / (2*y1).  Scratch banks only.
            field_square(fq_.template bank<2>(), coord(0));                // x1^2
            field_add(fq_.template bank<4>(), coord(1), coord(1));         // 2*y1
            copy_field(fq_.template bank<5>(), fq_.template bank<2>());    // x1^2 copy
            field_add(fq_.template bank<2>(), fq_.template bank<2>(), fq_.template bank<5>());
            field_add(fq_.template bank<2>(), fq_.template bank<2>(), fq_.template bank<5>());
            select_field(coord(4), fq_.template bank<4>(), row_same, fq_.template bank<5>());
            select_field(coord(5), fq_.template bank<2>(), row_same, fq_.template bank<5>());
        }
        // opp = eqx & !eqy & !id_a & !id_b ; both = id_a & id_b
        mask_or(row_tmp0, row_id_a, row_id_b, row_tmp1);
        mask_not(row_tmp2, row_tmp0);
        mask_not(row_tmp1, row_eqy);
        row_mul(row_tmp3, row_eqx, row_tmp1);
        row_mul(row_eqx, row_tmp3, row_tmp2);            // opp (row_eqx reused)
        row_mul(row_eqy, row_id_a, row_id_b);            // both (row_eqy reused)
        mask_or(row_tmp0, row_pass_b, row_pass_a, row_tmp1);
        mask_or(row_tmp0, row_tmp0, row_eqy, row_tmp1);
        mask_or(row_tmp0, row_tmp0, row_eqx, row_tmp1);
        mask_zero(row_tmp1, coord(4));                   // guard: effective D == 0
        mask_or(row_identity, row_tmp0, row_tmp1, row_tmp3);
        mask_not(row_finite, row_identity);
        // Identity/pass/opposite/guard override: D := R (= 1), N := 0.
        select_field(coord(4), one(), row_identity, fq_.template bank<5>());
        clear_where(coord(5), row_finite);
        // Padding lanes (any j >= count, a shorter live chain included) get the
        // same D = 1, N = 0 clamp in BOTH directions, so the backward inverse
        // prefix advances through padding unchanged and stays exact.
        mask_not(row_tmp0, row_valid);
        select_field(coord(4), one(), row_tmp0, fq_.template bank<5>());
        clear_where(coord(5), row_valid);
    }

    // ---- forward -----------------------------------------------------------
    template<bool Level0>
    __aicore__ inline void forward_step(GM_ADDR cache, GM_ADDR records, GM_ADDR op_src,
                                        GM_ADDR op_dst, GM_ADDR src_nodes, GM_ADDR prefixes,
                                        uint64_t j) {
        current_step_ = j;
        const uint32_t c0 = static_cast<uint32_t>(AscendC::GetBlockIdx()) * lanes;
        load_descriptors_step(op_src, op_dst, j);
        prepare_pair<Level0>(cache, records, src_nodes, j);
        // Extend the chain: P_j = P_(j-1) * D_j (D = R on every padded lane), then
        // materialise only the prefix.
        field_mul(fq_.template bank<0>(), fq_.template bank<0>(), coord(4));
        store_prefix(prefixes, c0, j);
    }

    // ---- backward ----------------------------------------------------------
    template<bool Level0>
    __aicore__ inline void backward_step(GM_ADDR cache, GM_ADDR records, GM_ADDR op_src,
                                         GM_ADDR op_dst, GM_ADDR src_nodes, GM_ADDR dst_nodes,
                                         GM_ADDR prefixes, uint64_t j) {
        current_step_ = j;
        const uint32_t c0 = static_cast<uint32_t>(AscendC::GetBlockIdx()) * lanes;
        load_descriptors_step(op_src, op_dst, j);
        // The children are re-read here anyway for the final x/y: they also
        // rebuild D, N and the masks, so no denominator/numerator/mask state has
        // to live in HBM.  Padded lanes already carry the D = R clamp.
        prepare_pair<Level0>(cache, records, src_nodes, j);
        // bank4 = P_(j-1) (R at j == 0), then invD into bank0.
        if (j == 0) {
            copy_field(fq_.template bank<4>(), one());
        } else {
            load_prefix(prefixes, c0, j - 1, fq_.template bank<4>());
        }
        field_mul(fq_.template bank<0>(), fq_.template bank<1>(), fq_.template bank<4>());  // invD
        field_mul(fq_.template bank<1>(), fq_.template bank<1>(), coord(4));                // invP
        field_mul(fq_.template bank<0>(), fq_.template bank<0>(), coord(5));                // lambda
        // x3 = lambda^2 - x1 - x2 ; y3 = lambda*(x1 - x3) - y1
        field_square(fq_.template bank<2>(), fq_.template bank<0>());
        field_sub(coord(4), fq_.template bank<2>(), coord(0));
        field_sub(coord(4), coord(4), coord(2));
        field_sub(coord(5), coord(0), coord(4));
        field_mul(coord(5), coord(5), fq_.template bank<0>());
        field_sub(coord(5), coord(5), coord(1));
        // Exact re-selection (frozen order): clear where identity, then pass_b,
        // then pass_a; finite lanes keep the formula because the sets partition.
        clear_where(coord(4), row_finite);
        clear_where(coord(5), row_finite);
        select_field(coord(4), coord(2), row_pass_b, fq_.template bank<4>());
        select_field(coord(5), coord(3), row_pass_b, fq_.template bank<4>());
        select_field(coord(4), coord(0), row_pass_a, fq_.template bank<4>());
        select_field(coord(5), coord(1), row_pass_a, fq_.template bank<4>());
        store_nodes(coord(4), coord(5), dst_nodes);
    }

    uint64_t current_step_{0};
    uint32_t current_chains_{1};
};

// ---------------------------------------------------------------------------
// Metadata kernels (no field engine: one Staging pipe each).
//
// Control byte offsets used below (mirrored by the host in msm_wave.h):
//   0 magic(u64) 8 count 12 window_bits 16 windows 20 buckets 24 fuse_windows
//   28 l_max 32 depth_max 36 chain_granularity 40 node_count(u64) 48 processed_ops
//   52 finalized_buckets 56 status 60 status_detail 64 ops[26] 168 parity[32]
//   296 window_records[32] 424 window_node_count[32] 552 block_ops[40]
// Diag byte offsets: 0 inversion_calls[40] 160 idle_lane_steps[40]
//   320 finalized[40] 960 error[40] 1120 processed_ops_per_level[26]
//   1224 blocks_used_per_level[26] 1328 subwaves_per_level[26]
//   1432 chains_per_level[26] 1536 node_count_per_window[32]
// ---------------------------------------------------------------------------
namespace {
constexpr uint32_t kPointBytes = 96;
constexpr uint32_t kTupleBytes = 192;
}  // namespace

namespace {
// Canonical projective identity tuple: X = 0, Y = Montgomery R (word 12), Z = 0,
// padding = 0 -- byte-identical to production hp_msm_empty_window.  Bucket 0 has
// coefficient zero in the MSM weighting, so this is the value every window
// publishes for it.  Reuses the caller's Staging output queue: Vector fill,
// Scalar Y store, then the ordered DMA owned by write() (no TBuf, no extra HBM).
template <class IO>
__aicore__ inline void write_identity_tuple(IO& io, GM_ADDR dst) {
    auto out = io.alloc_output();
    AscendC::Duplicate(out.template ReinterpretCast<int32_t>(), int32_t(0), kTupleBytes / 4);
    io.template sync<AscendC::HardEvent::V_S>();
    auto words = out.template ReinterpretCast<uint32_t>();
    for (uint32_t w = 0; w < Bls12381FqParams::word_count; ++w)
        words.SetValue(12 + w, msm_montgomery_one_words[w]);
    io.template sync<AscendC::HardEvent::S_MTE3>();
    io.write(out, dst, kTupleBytes);
}
}  // namespace

// wave_plan stage 1: distributed LOCAL base1 prefix + per-block summary.
//
// Partition (frozen, identical in both stages): the linear base_offsets entry
// space is E = fuse_windows * (buckets + 1) entries INCLUDING every per-window
// sentinel.  span = 8 * ceil(ceil(E / grid) / 8) and block b owns
// [b*span, min(E, (b+1)*span)).  Every ownership boundary is a global entry
// multiple of 8, so it is also a 64 B cacheline boundary: even though the row
// stride (buckets+1) is not a multiple of 8, no two blocks ever share a 64 B
// line.  Bucket-index partitioning would misalign by u*(buckets+1) and is not
// used.
//
// Each block walks its owned entries ascending with a block-local running cap.
// For b == 0 it writes the local running value and counts no cap (bucket 0 is
// not a wave task bucket); for the sentinel b == buckets it writes a zero
// placeholder and counts no cap; for 1 <= b < buckets it reads the unchanged
// rows begin/end pair, writes the local running value BEFORE adding cap, then
// adds cap_at(len) and folds depth_at(len) and the per-window caps.  Every
// owned base_offset entry is fully initialized.  Finally the block publishes
// one 512 B summary record: u64 local node total, u32 local depth, u32
// reserved, 32 * u32 per-window caps, zeros in the rest.
__global__ __aicore__ void hp_msm_wave_plan_stage1_kernel(GM_ADDR rows, GM_ADDR base_offsets,
                                                          GM_ADDR summaries,
                                                          uint32_t fuse_windows,
                                                          uint32_t buckets) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    const uint32_t block = static_cast<uint32_t>(AscendC::GetBlockIdx());
    const uint32_t grid = static_cast<uint32_t>(AscendC::GetBlockNum());
    const uint64_t entries = uint64_t(buckets) + 1;
    const uint64_t total_entries = uint64_t(fuse_windows) * entries;
    const uint64_t per = (total_entries + grid - 1) / grid;
    const uint64_t span = ((per + 7) / 8) * 8;
    const uint64_t start = uint64_t(block) * span;
    if (start >= total_entries) return;
    const uint64_t end = wave_detail::min_u64(start + span, total_entries);
    Staging<16416, 16384> io;
    uint64_t running = 0;
    uint32_t depth_max = 0;
    uint32_t window_caps[msm_wave_window_slots];
    for (uint32_t i = 0; i < msm_wave_window_slots; ++i) window_caps[i] = 0;
    const uint32_t chunk_entries = 2048;  // 16384 B of owns per output chunk
    for (uint64_t first = start; first < end; first += chunk_entries) {
        const uint32_t n = static_cast<uint32_t>(wave_detail::min_u64(end - first, chunk_entries));
        // A row lookup needs rows[e] and rows[e+1]; the only entry that may not
        // look one further is the final sentinel, whose length is never used.
        const uint32_t m = (total_entries - first) < uint64_t(n) + 1 ? n : n + 1;
        auto in = io.read(rows + first * 8, m * 8);
        auto values = in.ReinterpretCast<uint64_t>();
        auto out = io.alloc_output();
        auto written = out.ReinterpretCast<uint64_t>();
        for (uint32_t i = 0; i < n; ++i) {
            const uint64_t e = first + i;
            const uint32_t u = static_cast<uint32_t>(e / entries);
            const uint32_t b = static_cast<uint32_t>(e % entries);
            if (b == 0) {
                // Row offset 0 legitimately spans the whole window record and is
                // never a reduction bucket: it adds no cap and no depth.
                written.SetValue(i, running);
                continue;
            }
            if (b == buckets) {
                written.SetValue(i, 0);  // per-window total, published by stage 2
                continue;
            }
            const uint64_t begin = values.GetValue(i);
            const uint64_t finish = values.GetValue(i + 1);
            const uint64_t len = finish > begin ? finish - begin : 0;
            written.SetValue(i, running);
            const uint32_t cap = wave_detail::cap_at(len);
            running += cap;
            window_caps[u] += cap;
            const uint32_t d = wave_detail::depth_at(len);
            if (d > depth_max) depth_max = d;
        }
        io.sync<AscendC::HardEvent::S_MTE2>();
        io.release(in);
        io.write(out, base_offsets + first * 8, n * 8);
    }
    auto out = io.alloc_output();
    auto words = out.ReinterpretCast<uint32_t>();
    for (uint32_t i = 0; i < 128; ++i) words.SetValue(i, 0);
    words.SetValue(0, static_cast<uint32_t>(running));
    words.SetValue(1, static_cast<uint32_t>(running >> 32));
    words.SetValue(2, depth_max);
    for (uint32_t u = 0; u < msm_wave_window_slots; ++u) words.SetValue(4 + u, window_caps[u]);
    io.write(out, summaries + uint64_t(block) * 512, 512);
}

// wave_plan stage 2: global prefix, sentinel totals and the control/diag tail.
//
// Every block first reads the (contiguous) summary records of the used blocks,
// copies them into scalar per-window caps plus its own prior-prefix, the global
// node total and the global depth, and releases the input buffer.  It then
// re-reads and rewrites its OWNED base_offset chunks: entries b == buckets
// receive the summed per-window cap, every other entry receives the stage-1
// local value plus the sum of all local totals from lower blocks.  Write ranges
// stay inside the 64 B ownership partition, so no block ever writes another
// block's sentinel.  Block 0 alone writes the control header, the global diag
// zeros and the per-window cap tables, byte-identical to the former single
// wave_plan tail, which preserves capture-owned parity/record parity.
__global__ __aicore__ void hp_msm_wave_plan_stage2_kernel(GM_ADDR base_offsets, GM_ADDR summaries,
                                                          GM_ADDR control, GM_ADDR diag,
                                                          uint32_t fuse_windows, uint32_t buckets,
                                                          uint32_t chain_granularity,
                                                          uint32_t l_max, uint32_t count,
                                                          uint32_t window_bits, uint32_t windows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    const uint32_t block = static_cast<uint32_t>(AscendC::GetBlockIdx());
    const uint32_t grid = static_cast<uint32_t>(AscendC::GetBlockNum());
    const uint64_t entries = uint64_t(buckets) + 1;
    const uint64_t total_entries = uint64_t(fuse_windows) * entries;
    const uint64_t per = (total_entries + grid - 1) / grid;
    const uint64_t span = ((per + 7) / 8) * 8;
    const uint32_t used = static_cast<uint32_t>((total_entries + span - 1) / span);
    Staging<32768, 16384> io;
    uint64_t prior = 0;
    uint64_t node_total = 0;
    uint32_t depth_max = 0;
    uint32_t window_total[msm_wave_window_slots];
    for (uint32_t i = 0; i < msm_wave_window_slots; ++i) window_total[i] = 0;
    {
        auto in = io.read(summaries, used * 512);
        auto words = in.ReinterpretCast<uint32_t>();
        for (uint32_t k = 0; k < used; ++k) {
            const uint32_t base = k * 128;
            const uint64_t local = uint64_t(words.GetValue(base)) |
                                   (uint64_t(words.GetValue(base + 1)) << 32);
            const uint32_t depth = words.GetValue(base + 2);
            if (k < block) prior += local;
            node_total += local;
            if (depth > depth_max) depth_max = depth;
            for (uint32_t u = 0; u < msm_wave_window_slots; ++u)
                window_total[u] += words.GetValue(base + 4 + u);
        }
        io.sync<AscendC::HardEvent::S_MTE2>();
        io.release(in);
    }
    const uint64_t start = uint64_t(block) * span;
    if (start < total_entries) {
        const uint64_t end = wave_detail::min_u64(start + span, total_entries);
        const uint32_t chunk_entries = 2048;  // 16384 B per owned chunk
        for (uint64_t first = start; first < end; first += chunk_entries) {
            const uint32_t n =
                static_cast<uint32_t>(wave_detail::min_u64(end - first, chunk_entries));
            auto in = io.read(base_offsets + first * 8, n * 8);
            auto values = in.ReinterpretCast<uint64_t>();
            auto out = io.alloc_output();
            auto written = out.ReinterpretCast<uint64_t>();
            for (uint32_t i = 0; i < n; ++i) {
                const uint64_t e = first + i;
                const uint32_t u = static_cast<uint32_t>(e / entries);
                const uint32_t b = static_cast<uint32_t>(e % entries);
                const uint64_t local = values.GetValue(i);
                written.SetValue(i, b == buckets ? window_total[u] : local + prior);
            }
            io.sync<AscendC::HardEvent::S_MTE2>();
            io.release(in);
            io.write(out, base_offsets + first * 8, n * 8);
        }
    }
    if (block != 0) return;
    uint32_t head[16];
    head[0] = uint32_t(msm_wave_control_magic);
    head[1] = uint32_t(uint64_t(msm_wave_control_magic) >> 32);
    head[2] = count;
    head[3] = window_bits;
    head[4] = windows;
    head[5] = buckets;
    head[6] = fuse_windows;
    head[7] = l_max;
    head[8] = static_cast<uint32_t>(depth_max);
    head[9] = chain_granularity;
    head[10] = static_cast<uint32_t>(node_total);
    head[11] = static_cast<uint32_t>(node_total >> 32);
    head[12] = 0;  // processed_ops, accumulated by the build pass
    head[13] = 0;  // finalized_buckets
    head[14] = 0;  // status
    head[15] = 0;  // status_detail
    {
        auto out = io.alloc_output();
        auto words = out.ReinterpretCast<uint32_t>();
        for (uint32_t i = 0; i < 16; ++i) words.SetValue(i, head[i]);
        io.sync<AscendC::HardEvent::V_S>();
        io.write(out, control, 64);
    }
    // Deterministic zeros for every slot this launch does not own: the per-block
    // and per-level diagnostics and the per-window parity/record tables.  Without
    // this the "errors == 0" and aggregate gates would read arena garbage.
    constexpr uint32_t kDiagPrefixBytes =
        offsetof(WaveDiag, node_count_per_window) + 4 * msm_wave_window_slots;
    {
        auto out = io.alloc_output();
        AscendC::Duplicate(out.ReinterpretCast<int32_t>(), int32_t(0), kDiagPrefixBytes / 4);
        io.sync<AscendC::HardEvent::V_MTE3>();
        wave_detail::gm_out(diag, out, kDiagPrefixBytes);
        io.sync<AscendC::HardEvent::MTE3_V>();
        io.release_output(out);
    }
    {
        // parity[] and window_records[] are capture-owned for windows
        // [0, fuse_windows); only the unused tail is initialised so the captured
        // public row counts reach the report intact.
        const uint32_t tail = msm_wave_window_slots - fuse_windows;
        auto out = io.alloc_output();
        AscendC::Duplicate(out.ReinterpretCast<int32_t>(), int32_t(0), msm_wave_window_slots);
        io.sync<AscendC::HardEvent::V_MTE3>();
        if (tail != 0) {
            wave_detail::gm_out(control + offsetof(WaveControl, parity) + 4 * fuse_windows,
                                out, 4 * tail);
            wave_detail::gm_out(control + offsetof(WaveControl, window_records) +
                                    4 * fuse_windows, out, 4 * tail);
        }
        io.sync<AscendC::HardEvent::MTE3_V>();
        io.release_output(out);
    }
    {
        auto out = io.alloc_output();
        auto words = out.ReinterpretCast<uint32_t>();
        for (uint32_t i = 0; i < msm_wave_window_slots; ++i) words.SetValue(i, window_total[i]);
        io.sync<AscendC::HardEvent::V_S>();
        io.write(out, control + offsetof(WaveControl, window_node_count),
                 4 * msm_wave_window_slots);
    }
    {
        // The same per-window node_count as a device diagnostic (diag slot is
        // inside the zero-filled range, so it must be written after that fill).
        auto out = io.alloc_output();
        auto words = out.ReinterpretCast<uint32_t>();
        for (uint32_t i = 0; i < msm_wave_window_slots; ++i) words.SetValue(i, window_total[i]);
        io.sync<AscendC::HardEvent::V_S>();
        io.write(out, diag + offsetof(WaveDiag, node_count_per_window),
                 4 * msm_wave_window_slots);
    }
}

// wave_capture_meta: copy this window's record parity, RowPtr, sorted records and
// its 64 B ScheduleMeta header into slot `fuse_index`.  It runs stream-ordered
// right after the schedule kernel of the SAME window and before the next window
// overwrites ScheduleMeta, so the per-window header is captured while it is
// still current.  It reads RadixControl, RecordsA/RecordsB, RowPtr and
// ScheduleMeta and never writes production memory.
__global__ __aicore__ void hp_msm_wave_capture_kernel(GM_ADDR records_a, GM_ADDR records_b,
                                                    GM_ADDR routing, GM_ADDR rowptr,
                                                    GM_ADDR schedule_meta,
                                                    GM_ADDR arena_records, GM_ADDR arena_rows,
                                                    GM_ADDR slot_meta, GM_ADDR control,
                                                    uint32_t count, uint32_t buckets,
                                                    uint32_t fuse_index) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<24576, 24576> io;
    const uint32_t block = static_cast<uint32_t>(AscendC::GetBlockIdx());
    uint32_t parity = 0;
    {
        auto in = io.read(routing, 8);
        parity = in.ReinterpretCast<uint32_t>().GetValue(0);
        io.sync<AscendC::HardEvent::S_MTE2>();
        io.release(in);
    }
    const uint32_t entries = buckets + 1;
    GM_ADDR records = parity ? records_b : records_a;
    wave_detail::copy_range(io, records, arena_records + uint64_t(fuse_index) * count * 8,
                            uint64_t(count) * 8, 24576);
    wave_detail::copy_range(io, rowptr, arena_rows + uint64_t(fuse_index) * entries * 8,
                            uint64_t(entries) * 8, 24576);
    // The 64 B header (task_count[6], merge_levels, order_offset) is the exact
    // prefix the weighted reduce reads.  Its own region makes the copy
    // independent of the next window's ScheduleMeta overwrite.
    wave_detail::copy_range(io, schedule_meta,
                            slot_meta + uint64_t(fuse_index) * msm_wave_slot_meta_bytes,
                            msm_wave_slot_meta_bytes, 24576);
    if (block == 0) {
        uint64_t window_records = 0;
        {
            auto in = io.read(rowptr + uint64_t(buckets) * 8, 8);
            window_records = in.ReinterpretCast<uint64_t>().GetValue(0);
            io.sync<AscendC::HardEvent::S_MTE2>();
            io.release(in);
        }
        auto out = io.alloc_output();
        out.ReinterpretCast<uint32_t>().SetValue(0, parity);
        io.sync<AscendC::HardEvent::V_S>();
        io.write(out, control + offsetof(WaveControl, parity) + 4 * fuse_index, 4);
        auto out2 = io.alloc_output();
        out2.ReinterpretCast<uint32_t>().SetValue(0, static_cast<uint32_t>(window_records));
        io.sync<AscendC::HardEvent::V_S>();
        io.write(out2, control + offsetof(WaveControl, window_records) + 4 * fuse_index, 4);
    }
}

// wave_build_level pass A: per-slab level op counts.  The prefix of m_l over the
// bucket space is the only cross-bucket dependency of the descriptor pass below,
// so it reads these msm_wave_core_slots partials instead of a device-wide reduction
// (no atomics, no CrossCore mailbox).
__global__ __aicore__ void hp_msm_wave_build_count_kernel(GM_ADDR rows, GM_ADDR control,
                                                   uint32_t fuse_windows, uint32_t buckets,
                                                   uint32_t level) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<16416, 64> io;
    const uint32_t block = static_cast<uint32_t>(AscendC::GetBlockIdx());
    const uint32_t grid = static_cast<uint32_t>(AscendC::GetBlockNum());
    uint32_t head[8];
    {
        auto in = io.read(control + offsetof(WaveControl, depth_max), 32);
        const auto words = in.ReinterpretCast<uint32_t>();
        for (uint32_t i = 0; i < 8; ++i) head[i] = words.GetValue(i);
        io.sync<AscendC::HardEvent::S_MTE2>();
        io.release(in);
    }
    if (level >= head[0]) {
        auto out = io.alloc_output();
        out.ReinterpretCast<uint32_t>().SetValue(0, 0);
        io.sync<AscendC::HardEvent::V_S>();
        io.write(out, control + offsetof(WaveControl, block_ops) + block * 4, 4);
        return;
    }
    const uint32_t entries = buckets + 1;
    const uint64_t total = uint64_t(fuse_windows) * (uint64_t(buckets) - 1);
    const uint64_t per_block = (total + grid - 1) / grid;
    const uint64_t g0 = uint64_t(block) * per_block;
    const uint64_t g1 = wave_detail::min_u64(g0 + per_block, total);
    uint64_t sum = 0;
    uint32_t u = uint32_t(g0 / (buckets - 1));
    uint32_t b = 1u + uint32_t(g0 % (buckets - 1));
    uint64_t g = g0;
    while (g < g1) {
        const uint32_t take =
            static_cast<uint32_t>(wave_detail::min_u64(g1 - g, uint64_t(buckets - b)));
        for (uint32_t first = 0; first < take; first += 1024) {
            const uint32_t n = wave_detail::min_u32(take - first, 1024);
            auto in = io.read(rows + (uint64_t(u) * entries + b + first) * 8, (n + 1) * 8);
            auto values = in.ReinterpretCast<uint64_t>();
            for (uint32_t i = 0; i < n; ++i) {
                const uint64_t begin = values.GetValue(i);
                const uint64_t end = values.GetValue(i + 1);
                sum += wave_detail::ops_at(end > begin ? end - begin : 0, level);
            }
            io.sync<AscendC::HardEvent::S_MTE2>();
            io.release(in);
        }
        g += take;
        b += take;
        if (b >= buckets) {
            ++u;
            b = 1;
        }
    }
    auto out = io.alloc_output();
    out.ReinterpretCast<uint32_t>().SetValue(0, static_cast<uint32_t>(sum));
    io.sync<AscendC::HardEvent::V_S>();
    io.write(out, control + offsetof(WaveControl, block_ops) + block * 4, 4);
}

// wave_build_level pass B: writes op_src/op_dst for this level and publishes the
// exact A_l plus the derived chain geometry.  Op p is the concatenation over
// (u,b) of that bucket's m_l ops (bucket ops contiguous); both descriptor
// contents are ramps, so runs are accumulated and flushed in 4096-entry blocks.
// base1 is carried incrementally (base1 += cap(n0)) from one read per slab, so
// the level descriptor pass reads only the captured rows.
__global__ __aicore__ void hp_msm_wave_build_write_kernel(GM_ADDR rows, GM_ADDR base_offsets,
                                                   GM_ADDR op_src, GM_ADDR op_dst,
                                                   GM_ADDR control, GM_ADDR diag,
                                                   uint32_t fuse_windows, uint32_t buckets,
                                                   uint32_t level, uint32_t count) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<16416, 16384> io;
    const uint32_t block = static_cast<uint32_t>(AscendC::GetBlockIdx());
    const uint32_t grid = static_cast<uint32_t>(AscendC::GetBlockNum());
    uint32_t head[8];
    {
        auto in = io.read(control + offsetof(WaveControl, depth_max), 32);
        const auto words = in.ReinterpretCast<uint32_t>();
        for (uint32_t i = 0; i < 8; ++i) head[i] = words.GetValue(i);
        io.sync<AscendC::HardEvent::S_MTE2>();
        io.release(in);
    }
    if (buckets < 2) return;
    const uint32_t depth_max = head[0];
    uint64_t slab_ops[msm_wave_core_slots];
    {
        auto in = io.read(control + offsetof(WaveControl, block_ops),
                          4 * msm_wave_core_slots);
        const auto words = in.ReinterpretCast<uint32_t>();
        for (uint32_t i = 0; i < msm_wave_core_slots; ++i) slab_ops[i] = words.GetValue(i);
        io.sync<AscendC::HardEvent::S_MTE2>();
        io.release(in);
    }
    uint64_t ops_total = 0, start = 0;
    for (uint32_t i = 0; i < msm_wave_core_slots; ++i) ops_total += slab_ops[i];
    for (uint32_t i = 0; i < block; ++i) start += slab_ops[i];
    if (block == 0) {
        // Publish the exact A_l and accumulate processed_ops.  The derived chain
        // geometry needs the chain granularity, so it is published by the first
        // affine sub-wave of this level instead (device value, no host read).
        auto out = io.alloc_output();
        out.ReinterpretCast<uint32_t>().SetValue(0, static_cast<uint32_t>(ops_total));
        io.sync<AscendC::HardEvent::V_S>();
        io.write(out, control + offsetof(WaveControl, ops) + 4 * level, 4);
        uint64_t processed = 0;
        {
            auto in = io.read(control + offsetof(WaveControl, processed_ops), 4);
            processed = in.ReinterpretCast<uint32_t>().GetValue(0);
            io.sync<AscendC::HardEvent::S_MTE2>();
            io.release(in);
        }
        auto out3 = io.alloc_output();
        out3.ReinterpretCast<uint32_t>().SetValue(0, static_cast<uint32_t>(processed + ops_total));
        io.sync<AscendC::HardEvent::V_S>();
        io.write(out3, control + offsetof(WaveControl, processed_ops), 4);
        if (level >= depth_max) {
            // Inactive level: publish exact zeros so no diagnostic keeps stale data.
            constexpr uint32_t kLevelFields[4] = {
                offsetof(WaveDiag, processed_ops_per_level),
                offsetof(WaveDiag, blocks_used_per_level),
                offsetof(WaveDiag, subwaves_per_level),
                offsetof(WaveDiag, chains_per_level)};
            for (uint32_t field = 0; field < 4; ++field) {
                auto zero = io.alloc_output();
                zero.ReinterpretCast<uint32_t>().SetValue(0, 0u);
                io.sync<AscendC::HardEvent::V_S>();
                io.write(zero, diag + kLevelFields[field] + 4 * level, 4);
            }
        }
    }
    if (level >= depth_max) return;
    const uint32_t entries = buckets + 1;
    const uint64_t total = uint64_t(fuse_windows) * (uint64_t(buckets) - 1);
    const uint64_t per_block = (total + grid - 1) / grid;
    const uint64_t g0 = uint64_t(block) * per_block;
    const uint64_t g1 = wave_detail::min_u64(g0 + per_block, total);
    if (g0 >= g1) return;
    const uint32_t u0 = uint32_t(g0 / (buckets - 1));
    const uint32_t b0 = 1u + uint32_t(g0 % (buckets - 1));
    uint64_t running_base1 = 0;
    {
        auto in = io.read(base_offsets + (uint64_t(u0) * entries + b0) * 8, 8);
        running_base1 = in.ReinterpretCast<uint64_t>().GetValue(0);
        io.sync<AscendC::HardEvent::S_MTE2>();
        io.release(in);
    }
    for (uint32_t pass = 0; pass < 2; ++pass) {
        GM_ADDR target = pass == 0 ? op_dst : op_src;
        uint64_t p = start;
        uint64_t buffered = 0;
        uint64_t slab_base1 = running_base1;
        auto out = io.alloc_output();
        auto dst_words = out.ReinterpretCast<uint32_t>();
        uint32_t u = u0;
        uint32_t b = b0;
        uint64_t g = g0;
        while (g < g1) {
            const uint32_t take =
                static_cast<uint32_t>(wave_detail::min_u64(g1 - g, uint64_t(buckets - b)));
            for (uint32_t first = 0; first < take; first += 1024) {
                const uint32_t n = wave_detail::min_u32(take - first, 1024);
                auto in = io.read(rows + (uint64_t(u) * entries + b + first) * 8, (n + 1) * 8);
                auto values = in.ReinterpretCast<uint64_t>();
                for (uint32_t i = 0; i < n; ++i) {
                    const uint64_t begin = values.GetValue(i);
                    const uint64_t end = values.GetValue(i + 1);
                    const uint64_t n0 = end > begin ? end - begin : 0;
                    const uint32_t m = wave_detail::ops_at(n0, level);
                    if (m != 0) {
                        if (buffered + m > 4096) {
                            io.sync<AscendC::HardEvent::S_MTE3>();
                            io.write(out, target + (p - buffered) * 4,
                                     static_cast<uint32_t>(buffered * 4));
                            buffered = 0;
                            out = io.alloc_output();
                            dst_words = out.ReinterpretCast<uint32_t>();
                        }
                        for (uint32_t k = 0; k < m; ++k) {
                            const uint64_t value =
                                pass == 0 ? slab_base1 + k
                                          : (level == 0 ? uint64_t(u) * count + begin + 2 * k
                                                        : slab_base1 + 2 * k);
                            dst_words.SetValue(buffered, static_cast<uint32_t>(value));
                            ++buffered;
                            ++p;
                        }
                    }
                    slab_base1 += wave_detail::cap_at(n0);
                }
                io.sync<AscendC::HardEvent::S_MTE2>();
                io.release(in);
            }
            g += take;
            b += take;
            if (b >= buckets) {
                ++u;
                b = 1;
            }
        }
        if (buffered != 0) {
            io.sync<AscendC::HardEvent::S_MTE3>();
            io.write(out, target + (p - buffered) * 4, static_cast<uint32_t>(buffered * 4));
        } else {
            // A pass that ends exactly on a flush (or produces no op at all)
            // still owns this allocation; with DEPTH=1 the next pass's
            // alloc_output would stall unless the buffer returns here.
            io.release_output(out);
        }
    }
}

// wave_carry_level: one 96 B copy per odd-count bucket with n_l >= 3 (level 0
// reads the unpaired record -> SRS point, level >= 1 copies a node).  Buckets
// whose tree is finished (n_l <= 1, i.e. l >= depth) never issue a carry.
__global__ __aicore__ void hp_msm_wave_carry_kernel(GM_ADDR cache, GM_ADDR records, GM_ADDR rows,
                                             GM_ADDR base_offsets, GM_ADDR src_nodes,
                                             GM_ADDR dst_nodes, GM_ADDR control,
                                             uint32_t fuse_windows, uint32_t buckets,
                                             uint32_t level, uint32_t count) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<16384, 16384> io;
    const uint32_t block = static_cast<uint32_t>(AscendC::GetBlockIdx());
    const uint32_t grid = static_cast<uint32_t>(AscendC::GetBlockNum());
    uint32_t head[8];
    {
        auto in = io.read(control + offsetof(WaveControl, depth_max), 32);
        const auto words = in.ReinterpretCast<uint32_t>();
        for (uint32_t i = 0; i < 8; ++i) head[i] = words.GetValue(i);
        io.sync<AscendC::HardEvent::S_MTE2>();
        io.release(in);
    }
    if (level >= head[0]) return;
    if (buckets < 2) return;
    const uint32_t entries = buckets + 1;
    const uint64_t total = uint64_t(fuse_windows) * (uint64_t(buckets) - 1);
    for (uint64_t gbase = uint64_t(block) * 64; gbase < total; gbase += uint64_t(grid) * 64) {
        const uint32_t n = static_cast<uint32_t>(wave_detail::min_u64(total - gbase, 64));
        uint64_t n0[64];
        uint64_t base1[64];
        uint32_t window_of[64];
        uint32_t begin_of[64];
        uint32_t flag[64];
        uint32_t pid[64];
        io.sync<AscendC::HardEvent::MTE3_V>();
        io.sync<AscendC::HardEvent::V_MTE2>();
        auto in_buf = io.alloc_input();
        for (uint32_t l = 0; l < n; ++l) {
            const uint64_t g = gbase + l;
            const uint32_t u = uint32_t(g / (buckets - 1));
            const uint32_t b = 1u + uint32_t(g % (buckets - 1));
            wave_detail::gm_in(in_buf[l * 32], rows + (uint64_t(u) * entries + b) * 8, 16);
            wave_detail::gm_in(in_buf[2048 + l * 32],
                               base_offsets + (uint64_t(u) * entries + b) * 8, 8);
        }
        in_buf = io.ready_input(in_buf);
        auto meta64 = in_buf.ReinterpretCast<uint64_t>();
        for (uint32_t l = 0; l < n; ++l) {
            const uint64_t g = gbase + l;
            const uint64_t begin = meta64.GetValue(l * 4);
            const uint64_t end = meta64.GetValue(l * 4 + 1);
            n0[l] = end > begin ? end - begin : 0;
            base1[l] = meta64.GetValue(256 + l * 4);
            window_of[l] = uint32_t(g / (buckets - 1));
            begin_of[l] = static_cast<uint32_t>(begin);
            flag[l] = wave_detail::carry_here(n0[l], level) ? 1u : 0u;
        }
        io.sync<AscendC::HardEvent::S_MTE2>();
        io.release(in_buf);
        if (level == 0) {
            auto rec_buf = io.alloc_input();
            for (uint32_t l = 0; l < n; ++l) {
                if (!flag[l]) continue;
                const uint64_t index =
                    uint64_t(window_of[l]) * count + begin_of[l] +
                    wave_detail::nodes_at(n0[l], 0) - 1;
                wave_detail::gm_in(rec_buf[l * 32], records + index * 8, 8);
            }
            rec_buf = io.ready_input(rec_buf);
            auto rec32 = rec_buf.ReinterpretCast<uint32_t>();
            for (uint32_t l = 0; l < n; ++l) pid[l] = rec32.GetValue(l * 8 + 1);
            io.sync<AscendC::HardEvent::S_MTE2>();
            io.release(rec_buf);
        }
        auto out = io.alloc_output();
        io.sync<AscendC::HardEvent::V_MTE2>();
        for (uint32_t l = 0; l < n; ++l) {
            if (!flag[l]) continue;
            if (level == 0) {
                wave_detail::gm_in(out[l * kPointBytes], cache + uint64_t(pid[l]) * kPointBytes,
                                   kPointBytes);
            } else {
                const uint64_t src_index = base1[l] + wave_detail::nodes_at(n0[l], level) - 1;
                wave_detail::gm_in(out[l * kPointBytes], src_nodes + src_index * kPointBytes,
                                   kPointBytes);
            }
        }
        // Order the finished loads before the stores (MTE2 -> V -> MTE3).
        io.sync<AscendC::HardEvent::MTE2_V>();
        io.sync<AscendC::HardEvent::V_MTE3>();
        for (uint32_t l = 0; l < n; ++l) {
            if (!flag[l]) continue;
            const uint32_t carried = (wave_detail::nodes_at(n0[l], level) + 1) >> 1;
            const uint64_t dst_index = base1[l] + carried - 1;
            wave_detail::gm_out(dst_nodes + dst_index * kPointBytes, out[l * kPointBytes],
                                kPointBytes);
        }
        io.sync<AscendC::HardEvent::MTE3_V>();
        io.release_output(out);
    }
}

// wave_finalize: one 192 B tuple per bucket — (x,y,R,0..0) for a reduced bucket
// (node of the bucket's own last level at base1 + 0, or the single SRS point),
// and the canonical Jacobian identity (0,R,0) for an empty or cancelling bucket.
__global__ __aicore__ void hp_msm_wave_finalize_kernel(GM_ADDR cache, GM_ADDR records, GM_ADDR rows,
                                                GM_ADDR base_offsets, GM_ADDR nodes_a,
                                                GM_ADDR nodes_b, GM_ADDR out_b, GM_ADDR control,
                                                GM_ADDR diag, uint32_t fuse_windows,
                                                uint32_t buckets, uint32_t count) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    Staging<8192, 16384> io;
    const uint32_t block = static_cast<uint32_t>(AscendC::GetBlockIdx());
    const uint32_t grid = static_cast<uint32_t>(AscendC::GetBlockNum());
    if (buckets < 2) return;
    // The final node of a bucket lives in the parity buffer of that bucket's own
    // last computed level (depth_at(n0)-1; level%2 selects nodes_a/nodes_b).
    // The global depth_max is not a valid selector and is not read here.
    if (block == 0) {
        auto out = io.alloc_output();
        out.ReinterpretCast<uint32_t>().SetValue(0, fuse_windows * (buckets - 1));
        io.sync<AscendC::HardEvent::V_S>();
        io.write(out, control + offsetof(WaveControl, finalized_buckets), 4);
    }
    const uint32_t entries = buckets + 1;
    const uint64_t total = uint64_t(fuse_windows) * (uint64_t(buckets) - 1);
    uint32_t finalized = 0;
    for (uint64_t gbase = uint64_t(block) * 64; gbase < total; gbase += uint64_t(grid) * 64) {
        const uint32_t n = static_cast<uint32_t>(wave_detail::min_u64(total - gbase, 64));
        uint64_t n0[64];
        uint64_t base1[64];
        uint32_t window_of[64];
        uint32_t begin_of[64];
        uint32_t pid[64];
        io.sync<AscendC::HardEvent::MTE3_V>();
        io.sync<AscendC::HardEvent::V_MTE2>();
        auto in_buf = io.alloc_input();
        for (uint32_t l = 0; l < n; ++l) {
            const uint64_t g = gbase + l;
            const uint32_t u = uint32_t(g / (buckets - 1));
            const uint32_t b = 1u + uint32_t(g % (buckets - 1));
            wave_detail::gm_in(in_buf[l * 32], rows + (uint64_t(u) * entries + b) * 8, 16);
            wave_detail::gm_in(in_buf[2048 + l * 32],
                               base_offsets + (uint64_t(u) * entries + b) * 8, 8);
        }
        in_buf = io.ready_input(in_buf);
        auto meta64 = in_buf.ReinterpretCast<uint64_t>();
        for (uint32_t l = 0; l < n; ++l) {
            const uint64_t g = gbase + l;
            const uint64_t begin = meta64.GetValue(l * 4);
            const uint64_t end = meta64.GetValue(l * 4 + 1);
            n0[l] = end > begin ? end - begin : 0;
            base1[l] = meta64.GetValue(256 + l * 4);
            window_of[l] = uint32_t(g / (buckets - 1));
            begin_of[l] = static_cast<uint32_t>(begin);
        }
        io.sync<AscendC::HardEvent::S_MTE2>();
        io.release(in_buf);
        auto out = io.alloc_output();
        AscendC::Duplicate(out.ReinterpretCast<int32_t>(), int32_t(0), 16384 / 4);
        io.sync<AscendC::HardEvent::V_MTE2>();
        for (uint32_t l = 0; l < n; ++l) {
            if (n0[l] < 2) continue;
            // The bucket's last computed level is depth_at(n0)-1, so its final
            // node lives in that level's parity buffer, per bucket.
            const uint32_t d = wave_detail::depth_at(n0[l]);
            GM_ADDR lane_nodes = ((d - 1) % 2 == 0) ? nodes_a : nodes_b;
            wave_detail::gm_in(out[l * kTupleBytes], lane_nodes + base1[l] * kPointBytes,
                               kPointBytes);
        }
        {
            auto rec_buf = io.alloc_input();
            for (uint32_t l = 0; l < n; ++l) {
                if (n0[l] != 1) continue;
                const uint64_t index = uint64_t(window_of[l]) * count + begin_of[l];
                wave_detail::gm_in(rec_buf[l * 32], records + index * 8, 8);
            }
            rec_buf = io.ready_input(rec_buf);
            auto rec32 = rec_buf.ReinterpretCast<uint32_t>();
            for (uint32_t l = 0; l < n; ++l) pid[l] = rec32.GetValue(l * 8 + 1);
            io.sync<AscendC::HardEvent::S_MTE2>();
            io.release(rec_buf);
            io.sync<AscendC::HardEvent::V_MTE2>();
            for (uint32_t l = 0; l < n; ++l) {
                if (n0[l] != 1) continue;
                wave_detail::gm_in(out[l * kTupleBytes],
                                   cache + uint64_t(pid[l]) * kPointBytes, kPointBytes);
            }
        }
        io.sync<AscendC::HardEvent::MTE2_S>();
        // Z = R for a finite point; the canonical identity tuple is (0,R,0).
        // The wave packs a group identity as the affine (0,0), so a non-empty
        // bucket whose accumulated point is the identity must take the same
        // canonical form as an empty bucket instead of (0,0,R).
        auto out_words = out.ReinterpretCast<uint32_t>();
        for (uint32_t l = 0; l < n; ++l) {
            uint32_t base_word = 24u;
            if (n0[l] == 0) {
                base_word = 12u;
            } else {
                uint32_t nonzero = 0;
                for (uint32_t w = 0; w < 2 * Bls12381FqParams::word_count; ++w)
                    nonzero |= out_words.GetValue(l * 48 + w);
                if (nonzero == 0) base_word = 12u;
            }
            for (uint32_t w = 0; w < Bls12381FqParams::word_count; ++w)
                out_words.SetValue(l * 48 + base_word + w, msm_montgomery_one_words[w]);
        }
        io.sync<AscendC::HardEvent::S_MTE3>();
        for (uint32_t l = 0; l < n; ++l) {
            const uint64_t g = gbase + l;
            const uint32_t b = 1u + uint32_t(g % (buckets - 1));
            const uint64_t dst = uint64_t(window_of[l]) * buckets + b;
            wave_detail::gm_out(out_b + dst * kTupleBytes, out[l * kTupleBytes], kTupleBytes);
        }
        io.sync<AscendC::HardEvent::MTE3_V>();
        io.release_output(out);
        finalized += n;
    }
    // Bucket 0 is never read from the arena: it is the frozen zero-coefficient
    // tuple, so every window receives the canonical identity explicitly, one
    // writer per window.  These writes are outside the point-reduction
    // accounting, so `finalized` and control+52 keep counting only the non-zero
    // reduction buckets (W*(buckets-1)).
    for (uint32_t u = block; u < fuse_windows; u += grid)
        write_identity_tuple(io, out_b + uint64_t(u) * buckets * kTupleBytes);
    auto report = io.alloc_output();
    report.ReinterpretCast<uint32_t>().SetValue(0, finalized);
    io.sync<AscendC::HardEvent::V_S>();
    io.write(report, diag + offsetof(WaveDiag, finalized_per_block) + block * 4, 4);
}

// wave_affine_level: one instantiation per level-0 / level>=1 source format.
__global__ __aicore__ void hp_msm_wave_affine_kernel(
    GM_ADDR cache, GM_ADDR records, GM_ADDR op_src, GM_ADDR op_dst, GM_ADDR src_nodes,
    GM_ADDR dst_nodes, GM_ADDR prefixes, GM_ADDR control, GM_ADDR diag,
    uint32_t fuse_windows, uint32_t level, uint32_t subwave, uint32_t chain_granularity,
    uint32_t l_max, uint32_t level_zero) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    G1WaveAffine<64> controller;
    if (level_zero) {
        controller.template level<true>(cache, records, op_src, op_dst, src_nodes, dst_nodes,
                                        prefixes, control, diag, fuse_windows, level, subwave,
                                        chain_granularity, l_max);
    } else {
        controller.template level<false>(cache, records, op_src, op_dst, src_nodes, dst_nodes,
                                         prefixes, control, diag, fuse_windows, level, subwave,
                                         chain_granularity, l_max);
    }
}

// ---------------------------------------------------------------------------
// Private production launchers (the only six entry points).  They enqueue on
// `stream`, never synchronize, never allocate and never copy to the host.  The
// wave arena is one private MsmRegion; `bounds` carries its 12 aligned
// sub-region sizes (the last is the 512 B plan-stage summaries, one per AIV
// block) and `wave_regions(bounds)` their offsets.  The per-window
// 64 B ScheduleMeta slots live in the separate WaveSlotMeta region.
// ---------------------------------------------------------------------------
namespace detail {
namespace {
inline uint32_t wave_grid(const MsmPlan& plan) {
    const uint32_t cores = plan.platform.aiv_cores;
    if (cores == 0) return 1;
    return cores > msm_wave_core_slots ? msm_wave_core_slots : cores;
}
inline uint8_t* wave_ws(const void* workspace) {
    return const_cast<uint8_t*>(static_cast<const uint8_t*>(workspace));
}
}  // namespace

void launch_msm_wave_capture(aclrtStream stream, void* plan_workspace, void* wave_arena,
                             const MsmPlan& plan, const WaveBounds& bounds,
                             uint32_t fuse_index) {
    if (!plan.count || !plan.buckets || !plan.wave_windows || !bounds.total ||
        fuse_index >= plan.wave_windows || fuse_index >= msm_wave_window_slots) {
        return;
    }
    const WaveRegions r = wave_regions(bounds);
    uint8_t* ws = static_cast<uint8_t*>(plan_workspace);
    uint8_t* arena = static_cast<uint8_t*>(wave_arena);
    hp_msm_wave_capture_kernel<<<wave_grid(plan), nullptr, stream>>>(
        msm_device::region(ws, plan, MsmRegion::RecordsA),
        msm_device::region(ws, plan, MsmRegion::RecordsB),
        msm_device::region(ws, plan, MsmRegion::RadixControl),
        msm_device::region(ws, plan, MsmRegion::RowPtr),
        msm_device::region(ws, plan, MsmRegion::ScheduleMeta),
        arena + r.records, arena + r.rows,
        // Raw region base: the kernel adds fuse_index*64 exactly like records/rows.
        msm_device::region(ws, plan, MsmRegion::WaveSlotMeta),
        arena + r.control, static_cast<uint32_t>(plan.count), plan.buckets, fuse_index);
}

void launch_msm_wave_plan(aclrtStream stream, void* wave_arena, const MsmPlan& plan,
                          const WaveBounds& bounds, uint32_t fuse_windows) {
    if (!plan.count || !bounds.total || fuse_windows == 0 ||
        fuse_windows > plan.wave_windows || fuse_windows > msm_wave_window_slots) {
        return;
    }
    const WaveRegions r = wave_regions(bounds);
    uint8_t* arena = static_cast<uint8_t*>(wave_arena);
    // Same partition as both stages: grid = min(aiv_cores, ceil(E / 8)) with the
    // linear base_offsets entry space E = fuse_windows * (buckets + 1).
    const uint64_t entries = uint64_t(fuse_windows) * (uint64_t(plan.buckets) + 1);
    const uint64_t entry_grid = (entries + 7) / 8;
    uint32_t grid = wave_grid(plan);
    if (entry_grid < uint64_t(grid)) grid = static_cast<uint32_t>(entry_grid);
    if (grid == 0) return;
    // One call, two stream-ordered launches: stage 2 consumes the completed
    // summaries and the stage-1 local offsets, so the next build launch sees
    // fully finished metadata.  Both use the same block count; nothing is read,
    // copied or synchronized on the host.
    hp_msm_wave_plan_stage1_kernel<<<grid, nullptr, stream>>>(
        arena + r.rows, arena + r.base_offsets, arena + r.plan_summaries, fuse_windows,
        plan.buckets);
    hp_msm_wave_plan_stage2_kernel<<<grid, nullptr, stream>>>(
        arena + r.base_offsets, arena + r.plan_summaries, arena + r.control, arena + r.diag,
        fuse_windows, plan.buckets, msm_wave_chain_granularity, msm_wave_l_max,
        static_cast<uint32_t>(plan.count), plan.window_bits, plan.windows);
}

void launch_msm_wave_build(aclrtStream stream, void* wave_arena, const MsmPlan& plan,
                           const WaveBounds& bounds, uint32_t fuse_windows, uint32_t level) {
    if (!plan.count || !bounds.total || level >= msm_wave_level_slots || fuse_windows == 0 ||
        fuse_windows > plan.wave_windows || fuse_windows > msm_wave_window_slots) {
        return;
    }
    const WaveRegions r = wave_regions(bounds);
    uint8_t* arena = static_cast<uint8_t*>(wave_arena);
    const uint32_t grid = wave_grid(plan);
    hp_msm_wave_build_count_kernel<<<grid, nullptr, stream>>>(
        arena + r.rows, arena + r.control, fuse_windows, plan.buckets, level);
    hp_msm_wave_build_write_kernel<<<grid, nullptr, stream>>>(
        arena + r.rows, arena + r.base_offsets, arena + r.op_src, arena + r.op_dst,
        arena + r.control, arena + r.diag, fuse_windows, plan.buckets, level,
        static_cast<uint32_t>(plan.count));
}

void launch_msm_wave_affine(aclrtStream stream, const void* cache, void* wave_arena,
                            const MsmPlan& plan, const WaveBounds& bounds,
                            uint32_t fuse_windows, uint32_t level, uint32_t subwave) {
    if (!plan.count || !bounds.total || level >= msm_wave_level_slots || fuse_windows == 0 ||
        fuse_windows > plan.wave_windows || fuse_windows > msm_wave_window_slots) {
        return;
    }
    const WaveRegions r = wave_regions(bounds);
    uint8_t* arena = static_cast<uint8_t*>(wave_arena);
    uint8_t* nodes_a = arena + r.nodes_a;
    uint8_t* nodes_b = arena + r.nodes_b;
    uint8_t* dst = (level % 2 == 0) ? nodes_a : nodes_b;
    uint8_t* src = (level % 2 == 1) ? nodes_a : nodes_b;
    hp_msm_wave_affine_kernel<<<wave_grid(plan), nullptr, stream>>>(
        wave_ws(cache), arena + r.records, arena + r.op_src, arena + r.op_dst, src, dst,
        arena + r.prefixes, arena + r.control, arena + r.diag, fuse_windows, level, subwave,
        msm_wave_chain_granularity, msm_wave_l_max, level == 0 ? 1u : 0u);
}

void launch_msm_wave_carry(aclrtStream stream, const void* cache, void* wave_arena,
                           const MsmPlan& plan, const WaveBounds& bounds,
                           uint32_t fuse_windows, uint32_t level) {
    if (!plan.count || !bounds.total || level >= msm_wave_level_slots || fuse_windows == 0 ||
        fuse_windows > plan.wave_windows || fuse_windows > msm_wave_window_slots) {
        return;
    }
    const WaveRegions r = wave_regions(bounds);
    uint8_t* arena = static_cast<uint8_t*>(wave_arena);
    uint8_t* nodes_a = arena + r.nodes_a;
    uint8_t* nodes_b = arena + r.nodes_b;
    uint8_t* dst = (level % 2 == 0) ? nodes_a : nodes_b;
    uint8_t* src = (level % 2 == 1) ? nodes_a : nodes_b;
    hp_msm_wave_carry_kernel<<<wave_grid(plan), nullptr, stream>>>(
        wave_ws(cache), arena + r.records, arena + r.rows, arena + r.base_offsets, src, dst,
        arena + r.control, fuse_windows, plan.buckets, level,
        static_cast<uint32_t>(plan.count));
}

void launch_msm_wave_finalize(aclrtStream stream, const void* cache, void* wave_arena,
                              const MsmPlan& plan, const WaveBounds& bounds,
                              uint32_t fuse_windows) {
    if (!plan.count || !bounds.total || fuse_windows == 0 ||
        fuse_windows > plan.wave_windows || fuse_windows > msm_wave_window_slots) {
        return;
    }
    const WaveRegions r = wave_regions(bounds);
    uint8_t* arena = static_cast<uint8_t*>(wave_arena);
    hp_msm_wave_finalize_kernel<<<wave_grid(plan), nullptr, stream>>>(
        wave_ws(cache), arena + r.records, arena + r.rows, arena + r.base_offsets,
        arena + r.nodes_a, arena + r.nodes_b, arena + r.out_b, arena + r.control,
        arena + r.diag, fuse_windows, plan.buckets, static_cast<uint32_t>(plan.count));
}

}  // namespace detail

}  // namespace hyperplonk::ascend910b3
