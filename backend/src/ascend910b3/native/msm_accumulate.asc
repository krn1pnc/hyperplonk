#include "msm_device.h"
#include "msm_internal.h"
#include "g1_vector.h"

using namespace hyperplonk::ascend910b3;
using namespace hyperplonk::ascend910b3::detail;
using namespace hyperplonk::ascend910b3::detail::msm_device;

__global__ __aicore__ void hp_msm_prepare_bases(
    GM_ADDR bases, GM_ADDR montgomery_bases, uint64_t count)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    G1Vector points;
    constexpr uint32_t tile=G1Vector::tile_size;
    uint64_t offsets[tile];
    const uint64_t stride=uint64_t(AscendC::GetBlockNum())*tile;
    for (uint64_t first=uint64_t(AscendC::GetBlockIdx())*tile; first<count; first+=stride) {
        const uint32_t valid=min32(count-first,tile);
        for (uint32_t lane=0;lane<valid;++lane) offsets[lane]=(first+lane)*96;
        points.load_affine(0,bases,offsets,valid);
        points.store_affine_montgomery(0,montgomery_bases,offsets,valid);
    }
}

__global__ __aicore__ void hp_msm_partial_sums(
    GM_ADDR bases, GM_ADDR records, GM_ADDR tasks, GM_ADDR task_order,
    GM_ADDR partials, uint64_t task_count)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    G1Vector points;
    constexpr uint32_t tile=G1Vector::tile_size;
    uint64_t begin[tile], offsets[tile];
    uint32_t counts[tile], output_indices[tile];
    const uint64_t stride=uint64_t(AscendC::GetBlockNum())*tile;
    for (uint64_t t=uint64_t(AscendC::GetBlockIdx())*tile; t<task_count; t+=stride) {
        const uint32_t valid=min32(task_count-t,tile);
        const auto order=points.read_meta(task_order+t*4,valid*4).ReinterpretCast<uint32_t>();
        for (uint32_t lane=0;lane<valid;++lane) {
            output_indices[lane]=order.GetValue(lane);
            offsets[lane]=uint64_t(output_indices[lane])*64;
        }
        const auto input=points.read_meta_scattered(tasks,offsets,valid,64);
        const auto q=input.ReinterpretCast<uint64_t>();
        const auto w=input.ReinterpretCast<uint32_t>();
        uint32_t max_count=0;
        for (uint32_t lane=0;lane<valid;++lane) {
            begin[lane]=q.GetValue(lane*8);
            counts[lane]=w.GetValue(lane*16+2);
            if (counts[lane]>max_count) max_count=counts[lane];
        }
        points.set_identity(0);
        for (uint32_t i=0;i<max_count;++i) {
            for (uint32_t lane=0;lane<valid;++lane)
                offsets[lane]=i<counts[lane] ? (begin[lane]+i)*8 : G1Vector::absent;
            // Scattered 8-byte records occupy separate 64-byte metadata slots.
            const auto records_meta=points.read_meta_scattered(records,offsets,valid,8);
            const auto record_words=records_meta.ReinterpretCast<uint32_t>();
            for (uint32_t lane=0;lane<valid;++lane)
                offsets[lane]=i<counts[lane]
                    ? uint64_t(record_words.GetValue(lane*16+1))*96 : G1Vector::absent;
            points.load_affine_montgomery(3,bases,offsets,valid);
            points.add_assign_affine(0,3);
        }
        for (uint32_t lane=0;lane<valid;++lane)
            offsets[lane]=uint64_t(output_indices[lane])*192;
        points.store_points_montgomery(0,partials,offsets,valid);
    }
}

__global__ __aicore__ void hp_msm_partial_merge(
    GM_ADDR tasks, GM_ADDR children, GM_ADDR partials, uint64_t task_count)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    G1Vector points;
    constexpr uint32_t tile=G1Vector::tile_size;
    uint64_t begin[tile], offsets[tile];
    uint32_t counts[tile];
    const uint64_t stride=uint64_t(AscendC::GetBlockNum())*tile;
    for (uint64_t t=uint64_t(AscendC::GetBlockIdx())*tile; t<task_count; t+=stride) {
        const uint32_t valid=min32(task_count-t,tile);
        const auto input=points.read_meta(tasks+t*64,valid*64);
        const auto q=input.ReinterpretCast<uint64_t>();
        const auto w=input.ReinterpretCast<uint32_t>();
        uint32_t max_count=0;
        for (uint32_t lane=0;lane<valid;++lane) {
            begin[lane]=q.GetValue(lane*8);
            counts[lane]=w.GetValue(lane*16+2);
            if (counts[lane]>max_count) max_count=counts[lane];
        }
        points.set_identity(0);
        for (uint32_t i=0;i<max_count;++i) {
            for (uint32_t lane=0;lane<valid;++lane)
                offsets[lane]=i<counts[lane] ? (begin[lane]+i)*192 : G1Vector::absent;
            points.load_points_montgomery(3,children,offsets,valid);
            points.add_assign(0,3);
        }
        for (uint32_t lane=0;lane<valid;++lane) offsets[lane]=(t+lane)*192;
        points.store_points_montgomery(0,partials,offsets,valid);
    }
}

__global__ __aicore__ void hp_msm_bucket_materialize(
    GM_ADDR prefix, GM_ADDR partials, GM_ADDR buckets, uint32_t bucket_count)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    // Raw-copy packed Montgomery tuples; no field conversion or arithmetic.
    Staging<544,12288> io;
    constexpr uint32_t tile=64;
    uint64_t offsets[tile];
    const uint64_t stride=uint64_t(AscendC::GetBlockNum())*tile;
    for (uint64_t b=uint64_t(AscendC::GetBlockIdx())*tile; b<bucket_count; b+=stride) {
        const uint32_t valid=min32(uint64_t(bucket_count)-b,tile);
        auto input=io.read(prefix+b*8,(valid+1)*8);
        const auto q=input.ReinterpretCast<uint64_t>();
        for (uint32_t lane=0;lane<valid;++lane) {
            const uint64_t begin=q.GetValue(lane), end=q.GetValue(lane+1);
            offsets[lane]=(b+lane && begin!=end) ? begin*192 : UINT64_MAX;
        }
        io.release(input);
        auto output=io.alloc_output();
        AscendC::Duplicate(output.ReinterpretCast<int32_t>(),int32_t(0),12288/4);
        io.sync<AscendC::HardEvent::V_S>();
        auto words=output.ReinterpretCast<uint32_t>();
        for (uint32_t lane=0;lane<valid;++lane)
            if (offsets[lane]==UINT64_MAX)
                for (uint32_t word=0;word<Bls12381FqParams::word_count;++word)
                    words.SetValue(lane*48+12+word,msm_montgomery_one_words[word]);
        io.sync<AscendC::HardEvent::S_MTE2>();
        for (uint32_t lane=0;lane<valid;++lane)
            if (offsets[lane]!=UINT64_MAX)
                io.copy_in(output[lane*192],partials+offsets[lane],192);
        io.sync<AscendC::HardEvent::MTE2_S>();
        io.write(output,buckets+b*192,valid*192);
    }
}

namespace hyperplonk::ascend910b3::detail {
void launch_msm_prepare_bases(aclrtStream stream,const G1Affine* bases,void* workspace,
                              const MsmPlan& p) {
    if (!p.count) return;
    hp_msm_prepare_bases<<<p.platform.aiv_cores,nullptr,stream>>>(
        reinterpret_cast<uint8_t*>(const_cast<G1Affine*>(bases)),
        region(workspace,p,MsmRegion::MontgomeryBases),p.count);
}
void launch_msm_partial_sums(aclrtStream stream,void* workspace,
                             const MsmPlan& p,uint64_t tasks,uint64_t order_offset) {
    if (!tasks) return;
    const auto sorted=p.radix_passes%2 ? MsmRegion::RecordsB : MsmRegion::RecordsA;
    hp_msm_partial_sums<<<blocks(p,tasks/48+(tasks%48!=0)),nullptr,stream>>>(
        region(workspace,p,MsmRegion::MontgomeryBases),region(workspace,p,sorted),
        region(workspace,p,MsmRegion::Tasks),
        region(workspace,p,MsmRegion::TaskPrefix)+order_offset,
        region(workspace,p,MsmRegion::PartialA),tasks);
}
void launch_msm_partial_merge(aclrtStream stream,void* workspace,const MsmPlan& p,
                              uint32_t level,uint64_t tasks) {
    if (!tasks) return;
    const auto source=level%2 ? MsmRegion::PartialA : MsmRegion::PartialB;
    const auto target=level%2 ? MsmRegion::PartialB : MsmRegion::PartialA;
    hp_msm_partial_merge<<<blocks(p,tasks/48+(tasks%48!=0)),nullptr,stream>>>(
        region(workspace,p,MsmRegion::Tasks),region(workspace,p,source),
        region(workspace,p,target),tasks);
}
void launch_msm_bucket_materialize(aclrtStream stream,void* workspace,const MsmPlan& p,
                                   uint32_t level) {
    if (!p.buckets) return;
    const uint64_t stride=((uint64_t(p.buckets)+1+7)/8)*8*8;
    const auto source=level%2 ? MsmRegion::PartialB : MsmRegion::PartialA;
    hp_msm_bucket_materialize<<<blocks(p,(uint64_t(p.buckets)+63)/64),nullptr,stream>>>(
        region(workspace,p,MsmRegion::TaskPrefix)+stride*level,
        region(workspace,p,source),region(workspace,p,MsmRegion::Buckets),p.buckets);
}
} // namespace hyperplonk::ascend910b3::detail
