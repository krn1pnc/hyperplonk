#include "msm_device.h"
#include "msm_internal.h"
#include "g1_vector.h"

using namespace hyperplonk::ascend910b3;
using namespace hyperplonk::ascend910b3::detail;
using namespace hyperplonk::ascend910b3::detail::msm_device;
using MsmPoints = G1VectorEngine<msm_point_lanes, true>;

__global__ __aicore__ void hp_msm_prepare_bases(
    GM_ADDR bases, GM_ADDR montgomery_bases, uint64_t count)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    MsmPoints points;
    constexpr uint32_t tile=MsmPoints::tile_size;
    uint64_t offsets[tile];
    const uint64_t stride=uint64_t(AscendC::GetBlockNum())*tile;
    for (uint64_t first=uint64_t(AscendC::GetBlockIdx())*tile; first<count; first+=stride) {
        const uint32_t valid=min32(count-first,tile);
        for (uint32_t lane=0;lane<valid;++lane) offsets[lane]=(first+lane)*96;
        points.load_affine(0,bases,offsets,valid);
        points.store_affine_montgomery(0,montgomery_bases,offsets,valid);
    }
}

namespace {

// The point engine privately owns its TPipe, and a kernel may only own one live
// TPipe at a time, so dynamic counts are read through this scoped staging pipe
// and the engine is built only afterwards (AscendC resets the global pipe
// pointer on TPipe destruction, so the two lifetimes are sequential, never
// concurrent).
struct MsmProbeWords { uint64_t word[8]{}; };
class MsmProbe {
public:
    __aicore__ inline MsmProbe() { pipe_.InitBuffer(buffer_, 1, 64); }
    __aicore__ inline void load(GM_ADDR source, MsmProbeWords& out) {
        auto local = buffer_.AllocTensor<uint8_t>();
        AscendC::GlobalTensor<uint8_t> gm; gm.SetGlobalBuffer(source);
        AscendC::DataCopyPad(local, gm, AscendC::DataCopyExtParams{1, 64, 0, 0, 0},
                             AscendC::DataCopyPadExtParams<uint8_t>{false, 0, 0, 0});
        buffer_.EnQue(local); local = buffer_.DeQue<uint8_t>();
        const auto e = pipe_.FetchEventID(AscendC::HardEvent::MTE2_S);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(e);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(e);
        const auto words = local.ReinterpretCast<uint64_t>();
        for (uint32_t i = 0; i < 8; ++i) out.word[i] = words.GetValue(i);
        buffer_.FreeTensor(local);
    }
private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> buffer_;
};

} // namespace
// Task counts, the order offset and the record parity are device values; a block
// with no work returns before the point engine exists.
__global__ __aicore__ void hp_msm_partial_sums(
    GM_ADDR bases, GM_ADDR records_a, GM_ADDR records_b, GM_ADDR control,
    GM_ADDR tasks, GM_ADDR meta, GM_ADDR task_order, GM_ADDR partials)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    uint64_t task_count, order_offset;
    uint32_t parity;
    {
        MsmProbeWords header{}, routing{};
        { MsmProbe probe; probe.load(meta, header); probe.load(control, routing); }
        task_count = header.word[0];
        order_offset = header.word[7];
        parity = static_cast<uint32_t>(routing.word[0]);
    }
    if (!task_count) return;
    MsmPoints points;
    constexpr uint32_t tile=MsmPoints::tile_size;
    GM_ADDR records = parity ? records_b : records_a;
    GM_ADDR order = task_order + order_offset;
    uint64_t begin[tile], offsets[tile];
    uint32_t counts[tile], output_indices[tile];
    const uint64_t stride=uint64_t(AscendC::GetBlockNum())*tile;
    for (uint64_t t=uint64_t(AscendC::GetBlockIdx())*tile; t<task_count; t+=stride) {
        const uint32_t valid=min32(task_count-t,tile);
        const auto ordered=points.read_meta(order+t*4,valid*4).ReinterpretCast<uint32_t>();
        for (uint32_t lane=0;lane<valid;++lane) {
            output_indices[lane]=ordered.GetValue(lane);
            offsets[lane]=uint64_t(output_indices[lane])*64;
        }
        const auto input=points.read_meta_scattered(tasks,offsets,valid,64);
        const auto q=input.ReinterpretCast<uint64_t>();
        const auto w=input.ReinterpretCast<uint32_t>();
        uint32_t max_count=0;
        for (uint32_t lane=0;lane<valid;++lane) {
            begin[lane]=q.GetValue(lane*8);
            counts[lane]=w.GetValue(lane*16+2);
            if (counts[lane]>max_count) max_count=counts[lane];
        }
        // Materialized tasks are nonempty. Seed with the first point instead
        // of evaluating a full mixed addition against an identity accumulator.
        for (uint32_t i=0;i<max_count;++i) {
            for (uint32_t lane=0;lane<valid;++lane)
                offsets[lane]=i<counts[lane] ? (begin[lane]+i)*8 : MsmPoints::absent;
            // Scattered 8-byte records occupy separate 64-byte metadata slots.
            const auto records_meta=points.read_meta_scattered(records,offsets,valid,8);
            const auto record_words=records_meta.ReinterpretCast<uint32_t>();
            for (uint32_t lane=0;lane<valid;++lane)
                offsets[lane]=i<counts[lane]
                    ? uint64_t(record_words.GetValue(lane*16+1))*96 : MsmPoints::absent;
            points.load_affine_montgomery(i ? 3 : 0,bases,offsets,valid);
            if (i) points.add_assign_affine(0,3);
        }
        for (uint32_t lane=0;lane<valid;++lane)
            offsets[lane]=uint64_t(output_indices[lane])*192;
        points.store_points_montgomery(0,partials,offsets,valid);
    }
}

__global__ __aicore__ void hp_msm_partial_merge(
    GM_ADDR tasks, GM_ADDR children, GM_ADDR partials, GM_ADDR meta, uint32_t level)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    uint64_t task_count;
    {
        MsmProbeWords header{};
        { MsmProbe probe; probe.load(meta, header); }
        task_count = header.word[level];
    }
    if (!task_count) return;
    MsmPoints points;
    constexpr uint32_t tile=MsmPoints::tile_size;
    uint64_t begin[tile], offsets[tile];
    uint32_t counts[tile];
    const uint64_t stride=uint64_t(AscendC::GetBlockNum())*tile;
    for (uint64_t t=uint64_t(AscendC::GetBlockIdx())*tile; t<task_count; t+=stride) {
        const uint32_t valid=min32(task_count-t,tile);
        const auto input=points.read_meta(tasks+t*64,valid*64);
        const auto q=input.ReinterpretCast<uint64_t>();
        const auto w=input.ReinterpretCast<uint32_t>();
        uint32_t max_count=0;
        for (uint32_t lane=0;lane<valid;++lane) {
            begin[lane]=q.GetValue(lane*8);
            counts[lane]=w.GetValue(lane*16+2);
            if (counts[lane]>max_count) max_count=counts[lane];
        }
        for (uint32_t i=0;i<max_count;++i) {
            for (uint32_t lane=0;lane<valid;++lane)
                offsets[lane]=i<counts[lane] ? (begin[lane]+i)*192 : MsmPoints::absent;
            points.load_points_montgomery(i ? 3 : 0,children,offsets,valid);
            if (i) points.add_assign(0,3);
        }
        for (uint32_t lane=0;lane<valid;++lane) offsets[lane]=(t+lane)*192;
        points.store_points_montgomery(0,partials,offsets,valid);
    }
}

// Raw-copy packed Montgomery tuples; no field conversion or arithmetic. The
// final merge level and the level-0 task count come from ScheduleMeta.
__global__ __aicore__ void hp_msm_bucket_materialize(
    GM_ADDR meta, GM_ADDR partial_a, GM_ADDR partial_b, GM_ADDR task_prefix,
    GM_ADDR buckets, uint32_t bucket_count, uint64_t prefix_stride_bytes)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    // Raw-copy packed Montgomery tuples; no field conversion or arithmetic.
    Staging<544,12288> io;
    auto head = io.read(meta, 56);
    const uint64_t task_count = head.ReinterpretCast<uint64_t>().GetValue(0);
    const uint32_t merge_levels = head.ReinterpretCast<uint32_t>().GetValue(12);
    io.release(head);
    if (!task_count) return;
    GM_ADDR prefix = task_prefix + prefix_stride_bytes * uint64_t(merge_levels);
    GM_ADDR partials = merge_levels % 2 ? partial_b : partial_a;
    constexpr uint32_t tile=64;
    uint64_t offsets[tile];
    const uint64_t stride=uint64_t(AscendC::GetBlockNum())*tile;
    for (uint64_t b=uint64_t(AscendC::GetBlockIdx())*tile; b<bucket_count; b+=stride) {
        const uint32_t valid=min32(uint64_t(bucket_count)-b,tile);
        auto input=io.read(prefix+b*8,(valid+1)*8);
        const auto q=input.ReinterpretCast<uint64_t>();
        for (uint32_t lane=0;lane<valid;++lane) {
            const uint64_t begin=q.GetValue(lane), end=q.GetValue(lane+1);
            offsets[lane]=(b+lane && begin!=end) ? begin*192 : UINT64_MAX;
        }
        io.release(input);
        auto output=io.alloc_output();
        AscendC::Duplicate(output.ReinterpretCast<int32_t>(),int32_t(0),12288/4);
        io.sync<AscendC::HardEvent::V_S>();
        auto words=output.ReinterpretCast<uint32_t>();
        for (uint32_t lane=0;lane<valid;++lane)
            if (offsets[lane]==UINT64_MAX)
                for (uint32_t word=0;word<Bls12381FqParams::word_count;++word)
                    words.SetValue(lane*48+12+word,msm_montgomery_one_words[word]);
        io.sync<AscendC::HardEvent::S_MTE2>();
        for (uint32_t lane=0;lane<valid;++lane)
            if (offsets[lane]!=UINT64_MAX)
                io.copy_in(output[lane*192],partials+offsets[lane],192);
        io.sync<AscendC::HardEvent::MTE2_S>();
        io.write(output,buckets+b*192,valid*192);
    }
}

namespace hyperplonk::ascend910b3::detail {
void launch_msm_prepare_bases(aclrtStream stream,const G1Affine* bases,void* cache,
                              const MsmPlan& p) {
    if (!p.count) return;
    hp_msm_prepare_bases<<<p.platform.aiv_cores,nullptr,stream>>>(
        reinterpret_cast<uint8_t*>(const_cast<G1Affine*>(bases)),
        static_cast<uint8_t*>(cache),p.count);
}
void launch_msm_partial_sums(aclrtStream stream,const void* cache,void* workspace,
                             const MsmPlan& p) {
    if (!p.count) return;
    const uint64_t tiles=(p.partial_capacity[0]+msm_point_lanes-1)/msm_point_lanes;
    hp_msm_partial_sums<<<blocks(p,tiles),nullptr,stream>>>(
        static_cast<uint8_t*>(const_cast<void*>(cache)),
        region(workspace,p,MsmRegion::RecordsA),region(workspace,p,MsmRegion::RecordsB),
        region(workspace,p,MsmRegion::RadixControl),region(workspace,p,MsmRegion::Tasks),
        region(workspace,p,MsmRegion::ScheduleMeta),region(workspace,p,MsmRegion::TaskPrefix),
        region(workspace,p,MsmRegion::PartialA));
}
void launch_msm_partial_merge(aclrtStream stream,void* workspace,const MsmPlan& p,
                              uint32_t level) {
    if (!p.count || !level || level > p.merge_levels) return;
    const uint64_t capacity=p.partial_capacity[1];
    const uint64_t tiles=(capacity+msm_point_lanes-1)/msm_point_lanes;
    const auto source=level%2 ? MsmRegion::PartialA : MsmRegion::PartialB;
    const auto target=level%2 ? MsmRegion::PartialB : MsmRegion::PartialA;
    hp_msm_partial_merge<<<blocks(p,tiles),nullptr,stream>>>(
        region(workspace,p,MsmRegion::Tasks),region(workspace,p,source),
        region(workspace,p,target),region(workspace,p,MsmRegion::ScheduleMeta),level);
}
void launch_msm_bucket_materialize(aclrtStream stream,void* workspace,const MsmPlan& p) {
    if (!p.buckets) return;
    hp_msm_bucket_materialize<<<blocks(p,(uint64_t(p.buckets)+63)/64),nullptr,stream>>>(
        region(workspace,p,MsmRegion::ScheduleMeta),region(workspace,p,MsmRegion::PartialA),
        region(workspace,p,MsmRegion::PartialB),region(workspace,p,MsmRegion::TaskPrefix),
        region(workspace,p,MsmRegion::Buckets),p.buckets,p.host_prefix_offset);
}
} // namespace hyperplonk::ascend910b3::detail
