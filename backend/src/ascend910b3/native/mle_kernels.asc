// Resident MLE table kernels.
//
// One FieldVector<Fr> arena supplies every Montgomery/add/sub/inverse primitive;
// MleVectorEngine (a class friend of FieldVector) only adds GM tile staging and
// table layout, never a second field implementation. All tables are canonical
// Fr, low-bit-first (index bit i is variable i).
//
// Host launchers below are enqueue-only: the caller owns every device buffer and
// keeps it alive until the stream completes. No ACL call, allocation or copy to
// the host happens here.

#include "kernel_operator.h"
#include "field.h"
#include "field_vector.h"
#include "mle_kernels.h"

using namespace hyperplonk::ascend910b3;

namespace hyperplonk::ascend910b3 {

// Shared canonical-Fr tile engine for one AIV block: GM <-> UB staging, layout
// gather tables and field arithmetic on SoA digit tensors.
class MleVectorEngine {
public:
    using FV = FieldVector<Fr>;
    using I32 = AscendC::LocalTensor<int32_t>;
    using U32 = AscendC::LocalTensor<uint32_t>;
    using U8 = AscendC::LocalTensor<uint8_t>;

    static constexpr uint32_t lanes = FV::tile_size;
    static constexpr uint32_t digits = FieldVectorParams<Bls12381FrParams>::digit_count;
    static constexpr uint32_t words = Fr::word_count;
    static constexpr uint32_t element_bytes = sizeof(Fr);
    // A folded tile reads two adjacent lanes' fields at once.
    static constexpr uint32_t block_fields = 2 * lanes;
    static constexpr uint32_t raw_bytes = block_fields * element_bytes;
    static constexpr uint32_t soa_bytes = words * lanes * sizeof(int32_t);
    static constexpr uint32_t index_bytes = words * lanes * sizeof(uint32_t);
    static constexpr uint32_t table_count = 5;
    static constexpr uint32_t tables_bytes = table_count * index_bytes;
    static constexpr uint32_t field_bytes = digits * lanes * sizeof(int32_t);
    // Slots 0..8 hold data; slot 9 is the private Montgomery product scratch
    // used by mul(). No caller may use slot 9 as an operand.
    static constexpr uint32_t data_slots = 9;
    static constexpr uint32_t mul_slot = 9;
    static constexpr uint32_t small_bytes = lanes * sizeof(int32_t);
    static constexpr uint32_t small_slots = 3;
    static constexpr uint32_t tables_base = raw_bytes + soa_bytes;
    static constexpr uint32_t fields_base = tables_base + tables_bytes;
    static constexpr uint32_t smalls_base = fields_base + (data_slots + 1) * field_bytes;
    static constexpr uint32_t arena_bytes = smalls_base + small_slots * small_bytes;

    enum : uint32_t {
        kRaw = 0,
        kSoa = raw_bytes,
        kContiguous = 0,
        kEven = 1,
        kOdd = 2,
        kBroadcast = 3,
        kReverse = 4,
    };

    static_assert(lanes == 48 && digits == 22 && words == 8, "frozen Fr vector geometry");
    static_assert(raw_bytes == 3072 && soa_bytes == 1536 && index_bytes == 1536,
                  "frozen MLE staging geometry");
    static_assert(table_count == 5 && field_bytes == 4224 && small_bytes == 192,
                  "frozen MLE arena layout");
    static_assert(arena_bytes % 32 == 0, "MLE arena must be 32B aligned");
    // 88512B FieldVector arena + MLE staging + the 8192B SDK planning reserve.
    static_assert(FV::arena_bytes + arena_bytes + 8192u <= 196352u,
                  "MLE engine exceeds the UB budget");

    __aicore__ inline MleVectorEngine() {
        fv_.pipe_.InitBuffer(arena_, arena_bytes);
        memory_ = arena_.template Get<uint8_t>();
        build_gather_table(kContiguous, 1, 0);
        build_gather_table(kEven, 2, 0);
        build_gather_table(kOdd, 2, 1);
        build_gather_table(kBroadcast, 0, 0);
        build_reverse_table();
        fv_.load_r2();
    }

    // ---- layouts -----------------------------------------------------------
    __aicore__ inline U8 raw() { return memory_[kRaw]; }
    __aicore__ inline U32 raw_u32() { return memory_[kRaw].template ReinterpretCast<uint32_t>(); }
    __aicore__ inline U32 soa_u32() { return memory_[kSoa].template ReinterpretCast<uint32_t>(); }
    __aicore__ inline I32 soa_i32() { return memory_[kSoa].template ReinterpretCast<int32_t>(); }
    __aicore__ inline I32 field(uint32_t slot) {
        return memory_[fields_base + slot * field_bytes].template ReinterpretCast<int32_t>();
    }
    __aicore__ inline I32 small(uint32_t slot) {
        return memory_[smalls_base + slot * small_bytes].template ReinterpretCast<int32_t>();
    }
    __aicore__ inline U32 table(uint32_t id) {
        return memory_[tables_base + id * index_bytes].template ReinterpretCast<uint32_t>();
    }

    // ---- contiguous block partition ---------------------------------------
    __aicore__ inline void block_range(uint64_t total, uint64_t& first,
                                       uint64_t& last) {
        const uint64_t blocks = uint64_t(AscendC::GetBlockNum());
        const uint64_t per = (total + blocks - 1) / blocks;
        first = uint64_t(AscendC::GetBlockIdx()) * per;
        if (first > total) first = total;
        const uint64_t end = first + per;
        last = end < total ? end : total;
    }

    // Device address stored in a host-uploaded uint64 address table of `count`
    // entries. The table itself is layout metadata, never field data.
    __aicore__ inline GM_ADDR address_at(GM_ADDR addresses, uint32_t count,
                                         uint32_t index) {
        AscendC::GlobalTensor<uint64_t> global;
        global.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(addresses), count);
        return reinterpret_cast<GM_ADDR>(global.GetValue(index));
    }

    // ---- staging -----------------------------------------------------------
    __aicore__ inline void clear_raw() {
        auto words_view = raw().template ReinterpretCast<int32_t>();
        for (uint32_t offset = 0; offset < raw_bytes / 4; offset += 64)
            AscendC::Duplicate(words_view[offset], int32_t(0), int32_t(64));
        fv_.vector_barrier();
    }

    // Load elements (1..block_fields) canonical fields into the raw window.
    // pad_one writes the canonical one pattern into every remaining field so a
    // partial tail tile can never look like a zero denominator.
    __aicore__ inline void load_block(GM_ADDR src, uint32_t elements, bool pad_one) {
        clear_raw();
        if (pad_one && elements < block_fields) {
            fv_.sync<AscendC::HardEvent::V_S>();
            auto words_view = raw().template ReinterpretCast<int32_t>();
            for (uint32_t index = elements; index < block_fields; ++index)
                words_view.SetValue(int32_t(index * words), int32_t(1));
            fv_.sync<AscendC::HardEvent::S_V>();
        }
        fv_.sync<AscendC::HardEvent::V_MTE2>();
        fv_.copy_in(raw(), src, elements * element_bytes);
        fv_.sync<AscendC::HardEvent::MTE2_V>();
    }

    __aicore__ inline void gather_unpack(I32 dst, uint32_t table_id) {
        fv_.gather(soa_u32(), raw_u32(), table(table_id), words * lanes);
        fv_.unpack(dst, soa_u32());
    }

    __aicore__ inline void load_contiguous(I32 dst, GM_ADDR src, uint32_t elements,
                                          bool pad_one) {
        load_block(src, elements, pad_one);
        gather_unpack(dst, kContiguous);
    }

    __aicore__ inline void load_even(I32 dst) { gather_unpack(dst, kEven); }
    __aicore__ inline void load_odd(I32 dst) { gather_unpack(dst, kOdd); }

    // One canonical field broadcast to every lane.
    __aicore__ inline void load_scalar(I32 dst, GM_ADDR src) {
        load_block(src, 1, false);
        gather_unpack(dst, kBroadcast);
    }

    __aicore__ inline void store(GM_ADDR dst, I32 src, uint32_t valid) {
        fv_.pack_words(soa_i32(), src);
        fv_.gather(raw_u32(), soa_u32(), table(kReverse), words * lanes);
        fv_.sync<AscendC::HardEvent::V_MTE3>();
        fv_.copy_out(raw(), dst, valid * element_bytes);
        fv_.sync<AscendC::HardEvent::MTE3_V>();
    }

    __aicore__ inline void store_small(GM_ADDR dst, I32 src) {
        fv_.sync<AscendC::HardEvent::V_MTE3>();
        fv_.copy_out(src.template ReinterpretCast<uint8_t>(), dst, small_bytes);
        fv_.sync<AscendC::HardEvent::MTE3_V>();
    }

    // 32 zero bytes, used for the product-tree terminal entry.
    __aicore__ inline void store_zero_word(GM_ADDR dst) {
        clear_raw();
        fv_.sync<AscendC::HardEvent::V_MTE3>();
        fv_.copy_out(raw(), dst, element_bytes);
        fv_.sync<AscendC::HardEvent::MTE3_V>();
    }

    // ---- field values ------------------------------------------------------
    __aicore__ inline void zero(I32 dst) { fv_.fill_bank(dst, 0); }

    __aicore__ inline void set_one(I32 dst) {
        fv_.fill_bank(dst, 0);
        fv_.fill(fv_.digit(dst, 0), 1);
    }

    __aicore__ inline void add(I32 dst, I32 a, I32 b) { fv_.add_mod(dst, a, b); }
    __aicore__ inline void sub(I32 dst, I32 a, I32 b) { fv_.sub_mod(dst, a, b); }

    // Canonical product: a*R then REDC with b equals a*b.
    __aicore__ inline void mul(I32 dst, I32 a, I32 b) {
        auto scratch = field(mul_slot);
        fv_.montgomery(scratch, a, fv_.bank<3>());
        fv_.montgomery(dst, scratch, b);
    }

    __aicore__ inline void inverse(I32 dst, I32 src) { fv_.inverse(dst, src); }

    // Canonical field value of a public 64-bit integer (< 2^64 < p).
    __aicore__ inline void constant_u64(I32 dst, uint64_t value) {
        fv_.fill_bank(dst, 0);
        for (uint32_t index = 0; index < digits; ++index) {
            const int32_t part = int32_t(value & 0xfffu);
            if (part) fv_.fill(fv_.digit(dst, index), part);
            value >>= 12;
            if (!value) break;
        }
    }

    // Lane l holds the canonical field value l (public layout index only).
    __aicore__ inline void lane_indices(I32 dst) {
        fv_.fill_bank(dst, 0);
        fv_.sync<AscendC::HardEvent::V_S>();
        auto row = fv_.digit(dst, 0);
        for (uint32_t lane = 0; lane < lanes; ++lane) row.SetValue(lane, int32_t(lane));
        fv_.sync<AscendC::HardEvent::S_V>();
    }

    // Per-lane counter += 1 when that lane of `value` is zero. Used on the
    // accumulated denominator table only, never on field data sent to a host.
    __aicore__ inline void accumulate_zero(I32 counters, I32 sum, I32 temp, I32 value) {
        AscendC::Adds(sum, fv_.digit(value, 0), int32_t(0), int32_t(lanes));
        for (uint32_t index = 1; index < digits; ++index)
            AscendC::Add(sum, sum, fv_.digit(value, index), int32_t(lanes));
        AscendC::Mins(temp, sum, int32_t(1), int32_t(lanes));
        AscendC::Adds(temp, temp, int32_t(-1), int32_t(lanes));
        AscendC::Sub(counters, counters, temp, int32_t(lanes));
        fv_.vector_barrier();
    }

    __aicore__ inline void zero_small(I32 dst) {
        AscendC::Duplicate(dst, int32_t(0), int32_t(lanes));
        fv_.vector_barrier();
    }

private:
    // Byte offsets relative to the raw window: lane -> field, word -> 32-bit word.
    __aicore__ inline void build_gather_table(uint32_t id, uint32_t stride,
                                             uint32_t phase) {
        fv_.sync<AscendC::HardEvent::V_S>();
        auto index = table(id);
        for (uint32_t word = 0; word < words; ++word)
            for (uint32_t lane = 0; lane < lanes; ++lane)
                index.SetValue(word * lanes + lane,
                               uint32_t(4 * ((stride * lane + phase) * words + word)));
        fv_.sync<AscendC::HardEvent::S_V>();
    }

    __aicore__ inline void build_reverse_table() {
        fv_.sync<AscendC::HardEvent::V_S>();
        auto index = table(kReverse);
        for (uint32_t lane = 0; lane < lanes; ++lane)
            for (uint32_t word = 0; word < words; ++word)
                index.SetValue(lane * words + word, uint32_t(4 * (word * lanes + lane)));
        fv_.sync<AscendC::HardEvent::S_V>();
    }

    FV fv_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> arena_;
    U8 memory_;
};

} // namespace hyperplonk::ascend910b3

__global__ __aicore__ void hp_mle_fold_kernel(GM_ADDR input, GM_ADDR coordinate,
                                              GM_ADDR folded, GM_ADDR quotient,
                                              uint64_t out_count,
                                              uint32_t store_quotient) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    MleVectorEngine engine;
    auto even = engine.field(0);
    auto odd = engine.field(1);
    auto diff = engine.field(2);
    auto folded_value = engine.field(3);
    auto coordinate_value = engine.field(4);
    engine.load_scalar(coordinate_value, coordinate);
    uint64_t first = 0, last = 0;
    engine.block_range(out_count, first, last);
    for (uint64_t base = first; base < last; base += MleVectorEngine::lanes) {
        const uint64_t remaining = last - base;
        const uint32_t valid = uint32_t(remaining < MleVectorEngine::lanes
                                            ? remaining
                                            : MleVectorEngine::lanes);
        engine.load_block(input + (2 * base) * MleVectorEngine::element_bytes,
                          2 * valid, false);
        engine.load_even(even);
        engine.load_odd(odd);
        engine.sub(diff, odd, even);
        if (store_quotient)
            engine.store(quotient + base * MleVectorEngine::element_bytes, diff, valid);
        engine.mul(folded_value, coordinate_value, diff);
        engine.add(folded_value, even, folded_value);
        engine.store(folded + base * MleVectorEngine::element_bytes, folded_value, valid);
    }
}

__global__ __aicore__ void hp_mle_linear_combination_kernel(
    GM_ADDR out, GM_ADDR addresses, GM_ADDR coefficients, uint64_t total,
    uint32_t terms) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    MleVectorEngine engine;
    auto accumulator = engine.field(0);
    auto tile = engine.field(1);
    auto coefficient = engine.field(2);
    uint64_t first = 0, last = 0;
    engine.block_range(total, first, last);
    for (uint64_t base = first; base < last; base += MleVectorEngine::lanes) {
        const uint64_t remaining = last - base;
        const uint32_t valid = uint32_t(remaining < MleVectorEngine::lanes
                                            ? remaining
                                            : MleVectorEngine::lanes);
        engine.zero(accumulator);
        for (uint32_t term = 0; term < terms; ++term) {
            GM_ADDR polynomial = engine.address_at(addresses, terms, term);
            engine.load_contiguous(tile,
                                   polynomial + base * MleVectorEngine::element_bytes,
                                   valid, false);
            engine.load_scalar(coefficient,
                               coefficients + term * MleVectorEngine::element_bytes);
            engine.mul(tile, tile, coefficient);
            engine.add(accumulator, accumulator, tile);
        }
        engine.store(out + base * MleVectorEngine::element_bytes, accumulator, valid);
    }
}

// eq(x, r) first table entry pair: [1 - r0, r0].
__global__ __aicore__ void hp_mle_eq_first_kernel(GM_ADDR out, GM_ADDR coordinate) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    MleVectorEngine engine;
    auto coordinate_value = engine.field(0);
    auto complement = engine.field(1);
    auto one = engine.field(2);
    engine.load_scalar(coordinate_value, coordinate);
    engine.set_one(one);
    engine.sub(complement, one, coordinate_value);
    engine.store(out, complement, 1);
    engine.store(out + MleVectorEngine::element_bytes, coordinate_value, 1);
}

// Duplicate a table of `half` entries into [0, 2*half) weighted by 1-r and r.
__global__ __aicore__ void hp_mle_eq_level_kernel(GM_ADDR out, GM_ADDR coordinate,
                                                  uint64_t half) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    MleVectorEngine engine;
    auto value = engine.field(0);
    auto product = engine.field(1);
    auto coordinate_value = engine.field(2);
    auto complement = engine.field(3);
    auto one = engine.field(4);
    engine.load_scalar(coordinate_value, coordinate);
    engine.set_one(one);
    engine.sub(complement, one, coordinate_value);
    uint64_t first = 0, last = 0;
    engine.block_range(half, first, last);
    for (uint64_t base = first; base < last; base += MleVectorEngine::lanes) {
        const uint64_t remaining = last - base;
        const uint32_t valid = uint32_t(remaining < MleVectorEngine::lanes
                                            ? remaining
                                            : MleVectorEngine::lanes);
        engine.load_contiguous(value, out + base * MleVectorEngine::element_bytes,
                               valid, false);
        engine.mul(product, value, complement);
        engine.store(out + base * MleVectorEngine::element_bytes, product, valid);
        engine.mul(value, value, coordinate_value);
        engine.store(out + (half + base) * MleVectorEngine::element_bytes, value,
                     valid);
    }
}

__global__ __aicore__ void hp_mle_frac_kernel(GM_ADDR out,
                                              GM_ADDR numerator_addresses,
                                              GM_ADDR denominator_addresses,
                                              GM_ADDR flags, uint64_t total,
                                              uint32_t terms) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    MleVectorEngine engine;
    auto numerator = engine.field(0);
    auto denominator = engine.field(1);
    auto tile = engine.field(2);
    auto zero_counters = engine.small(0);
    auto digit_sum = engine.small(1);
    auto scratch = engine.small(2);
    engine.zero_small(zero_counters);
    uint64_t first = 0, last = 0;
    engine.block_range(total, first, last);
    for (uint64_t base = first; base < last; base += MleVectorEngine::lanes) {
        const uint64_t remaining = last - base;
        const uint32_t valid = uint32_t(remaining < MleVectorEngine::lanes
                                            ? remaining
                                            : MleVectorEngine::lanes);
        GM_ADDR table = engine.address_at(numerator_addresses, terms, 0);
        engine.load_contiguous(numerator,
                               table + base * MleVectorEngine::element_bytes, valid,
                               true);
        for (uint32_t term = 1; term < terms; ++term) {
            table = engine.address_at(numerator_addresses, terms, term);
            engine.load_contiguous(tile,
                                   table + base * MleVectorEngine::element_bytes,
                                   valid, true);
            engine.mul(numerator, numerator, tile);
        }
        table = engine.address_at(denominator_addresses, terms, 0);
        engine.load_contiguous(denominator,
                               table + base * MleVectorEngine::element_bytes, valid,
                               true);
        for (uint32_t term = 1; term < terms; ++term) {
            table = engine.address_at(denominator_addresses, terms, term);
            engine.load_contiguous(tile,
                                   table + base * MleVectorEngine::element_bytes,
                                   valid, true);
            engine.mul(denominator, denominator, tile);
        }
        // Every tile of this block contributes, so an early zero is never
        // hidden by a later nonzero tile.
        engine.accumulate_zero(zero_counters, digit_sum, scratch, denominator);
        engine.inverse(denominator, denominator);
        engine.mul(numerator, numerator, denominator);
        engine.store(out + base * MleVectorEngine::element_bytes, numerator, valid);
    }
    engine.store_small(flags + uint32_t(AscendC::GetBlockIdx()) *
                                   MleVectorEngine::small_bytes,
                       zero_counters);
}

__global__ __aicore__ void hp_mle_product_stage_kernel(GM_ADDR src, GM_ADDR dst,
                                                       uint64_t read_base,
                                                       uint64_t write_base,
                                                       uint64_t pairs) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    MleVectorEngine engine;
    auto even = engine.field(0);
    auto odd = engine.field(1);
    auto product = engine.field(2);
    uint64_t first = 0, last = 0;
    engine.block_range(pairs, first, last);
    for (uint64_t base = first; base < last; base += MleVectorEngine::lanes) {
        const uint64_t remaining = last - base;
        const uint32_t valid = uint32_t(remaining < MleVectorEngine::lanes
                                            ? remaining
                                            : MleVectorEngine::lanes);
        engine.load_block(src + (read_base + 2 * base) * MleVectorEngine::element_bytes,
                          2 * valid, false);
        engine.load_even(even);
        engine.load_odd(odd);
        engine.mul(product, even, odd);
        engine.store(dst + (write_base + base) * MleVectorEngine::element_bytes,
                     product, valid);
    }
}

__global__ __aicore__ void hp_mle_zero_word_kernel(GM_ADDR dst) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    MleVectorEngine engine;
    engine.store_zero_word(dst);
}

__global__ __aicore__ void hp_mle_nums_kernel(
    GM_ADDR fx, GM_ADDR gx, GM_ADDR perm, GM_ADDR beta, GM_ADDR gamma,
    GM_ADDR numerator_out, GM_ADDR denominator_out, uint64_t total,
    uint64_t columns) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    MleVectorEngine engine;
    auto f = engine.field(0);
    auto g = engine.field(1);
    auto work = engine.field(2);
    auto lane_term = engine.field(3);
    auto beta_value = engine.field(4);
    auto gamma_value = engine.field(5);
    auto lane_beta = engine.field(6);
    auto base_term = engine.field(8);
    engine.load_scalar(beta_value, beta);
    engine.load_scalar(gamma_value, gamma);
    engine.lane_indices(lane_term);
    engine.mul(lane_beta, beta_value, lane_term);
    uint64_t first = 0, last = 0;
    engine.block_range(total, first, last);
    for (uint64_t column = 0; column < columns; ++column) {
        GM_ADDR fx_table = engine.address_at(fx, uint32_t(columns), uint32_t(column));
        GM_ADDR gx_table = engine.address_at(gx, uint32_t(columns), uint32_t(column));
        GM_ADDR perm_table = engine.address_at(perm, uint32_t(columns), uint32_t(column));
        GM_ADDR numerator_table = engine.address_at(numerator_out, uint32_t(columns), uint32_t(column));
        GM_ADDR denominator_table =
            engine.address_at(denominator_out, uint32_t(columns), uint32_t(column));
        for (uint64_t base = first; base < last; base += MleVectorEngine::lanes) {
            const uint64_t remaining = last - base;
            const uint32_t valid = uint32_t(remaining < MleVectorEngine::lanes
                                                ? remaining
                                                : MleVectorEngine::lanes);
            // Exact CPU public index for this tile: beta*(column*total+base).
            // No carried base_term state is trusted across tiles.
            engine.constant_u64(lane_term, column * total + base);
            engine.mul(base_term, beta_value, lane_term);
            engine.load_contiguous(f, fx_table + base * MleVectorEngine::element_bytes,
                                   valid, false);
            engine.load_contiguous(g, gx_table + base * MleVectorEngine::element_bytes,
                                   valid, false);
            engine.load_contiguous(work,
                                   perm_table + base * MleVectorEngine::element_bytes,
                                   valid, false);
            engine.mul(work, work, beta_value);
            engine.add(g, g, gamma_value);
            engine.add(g, g, work);
            engine.store(denominator_table + base * MleVectorEngine::element_bytes, g,
                         valid);
            engine.add(lane_term, base_term, lane_beta);
            engine.add(f, f, gamma_value);
            engine.add(f, f, lane_term);
            engine.store(numerator_table + base * MleVectorEngine::element_bytes, f,
                         valid);
        }
    }
}

__global__ __aicore__ void hp_mle_product_factors_kernel(
    GM_ADDR frac, GM_ADDR product, GM_ADDR p1, GM_ADDR p2, uint64_t pairs) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    MleVectorEngine engine;
    auto even = engine.field(0);
    auto odd = engine.field(1);
    uint64_t first = 0, last = 0;
    engine.block_range(pairs, first, last);
    for (uint64_t base = first; base < last; base += MleVectorEngine::lanes) {
        const uint64_t remaining = last - base;
        const uint32_t valid = uint32_t(remaining < MleVectorEngine::lanes
                                            ? remaining
                                            : MleVectorEngine::lanes);
        engine.load_block(frac + (2 * base) * MleVectorEngine::element_bytes,
                          2 * valid, false);
        engine.load_even(even);
        engine.load_odd(odd);
        engine.store(p1 + base * MleVectorEngine::element_bytes, even, valid);
        engine.store(p2 + base * MleVectorEngine::element_bytes, odd, valid);
        engine.load_block(product + (2 * base) * MleVectorEngine::element_bytes,
                          2 * valid, false);
        engine.load_even(even);
        engine.load_odd(odd);
        engine.store(p1 + (pairs + base) * MleVectorEngine::element_bytes, even,
                     valid);
        engine.store(p2 + (pairs + base) * MleVectorEngine::element_bytes, odd,
                     valid);
    }
}

namespace {

// Host-side pointer casts for GM_ADDR kernel arguments.
inline uint8_t* mle_address(const Fr* pointer) {
    return reinterpret_cast<uint8_t*>(const_cast<Fr*>(pointer));
}
inline uint8_t* mle_address(Fr* pointer) { return reinterpret_cast<uint8_t*>(pointer); }
inline uint8_t* mle_address(const uint64_t* pointer) {
    return reinterpret_cast<uint8_t*>(const_cast<uint64_t*>(pointer));
}
inline uint8_t* mle_address(const uint8_t* pointer) {
    return const_cast<uint8_t*>(pointer);
}
inline uint8_t* mle_address(uint8_t* pointer) { return pointer; }

inline uint32_t mle_grid(uint64_t items, uint32_t cores) {
    if (!items) return 0;
    const uint64_t tiles = (items + MleVectorEngine::lanes - 1) / MleVectorEngine::lanes;
    return uint32_t(tiles < cores ? tiles : cores);
}

inline bool mle_valid_dimension(size_t num_vars) {
    return num_vars < 63;
}

} // namespace

namespace hyperplonk::ascend910b3::detail {

bool launch_mle_fold(aclrtStream stream, const Fr* input, size_t num_vars,
                     const Fr* coordinate, Fr* folded, Fr* quotient) {
    if (!stream || !input || !coordinate || !folded) return false;
    if (num_vars < 1 || !mle_valid_dimension(num_vars)) return false;
    const uint32_t cores = mle_aiv_cores();
    if (!cores) return false;
    const uint64_t out_count = (uint64_t(1) << num_vars) >> 1;
    const uint32_t blocks = mle_grid(out_count, cores);
    if (!blocks) return false;
    hp_mle_fold_kernel<<<blocks, nullptr, stream>>>(
        mle_address(input), mle_address(coordinate), mle_address(folded),
        quotient ? mle_address(quotient) : nullptr, out_count,
        quotient ? 1u : 0u);
    return true;
}

bool launch_mle_evaluate(aclrtStream stream, size_t num_vars,
                         const Fr* polynomial, const Fr* point_device,
                         Fr* result, Fr* scratch_a, Fr* scratch_b) {
    if (!stream || !polynomial || !point_device || !result) return false;
    if (num_vars < 1 || !mle_valid_dimension(num_vars)) return false;
    const Fr* source = polynomial;
    for (size_t level = 0; level < num_vars; ++level) {
        Fr* destination = nullptr;
        if (level + 1 == num_vars) {
            destination = result;
        } else if ((level & 1u) == 0) {
            if (!scratch_a) return false;
            destination = scratch_a;
        } else {
            if (!scratch_b) return false;
            destination = scratch_b;
        }
        if (!launch_mle_fold(stream, source, num_vars - level, point_device + level,
                             destination, nullptr))
            return false;
        source = destination;
    }
    return true;
}

bool launch_mle_linear_combination(aclrtStream stream, size_t num_vars,
                                   const uint64_t* addresses,
                                   const Fr* coefficients, size_t count,
                                   Fr* out) {
    if (!stream || !addresses || !coefficients || !out || !count) return false;
    if (!mle_valid_dimension(num_vars)) return false;
    if (count > 0xffffffffull) return false;
    const uint32_t cores = mle_aiv_cores();
    if (!cores) return false;
    const uint64_t total = uint64_t(1) << num_vars;
    const uint32_t blocks = mle_grid(total, cores);
    if (!blocks) return false;
    hp_mle_linear_combination_kernel<<<blocks, nullptr, stream>>>(
        mle_address(out), mle_address(addresses), mle_address(coefficients), total,
        uint32_t(count));
    return true;
}

bool launch_mle_build_eq_x_r(aclrtStream stream, const Fr* r_device,
                             size_t num_vars, Fr* out) {
    if (!stream || !r_device || !out) return false;
    if (num_vars < 1 || !mle_valid_dimension(num_vars)) return false;
    const uint32_t cores = mle_aiv_cores();
    if (!cores) return false;
    hp_mle_eq_first_kernel<<<1, nullptr, stream>>>(mle_address(out),
                                                   mle_address(r_device));
    for (size_t level = 1; level < num_vars; ++level) {
        const uint64_t half = uint64_t(1) << level;
        const uint32_t blocks = mle_grid(half, cores);
        if (!blocks) return false;
        hp_mle_eq_level_kernel<<<blocks, nullptr, stream>>>(
            mle_address(out), mle_address(r_device + level), half);
    }
    return true;
}

uint32_t mle_frac_flag_blocks(size_t num_vars) {
    if (!mle_valid_dimension(num_vars)) return 0;
    const uint32_t cores = mle_aiv_cores();
    if (!cores) return 0;
    return mle_grid(uint64_t(1) << num_vars, cores);
}

uint32_t launch_mle_frac(aclrtStream stream, size_t num_vars,
                         const uint64_t* numerator_addresses,
                         const uint64_t* denominator_addresses, size_t count,
                         Fr* out, uint8_t* flags) {
    if (!stream || !numerator_addresses || !denominator_addresses || !out ||
        !flags || !count)
        return 0;
    if (!mle_valid_dimension(num_vars) || count > 0xffffffffull) return 0;
    const uint32_t cores = mle_aiv_cores();
    if (!cores) return 0;
    const uint64_t total = uint64_t(1) << num_vars;
    const uint32_t blocks = mle_grid(total, cores);
    if (!blocks) return 0;
    hp_mle_frac_kernel<<<blocks, nullptr, stream>>>(
        mle_address(out), mle_address(numerator_addresses),
        mle_address(denominator_addresses), mle_address(flags), total,
        uint32_t(count));
    return blocks;
}

bool launch_mle_compute_product(aclrtStream stream, size_t num_vars,
                                const Fr* frac, Fr* out) {
    if (!stream || !frac || !out) return false;
    if (num_vars < 1 || !mle_valid_dimension(num_vars)) return false;
    const uint32_t cores = mle_aiv_cores();
    if (!cores) return false;
    const uint64_t total = uint64_t(1) << num_vars;
    uint64_t read_base = 0;
    uint64_t write_base = 0;
    uint64_t pairs = total / 2;
    bool first_stage = true;
    while (pairs) {
        const uint32_t blocks = mle_grid(pairs, cores);
        if (!blocks) return false;
        hp_mle_product_stage_kernel<<<blocks, nullptr, stream>>>(
            first_stage ? mle_address(frac) : mle_address(out), mle_address(out),
            read_base, write_base, pairs);
        read_base = write_base;
        write_base += pairs;
        pairs /= 2;
        first_stage = false;
    }
    hp_mle_zero_word_kernel<<<1, nullptr, stream>>>(
        mle_address(out + (total - 1)));
    return true;
}

bool launch_mle_nums_and_denoms(aclrtStream stream, size_t num_vars,
                                const Fr* beta, const Fr* gamma,
                                const uint64_t* fx_addresses,
                                const uint64_t* gx_addresses,
                                const uint64_t* perm_addresses, size_t count,
                                const uint64_t* numerator_out,
                                const uint64_t* denominator_out) {
    if (!stream || !beta || !gamma || !fx_addresses || !gx_addresses ||
        !perm_addresses || !numerator_out || !denominator_out || !count)
        return false;
    if (!mle_valid_dimension(num_vars) || count > 0xffffffffull) return false;
    const uint32_t cores = mle_aiv_cores();
    if (!cores) return false;
    const uint64_t total = uint64_t(1) << num_vars;
    const uint32_t blocks = mle_grid(total, cores);
    if (!blocks) return false;
    hp_mle_nums_kernel<<<blocks, nullptr, stream>>>(
        mle_address(fx_addresses), mle_address(gx_addresses),
        mle_address(perm_addresses), mle_address(beta), mle_address(gamma),
        mle_address(numerator_out), mle_address(denominator_out), total,
        uint64_t(count));
    return true;
}

bool launch_mle_product_factors(aclrtStream stream, size_t num_vars,
                                const Fr* frac, const Fr* product, Fr* p1,
                                Fr* p2) {
    if (!stream || !frac || !product || !p1 || !p2) return false;
    if (num_vars < 1 || !mle_valid_dimension(num_vars)) return false;
    const uint32_t cores = mle_aiv_cores();
    if (!cores) return false;
    const uint64_t pairs = uint64_t(1) << (num_vars - 1);
    const uint32_t blocks = mle_grid(pairs, cores);
    if (!blocks) return false;
    hp_mle_product_factors_kernel<<<blocks, nullptr, stream>>>(
        mle_address(frac), mle_address(product), mle_address(p1), mle_address(p2),
        pairs);
    return true;
}

} // namespace hyperplonk::ascend910b3::detail
