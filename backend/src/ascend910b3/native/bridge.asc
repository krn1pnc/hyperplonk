// Host-linkable bridge entry points for the shared native runtime.
//
// Only the runtime-owned symbols live here: context create/destroy, deferred
// buffer retirement and canonical MLE upload. All MLE operation, KZG and
// SumCheck symbols are defined exactly once in bridge_mle.cpp, bridge_kzg.cpp
// and bridge_sumcheck.cpp against the same bridge_runtime.h. No stub returns
// NOT_IMPLEMENTED from this file.
#include "bridge_runtime.h"

namespace rt = hyperplonk::ascend910b3::native;

static_assert(sizeof(Ascend910B3Status) == 8);
static_assert(alignof(Ascend910B3Status) == 4);
static_assert(offsetof(Ascend910B3Status, kind) == 0);
static_assert(offsetof(Ascend910B3Status, native_code) == 4);
static_assert(sizeof(void*) == 8);
static_assert(sizeof(size_t) == 8);

// Resource slots are cleared on failure; numerical output bytes remain unwritten.
extern "C" Ascend910B3Status hp_ascend910b3_v1_context_create(int32_t device_id, Ascend910B3NativeContext** out) {
    return rt::create_context(device_id, out);
}

extern "C" Ascend910B3Status hp_ascend910b3_v1_context_destroy(Ascend910B3NativeContext* ctx) {
    return rt::destroy_context(ctx);
}

extern "C" Ascend910B3Status hp_ascend910b3_v1_buffer_retire(Ascend910B3NativeContext* ctx, Ascend910B3DeviceAddress address) {
    return rt::retire_buffer(ctx, address);
}

extern "C" Ascend910B3Status hp_ascend910b3_v1_mle_upload(Ascend910B3NativeContext* ctx, size_t num_vars, const uint8_t* evaluations, size_t evaluation_count, Ascend910B3DeviceAddress* out) {
    return rt::upload_mle(ctx, num_vars, evaluations, evaluation_count, out);
}
